@model BBMS.Models.RecordDonation

@{
    ViewData["Title"] = "Record Donation";
}

<style>
    body {
        font-family: 'Segoe UI', Tahoma, sans-serif;
        background: #f4f6f9;
    }

    .form-container {
        width: 650px;
        margin: 50px auto;
        background: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }

    .form-header {
        background: linear-gradient(135deg, #b30000, #ff4d4d);
        color: white;
        padding: 20px;
        border-radius: 10px;
        margin-bottom: 24px;
        text-align: center;
    }

        .form-header h2 {
            margin: 0 0 5px 0;
            font-size: 22px;
        }

        .form-header p {
            margin: 0;
            font-size: 14px;
            opacity: 0.9;
        }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

    label {
        font-weight: 600;
        font-size: 13px;
        color: #444;
        margin-bottom: 5px;
    }

    input, select, textarea {
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 14px;
        font-family: inherit;
    }

        input:focus, select:focus, textarea:focus {
            border-color: #b30000;
            outline: none;
            box-shadow: 0 0 0 3px rgba(179,0,0,0.1);
        }

        input[readonly] {
            background: #f9f9f9;
            color: #666;
        }

    textarea {
        resize: vertical;
        min-height: 80px;
    }

    .section-title {
        grid-column: 1 / -1;
        font-size: 13px;
        font-weight: 700;
        color: #b30000;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid #f0d0d0;
        padding-bottom: 6px;
        margin-top: 8px;
    }

    .text-danger {
        color: red;
        font-size: 12px;
    }

    .btn-submit {
        background: #b30000;
        color: white;
        padding: 10px 22px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 15px;
        font-family: inherit;
    }

        .btn-submit:hover {
            background: #ff3333;
        }

    .btn-back {
        background: #ccc;
        color: #333;
        padding: 10px 22px;
        border-radius: 6px;
        text-decoration: none;
        display: inline-block;
        margin-left: 10px;
        font-size: 15px;
    }

        .btn-back:hover {
            background: #bbb;
        }

    .btn-group {
        margin-top: 24px;
        text-align: center;
    }
</style>

<div class="form-container">
    <div class="form-header">
        <h2>Record Donation</h2>
        <p>Log blood donation for donor @Model.DonorId</p>
    </div>

    <form asp-controller="Donation" asp-action="CreateRecord" method="post">
        @Html.AntiForgeryToken()

        <div class="form-grid">

            <!-- DONOR INFORMATION -->
            <div class="section-title">Donor Information (Pre-filled)</div>

            <div class="form-group">
                <label>Donor ID</label>
                <input asp-for="DonorId" readonly />
            </div>

            <div class="form-group">
                <label>Donor Name</label>
                <input asp-for="DonorName" readonly />
            </div>

            <div class="form-group">
                <label>Gender</label>
                <input asp-for="Gender" readonly />
            </div>

            <div class="form-group">
                <label>Contact Number</label>
                <input asp-for="ContactNumber" readonly />
            </div>

            <div class="form-group">
                <label>Email</label>
                <input asp-for="Email" readonly />
            </div>

            <div class="form-group">
                <label>Blood Group</label>
                <input asp-for="BloodGroup" readonly />
            </div>

            <!-- DONATION DETAILS -->
            <div class="section-title">Donation Details</div>

            <div class="form-group">
                <label>Donation Type *</label>
                <select asp-for="DonationType">
                    <option value="">-- Select Type --</option>
                    <option>Whole Blood</option>
                    <option>Platelets</option>
                    <option>Fresh Frozen Plasma</option>
                    <option>Red Blood Cells</option>
                    <option>Granulocytes</option>
                </select>
                <span asp-validation-for="DonationType" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Quantity (ml) *</label>
                <input asp-for="Quantity" type="number" placeholder="e.g. 450" min="100" max="600" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Donation Date *</label>
                <input asp-for="DonationDate" type="date" />
                <span asp-validation-for="DonationDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Location *</label>
                <input asp-for="Location" placeholder="Hospital / Camp" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Donation Number (This Visit)</label>
                <input asp-for="DonationNumber" type="number" placeholder="e.g. 3" min="1" />
            </div>

            <!-- HEALTH SCREENING -->
            <div class="section-title">Health Screening</div>

            <div class="form-group">
                <label>Hemoglobin Level (g/dL)</label>
                <input asp-for="HemoglobinLevel" type="number" placeholder="e.g. 13.5" step="0.1" />
            </div>

            <div class="form-group">
                <label>Blood Pressure</label>
                <input asp-for="BloodPressure" placeholder="e.g. 120/80" />
            </div>

            <div class="form-group">
                <label>Weight (kg)</label>
                <input asp-for="Weight" type="number" placeholder="e.g. 65" min="45" />
            </div>

            <div class="form-group">
                <label>Screening Result</label>
                <select asp-for="ScreeningResult">
                    <option value="">-- Select --</option>
                    <option>Passed</option>
                    <option>Deferred - Temporary</option>
                    <option>Deferred - Permanent</option>
                </select>
            </div>

            <!-- PROCESSING -->
            <div class="section-title">Processing</div>

            <div class="form-group">
                <label>Staff / Phlebotomist ID</label>
                <input asp-for="StaffId" placeholder="e.g. ST-045" />
            </div>

            <div class="form-group">
                <label>Status</label>
                <select asp-for="Status">
                    <option>Collected</option>
                    <option>Processing</option>
                    <option>Tested</option>
                    <option>Available</option>
                    <option>Discarded</option>
                </select>
            </div>

            <div class="form-group full-width">
                <label>Remarks / Notes</label>
                <textarea asp-for="Remarks" placeholder="Any observations..."></textarea>
            </div>

        </div>

        <div class="btn-group">
            <button type="submit" class="btn-submit">Save Donation Record</button>
            <a asp-controller="Donation" asp-action="RecordDonation" class="btn-back">Back</a>
        </div>
    </form>
</div>