@model IEnumerable<BBMS.Models.RecordDonation>

@{
    ViewData["Title"] = "Donation History";
}



<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f4f6f9;
    }

    .dashboard {
        width: 92%;
        margin: 32px auto 50px;
    }

    /* ── HEADER ── */
    .header {
        background: #7a0000;
        color: white;
        padding: 28px 32px;
        border-radius: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        overflow: hidden;
        margin-bottom: 26px;
    }

    .header-blob1 {
        position: absolute;
        right: -40px;
        top: -50px;
        width: 200px;
        height: 200px;
        border-radius: 50%;
        background: rgba(255,255,255,0.05);
        pointer-events: none;
    }

    .header-blob2 {
        position: absolute;
        right: 120px;
        bottom: -60px;
        width: 140px;
        height: 140px;
        border-radius: 50%;
        background: rgba(255,255,255,0.05);
        pointer-events: none;
    }

    .header-left h2 {
        font-size: 20px;
        font-weight: 600;
        color: #fff;
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 10px;
        position: relative;
        z-index: 1;
    }

    .header-left p {
        font-size: 13px;
        color: rgba(255,255,255,0.6);
        position: relative;
        z-index: 1;
        padding-left: 30px;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 16px;
        z-index: 1;
    }

    .header-stat {
        text-align: center;
    }

        .header-stat .val {
            font-size: 20px;
            font-weight: 700;
            color: #fff;
            line-height: 1;
        }

        .header-stat .lbl {
            font-size: 11px;
            color: rgba(255,255,255,0.5);
            margin-top: 3px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .h-divider {
        width: 0.5px;
        height: 40px;
        background: rgba(255,255,255,0.2);
        flex-shrink: 0;
    }

    .btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,0.08);
        border: 0.5px solid rgba(255,255,255,0.2);
        color: rgba(255,255,255,0.8);
        padding: 9px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.15s;
    }

        .btn-ghost:hover {
            background: rgba(255,255,255,0.16);
            color: #fff;
        }

    /* ── SECTION LABEL ── */
    .section-label {
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #8b0000;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .section-label::before {
            content: '';
            display: block;
            width: 4px;
            height: 14px;
            background: #8b0000;
            border-radius: 2px;
        }

    /* ── STAT CARDS ── */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: white;
        border: 0.5px solid #e8d8d8;
        border-top: 4px solid #8b0000;
        border-radius: 12px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        transition: border-color 0.15s;
    }

        .stat-card:hover {
            border-color: #8b0000;
        }

        .stat-card.green {
            border-top-color: #1a6638;
        }

        .stat-card.orange {
            border-top-color: #92600a;
        }

        .stat-card.blue {
            border-top-color: #1565c0;
        }

    .sc-icon {
        width: 42px;
        height: 42px;
        background: #fff0f0;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .sc-icon i {
            color: #8b0000;
            font-size: 18px;
        }

    .stat-card.green .sc-icon {
        background: #e8f7ee;
    }

        .stat-card.green .sc-icon i {
            color: #1a6638;
        }

    .stat-card.orange .sc-icon {
        background: #fef7e0;
    }

        .stat-card.orange .sc-icon i {
            color: #92600a;
        }

    .stat-card.blue .sc-icon {
        background: #e8f0fe;
    }

        .stat-card.blue .sc-icon i {
            color: #1565c0;
        }

    .sc-val {
        font-size: 24px;
        font-weight: 700;
        color: #8b0000;
        line-height: 1;
    }

    .stat-card.green .sc-val {
        color: #1a6638;
    }

    .stat-card.orange .sc-val {
        color: #92600a;
    }

    .stat-card.blue .sc-val {
        color: #1565c0;
    }

    .sc-lbl {
        font-size: 12px;
        color: #888;
        margin-top: 3px;
    }

    /* ── FILTER BAR ── */
    .filter-bar {
        background: white;
        border: 0.5px solid #e8d8d8;
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .search-wrap {
        flex: 1;
        min-width: 200px;
        position: relative;
    }

        .search-wrap i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #aaa;
            font-size: 14px;
        }

        .search-wrap input {
            width: 100%;
            padding: 9px 12px 9px 34px;
            border: 0.5px solid #ddd;
            border-radius: 8px;
            font-size: 13px;
            color: #333;
            background: #fafafa;
            outline: none;
            font-family: inherit;
            transition: border-color 0.15s;
        }

            .search-wrap input:focus {
                border-color: #8b0000;
            }

    .filter-bar select {
        padding: 9px 12px;
        border: 0.5px solid #ddd;
        border-radius: 8px;
        font-size: 13px;
        color: #333;
        background: #fafafa;
        outline: none;
        font-family: inherit;
        transition: border-color 0.15s;
    }

        .filter-bar select:focus {
            border-color: #8b0000;
        }

    .btn-search {
        background: #8b0000;
        color: white;
        border: none;
        padding: 9px 20px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        font-family: inherit;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        transition: background 0.15s;
    }

        .btn-search:hover {
            background: #6e0000;
        }

    /* ── TABLE ── */
    .table-section {
        background: white;
        border: 0.5px solid #e8d8d8;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 40px;
    }

    .table-section-header {
        padding: 16px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 0.5px solid #f5eded;
    }

        .table-section-header span {
            font-size: 14px;
            font-weight: 600;
            color: #1a1a1a;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .record-count {
        font-size: 12px;
        background: #fff0f0;
        color: #8b0000;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 20px;
    }

    .table-wrap {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead th {
        background: #8b0000;
        color: white;
        padding: 12px 16px;
        font-size: 12px;
        font-weight: 600;
        text-align: left;
        white-space: nowrap;
        letter-spacing: 0.3px;
    }

    tbody td {
        padding: 12px 16px;
        border-bottom: 0.5px solid #f5eded;
        font-size: 13px;
        color: #333;
        vertical-align: middle;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    tbody tr:hover td {
        background: #fff8f8;
    }

    .donor-name {
        font-weight: 600;
        color: #1a1a1a;
        font-size: 13px;
    }

    .donor-id {
        font-size: 11px;
        color: #8b0000;
        font-weight: 600;
        margin-top: 2px;
        font-family: monospace;
    }

    .blood-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #8b0000;
        color: white;
        font-size: 11px;
        font-weight: 700;
    }

    .pill {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

    .p-collected {
        background: #e8f0fe;
        color: #1565c0;
    }

    .p-available {
        background: #e8f7ee;
        color: #1a6638;
    }

    .p-processing {
        background: #fef7e0;
        color: #92600a;
    }

    .p-tested {
        background: #f3e5f5;
        color: #6a1b9a;
    }

    .p-discarded {
        background: #f5f5f5;
        color: #616161;
    }

    /* ── EMPTY STATE ── */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
    }

        .empty-state i {
            font-size: 44px;
            color: #f0c0c0;
            margin-bottom: 12px;
            display: block;
        }

        .empty-state p {
            font-size: 14px;
            color: #aaa;
        }

    /* ── PAGINATION ── */
    .pagination-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 22px;
        border-top: 0.5px solid #f5eded;
        font-size: 13px;
        color: #888;
        flex-wrap: wrap;
        gap: 10px;
    }

    .pagination-btns {
        display: flex;
        gap: 6px;
    }

    .pg-btn {
        padding: 5px 11px;
        border: 0.5px solid #e0d0d0;
        border-radius: 6px;
        font-size: 12px;
        background: white;
        color: #555;
        text-decoration: none;
        transition: border-color 0.15s, color 0.15s;
    }

        .pg-btn:hover {
            border-color: #8b0000;
            color: #8b0000;
        }

        .pg-btn.active {
            background: #8b0000;
            color: white;
            border-color: #8b0000;
        }

    @@media (max-width: 768px) {
        .stats-row {
            grid-template-columns: repeat(2, 1fr);
        }

        .header-right {
            display: none;
        }
    }
</style>

<div class="dashboard">

    @* ── HEADER ── *@
    <div class="header">
        <div class="header-blob1"></div>
        <div class="header-blob2"></div>
        <div class="header-left">
            <h2><i class="fa-solid fa-droplet"></i> Donation History</h2>
            <p>Complete record of all blood donations in the system</p>
        </div>
        <div class="header-right">
            <div class="header-stat">
                <div class="val">@ViewBag.TotalRecords</div>
                <div class="lbl">Total</div>
            </div>
            <div class="h-divider"></div>
            <div class="header-stat">
                <div class="val">@ViewBag.Available</div>
                <div class="lbl">Available</div>
            </div>
            <div class="h-divider"></div>
            <div class="header-stat">
                <div class="val">@ViewBag.TotalML ml</div>
                <div class="lbl">Collected</div>
            </div>
            <div class="h-divider"></div>
            <a asp-controller="Donation" asp-action="RecordDonation" class="btn-ghost">
                <i class="fa-solid fa-arrow-left"></i> Back
            </a>
        </div>
    </div>

    @* ── STAT CARDS ── *@
    <div class="section-label">Overview</div>
    <div class="stats-row">
        <div class="stat-card">
            <div class="sc-icon"><i class="fa-solid fa-database"></i></div>
            <div>
                <div class="sc-val">@ViewBag.TotalRecords</div>
                <div class="sc-lbl">Total Records</div>
            </div>
        </div>
        <div class="stat-card green">
            <div class="sc-icon"><i class="fa-solid fa-circle-check"></i></div>
            <div>
                <div class="sc-val">@ViewBag.Available</div>
                <div class="sc-lbl">Available</div>
            </div>
        </div>
        <div class="stat-card orange">
            <div class="sc-icon"><i class="fa-solid fa-spinner"></i></div>
            <div>
                <div class="sc-val">@ViewBag.Processing</div>
                <div class="sc-lbl">Processing</div>
            </div>
        </div>
        <div class="stat-card blue">
            <div class="sc-icon"><i class="fa-solid fa-flask"></i></div>
            <div>
                <div class="sc-val">@ViewBag.TotalML</div>
                <div class="sc-lbl">Total ML Collected</div>
            </div>
        </div>
    </div>

    @* ── FILTER BAR ── *@
    <div class="filter-bar">
        <form method="get" asp-controller="Donation"
              asp-action="DonationHistory" style="display:contents;">

            <div class="search-wrap">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" name="search"
                       value="@ViewBag.Search"
                       placeholder="Search by donor name or ID…" />
            </div>

            <select name="bloodGroup">
                <option value="">All Blood Groups</option>
                @foreach (var bg in new[] { "A+", "A-", "B+", "B-", "O+", "O-", "AB+", "AB-" })
                {
                    if (ViewBag.BloodGroup == bg)
                    {
                        <option value="@bg" selected>@bg</option>
                    }
                    else
                    {
                        <option value="@bg">@bg</option>
                    }
                }
            </select>

            <select name="status">
                <option value="">All Status</option>
                @foreach (var s in new[] { "Collected", "Processing", "Tested", "Available", "Discarded" })
                {
                    if (ViewBag.Status == s)
                    {
                        <option value="@s" selected>@s</option>
                    }
                    else
                    {
                        <option value="@s">@s</option>
                    }
                }
            </select>

            <button type="submit" class="btn-search">
                <i class="fa-solid fa-magnifying-glass"></i> Search
            </button>

        </form>
    </div>

    @* ── TABLE ── *@
    <div class="table-section">
        <div class="table-section-header">
            <span>
                <i class="fa-solid fa-list" style="color:#8b0000;"></i>
                Donation Records
            </span>
            <span class="record-count">@ViewBag.TotalRecords records</span>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Donor</th>
                        <th>Blood Group</th>
                        <th>Donation Type</th>
                        <th>Quantity (ml)</th>
                        <th>Donation Date</th>
                        <th>Location</th>
                        <th>Screening</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int serial = 1;
                        foreach (var record in Model)
                        {
                            var pillClass = record.Status switch
                            {
                                "Available" => "p-available",
                                "Processing" => "p-processing",
                                "Tested" => "p-tested",
                                "Discarded" => "p-discarded",
                                _ => "p-collected"
                            };

                            <tr>
                                <td style="color:#aaa;font-size:12px;">@serial</td>
                                <td>
                                    <div class="donor-name">@record.DonorName</div>
                                    <div class="donor-id">@record.DonorId</div>
                                </td>
                                <td><div class="blood-badge">@record.BloodGroup</div></td>
                                <td>@record.DonationType</td>
                                <td style="font-weight:600;">@record.Quantity ml</td>
                                <td style="font-size:12px;">@record.DonationDate.ToString("dd MMM yyyy")</td>
                                <td style="font-size:12px;color:#555;">@record.Location</td>
                                <td style="font-size:12px;">
                                    @(string.IsNullOrEmpty(record.ScreeningResult) ? "—" : record.ScreeningResult)
                                </td>
                                <td><span class="pill @pillClass">@record.Status</span></td>
                            </tr>

                            serial++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9">
                                <div class="empty-state">
                                    <i class="fa-solid fa-ban"></i>
                                    <p>No donation records found.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* ── PAGINATION ── *@
        <div class="pagination-bar">
            <span>Showing @ViewBag.From – @ViewBag.To of @ViewBag.TotalRecords records</span>
            <div class="pagination-btns">

                @if (ViewBag.CurrentPage > 1)
                {
                    <a asp-controller="Donation" asp-action="DonationHistory"
                       asp-route-page="@(ViewBag.CurrentPage - 1)"
                       asp-route-search="@ViewBag.Search"
                       asp-route-bloodGroup="@ViewBag.BloodGroup"
                       asp-route-status="@ViewBag.Status"
                       class="pg-btn">&#8249; Prev</a>
                }

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <a asp-controller="Donation" asp-action="DonationHistory"
                       asp-route-page="@i"
                       asp-route-search="@ViewBag.Search"
                       asp-route-bloodGroup="@ViewBag.BloodGroup"
                       asp-route-status="@ViewBag.Status"
                       class="pg-btn @(ViewBag.CurrentPage == i ? "active" : "")">@i</a>
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a asp-controller="Donation" asp-action="DonationHistory"
                       asp-route-page="@(ViewBag.CurrentPage + 1)"
                       asp-route-search="@ViewBag.Search"
                       asp-route-bloodGroup="@ViewBag.BloodGroup"
                       asp-route-status="@ViewBag.Status"
                       class="pg-btn">Next &#8250;</a>
                }

            </div>
        </div>
    </div>

</div>
