@model List<BBMS.Models.BloodStock>
@{
    ViewData["Title"] = "Admin Dashboard";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
    * {
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f4f6f9;
    }

    .dashboard {
        width: 92%;
        margin: 32px auto;
    }

    .header {
        background: #8b0000;
        color: white;
        padding: 28px 32px;
        border-radius: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

        .header::before {
            content: '';
            position: absolute;
            right: -40px;
            top: -50px;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }

        .header::after {
            content: '';
            position: absolute;
            right: 120px;
            bottom: -60px;
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }

    .header-left h2 {
        font-size: 22px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 4px;
    }

    .header-left p {
        font-size: 13px;
        color: #ffb3b3;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 20px;
        z-index: 1;
    }

    .header-stat {
        text-align: center;
    }

        .header-stat .val {
            font-size: 20px;
            font-weight: 700;
            color: #fff;
        }

        .header-stat .lbl {
            font-size: 11px;
            color: #ffb3b3;
            margin-top: 2px;
        }

    .h-divider {
        width: 1px;
        height: 40px;
        background: rgba(255,255,255,0.2);
    }

    .admin-badge {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: rgba(255,255,255,0.15);
        border: 2px solid rgba(255,255,255,0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        color: #fff;
    }

    .section-title {
        margin-top: 28px;
        margin-bottom: 14px;
        font-size: 15px;
        font-weight: 700;
        color: #1a1a1a;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .section-title::before {
            content: '';
            display: block;
            width: 4px;
            height: 16px;
            background: #8b0000;
            border-radius: 2px;
        }

    .card-container {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }

    .card {
        flex: 1;
        min-width: 160px;
        background: white;
        padding: 24px 20px;
        border-radius: 10px;
        text-align: center;
        border: 1px solid #f0e0e0;
        border-top: 4px solid #8b0000;
        transition: transform 0.2s, box-shadow 0.2s;
        cursor: pointer;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 24px rgba(139,0,0,0.1);
        }

    .card-icon {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: #fff0f0;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 12px;
    }

        .card-icon i {
            color: #8b0000;
            font-size: 18px;
        }

    .card a {
        text-decoration: none;
        color: #8b0000;
        font-weight: 700;
        font-size: 15px;
        display: block;
    }

    .card p {
        font-size: 12px;
        color: #999;
        margin-top: 5px;
    }

    .table-section {
        margin-top: 24px;
        background: white;
        padding: 24px;
        border-radius: 10px;
        border: 1px solid #f0e0e0;
        margin-bottom: 40px;
    }

        .table-section h3 {
            font-size: 15px;
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .table-section h3::before {
                content: '';
                display: block;
                width: 4px;
                height: 16px;
                background: #8b0000;
                border-radius: 2px;
            }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        background: #8b0000;
        color: white;
        padding: 12px 16px;
        font-size: 13px;
        font-weight: 600;
        text-align: left;
    }

    td {
        padding: 12px 16px;
        border-bottom: 1px solid #f5eded;
        font-size: 13px;
        color: #333;
    }

    tr:last-child td {
        border-bottom: none;
    }

    tr:hover td {
        background: #fff8f8;
    }

    .unit-badge {
        display: inline-block;
        background: #fff0f0;
        color: #8b0000;
        font-weight: 600;
        font-size: 12px;
        padding: 3px 10px;
        border-radius: 20px;
    }
</style>

<div class="dashboard">

    <!-- HEADER -->
    <div class="header">
        <div class="header-left">
            <h2>Admin Dashboard</h2>
            <p>Manage System, Blood Stock &amp; Requests</p>
        </div>
        <div class="header-right">
            <div class="header-stat"><div class="val">52</div><div class="lbl">Donors</div></div>
            <div class="h-divider"></div>
            <div class="header-stat"><div class="val">8</div><div class="lbl">Staff</div></div>
            <div class="h-divider"></div>
            <div class="header-stat"><div class="val">12</div><div class="lbl">Requests</div></div>
            <div class="h-divider"></div>
            <div class="admin-badge"><i class="fa-solid fa-shield-halved"></i></div>
        </div>
    </div>
    <!-- EXPIRY WARNING BANNERS -->
    @if (ViewBag.CriticalBags > 0)
    {
        <div style="background:#fff0f0;border:1px solid #f0c0c0;
                    border-left:5px solid #8b0000;border-radius:10px;
                    padding:14px 20px;margin-top:20px;
                    display:flex;align-items:center;justify-content:space-between;
                    flex-wrap:wrap;gap:10px;">
            <div style="display:flex;align-items:center;gap:12px;">
                <div style="width:40px;height:40px;border-radius:50%;
                            background:#8b0000;display:flex;align-items:center;
                            justify-content:center;flex-shrink:0;">
                    <i class="fa-solid fa-triangle-exclamation"
                       style="color:white;font-size:16px;"></i>
                </div>
                <div>
                    <div style="font-size:14px;font-weight:700;color:#8b0000;">
                        Critical Expiry Alert
                    </div>
                    <div style="font-size:13px;color:#c0392b;margin-top:2px;">
                        <strong>@ViewBag.CriticalBags bag(s)</strong>
                        will expire within 3 days. Immediate action required.
                    </div>
                </div>
            </div>
            <a asp-controller="Home" asp-action="ManageBloodBags"
               asp-route-status="Available"
               style="display:inline-flex;align-items:center;gap:8px;
                      background:#8b0000;color:white;padding:9px 18px;
                      border-radius:8px;font-size:13px;font-weight:600;
                      text-decoration:none;">
                <i class="fa-solid fa-eye"></i> View Critical Bags
            </a>
        </div>
    }

    @if (ViewBag.TotalExpiringSoon > 0)
    {
        <div style="background:#fff8e1;border:1px solid #f0d060;
                    border-left:5px solid #b8860b;border-radius:10px;
                    padding:14px 20px;margin-top:12px;
                    display:flex;align-items:center;justify-content:space-between;
                    flex-wrap:wrap;gap:10px;">
            <div style="display:flex;align-items:center;gap:12px;">
                <div style="width:40px;height:40px;border-radius:50%;
                            background:#b8860b;display:flex;align-items:center;
                            justify-content:center;flex-shrink:0;">
                    <i class="fa-solid fa-clock"
                       style="color:white;font-size:16px;"></i>
                </div>
                <div>
                    <div style="font-size:14px;font-weight:700;color:#b8860b;">
                        Expiry Warning
                    </div>
                    <div style="font-size:13px;color:#9a7000;margin-top:2px;">
                        <strong>@ViewBag.TotalExpiringSoon bag(s)</strong>
                        are expiring within 7 days. Please review soon.
                    </div>
                </div>
            </div>
            <a asp-controller="Home" asp-action="ManageBloodBags"
               style="display:inline-flex;align-items:center;gap:8px;
                      background:#b8860b;color:white;padding:9px 18px;
                      border-radius:8px;font-size:13px;font-weight:600;
                      text-decoration:none;">
                <i class="fa-solid fa-eye"></i> View Expiring Bags
            </a>
        </div>
    }

    @if (ViewBag.ExpiredUnhandled > 0)
    {
        <div style="background:#f5f5f5;border:1px solid #ddd;
                    border-left:5px solid #888;border-radius:10px;
                    padding:14px 20px;margin-top:12px;
                    display:flex;align-items:center;justify-content:space-between;
                    flex-wrap:wrap;gap:10px;">
            <div style="display:flex;align-items:center;gap:12px;">
                <div style="width:40px;height:40px;border-radius:50%;
                            background:#888;display:flex;align-items:center;
                            justify-content:center;flex-shrink:0;">
                    <i class="fa-solid fa-ban"
                       style="color:white;font-size:16px;"></i>
                </div>
                <div>
                    <div style="font-size:14px;font-weight:700;color:#555;">
                        Expired Bags
                    </div>
                    <div style="font-size:13px;color:#777;margin-top:2px;">
                        <strong>@ViewBag.ExpiredUnhandled bag(s)</strong>
                        have expired and should be discarded.
                    </div>
                </div>
            </div>
            <a asp-controller="Home" asp-action="ManageBloodBags"
               asp-route-status="Expired"
               style="display:inline-flex;align-items:center;gap:8px;
                      background:#888;color:white;padding:9px 18px;
                      border-radius:8px;font-size:13px;font-weight:600;
                      text-decoration:none;">
                <i class="fa-solid fa-trash"></i> Discard Expired
            </a>
        </div>
    }
    <!-- SYSTEM MANAGEMENT -->
    <div class="section-title">System Management</div>
    <div class="card-container">
        <div class="card">
            <div class="card-icon"><i class="fa-solid fa-users"></i></div>
            <a asp-controller="Donor" asp-action="ManageDonors">Manage Donors</a>
            <p>View &amp; edit donor records</p>
        </div>
        <div class="card">
            <div class="card-icon"><i class="fa-solid fa-user-tie"></i></div>
            <a asp-controller="Home" asp-action="ManageStaff">Manage Staff</a>
            <p>Add or remove staff members</p>
        </div>
        <div class="card">
            <div class="card-icon"><i class="fa-solid fa-building"></i></div>
            <a asp-controller="Home" asp-action="ManageHospital">Manage Hospitals</a>
            <p>Update hospital information</p>
        </div>
    </div>

    <!-- BLOOD MANAGEMENT -->
    <div class="section-title">Blood Management</div>
    <div class="card-container">
        <div class="card">
            <div class="card-icon"><i class="fa-solid fa-syringe"></i></div>
            <a asp-controller="Home" asp-action="ManageBloodStock">Manage Blood Stock</a>
            <p>Track available blood units</p>
        </div>
        <div class="card">
            <div class="card-icon"><i class="fa-solid fa-file-medical"></i></div>
            <a asp-controller="Home" asp-action="BloodRequests">Blood Requests</a>
            <p>Review incoming requests</p>
        </div>
        <div class="card">
            <div class="card-icon"><i class="fa-solid fa-chart-pie"></i></div>
            <a asp-controller="Home" asp-action="AdminReports">Generate Reports</a>
            <p>Export system reports</p>
        </div>
    </div>

    <!-- BLOOD STOCK TABLE -->
    <div class="table-section">
        <h3>
            Blood Stock Summary
            @if (ViewBag.TotalExpiringSoon > 0)
            {
                <span style="margin-left:12px;background:#fff8e1;color:#b8860b;
                             font-size:12px;padding:4px 12px;border-radius:20px;
                             font-weight:700;">
                    <i class="fa-solid fa-clock"></i>
                    @ViewBag.TotalExpiringSoon bag(s) expiring within 7 days
                </span>
            }
        </h3>
        <table>
            <tr>
                <th>Blood Group</th>
                <th>Available Units</th>
                <th>Stock Status</th>
                <th>Bags Expiring ≤7 Days</th>
                <th>Nearest Expiry</th>
                <th>Action</th>
            </tr>
            @if (Model != null && Model.Any())
            {
                @foreach (var stock in Model)
                {
                    var badgeColor = stock.Status == "sufficient" ? "#e6f9ef"
                    : stock.Status == "low" ? "#fff8e1"
                    : "#fff0f0";
                    var textColor = stock.Status == "sufficient" ? "#1a8a4a"
                    : stock.Status == "low" ? "#b8860b"
                    : "#8b0000";
                    var label = stock.Status == "sufficient" ? "Sufficient"
                    : stock.Status == "low" ? "Low Stock"
                    : "Critical";

                    // Match bag summary for this group
                    var bags = ViewBag.BagSummary as dynamic;
                    int expiringSoon = 0;
                    int critical = 0;
                    string nearestExpiry = "—";

                    if (bags != null)
                    {
                        foreach (var b in bags)
                        {
                            if (b.BloodGroup == stock.BloodGroup)
                            {
                                expiringSoon = b.ExpiringSoon;
                                critical = b.Critical;
                                nearestExpiry = ((DateTime)b.NearestExpiry)
                                .ToString("dd MMM yyyy");
                                break;
                            }
                        }
                    }

                    <tr>
                        <td><strong>@stock.BloodGroup</strong></td>
                        <td><span class="unit-badge">@stock.Units units</span></td>
                        <td>
                            <span style="background:@badgeColor;color:@textColor;
                                             padding:3px 10px;border-radius:20px;
                                             font-size:12px;font-weight:700;">
                                @label
                            </span>
                        </td>
                        <td>
                            @if (critical > 0)
                            {
                                <span style="background:#fff0f0;color:#8b0000;
                                                     padding:3px 10px;border-radius:20px;
                                                     font-size:12px;font-weight:700;">
                                    <i class="fa-solid fa-triangle-exclamation"></i>
                                    @critical bag(s) ≤3 days
                                </span>
                            }
                            else if (expiringSoon > 0)
                            {
                                <span style="background:#fff8e1;color:#b8860b;
                                                     padding:3px 10px;border-radius:20px;
                                                     font-size:12px;font-weight:700;">
                                    <i class="fa-solid fa-clock"></i>
                                    @expiringSoon bag(s) ≤7 days
                                </span>
                            }
                            else
                            {
                                <span style="color:#aaa;font-size:12px;">None</span>
                            }
                        </td>
                        <td style="font-size:13px;">@nearestExpiry</td>
                        <td>
                            <a asp-controller="Home" asp-action="ManageBloodBags"
                               asp-route-group="@stock.BloodGroup"
                               style="color:#8b0000;font-size:12px;
                                          font-weight:700;text-decoration:none;">
                                <i class="fa-solid fa-eye"></i> View Bags
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" style="text-align:center;color:#aaa;">
                        No blood stock records found.
                    </td>
                </tr>
            }
        </table>
    </div>

</div>