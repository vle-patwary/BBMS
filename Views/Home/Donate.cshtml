@model BBMS.Models.DonateBlood

@{
    ViewData["Title"] = "Donate Blood";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f4f6f9;
    }

    .form-container {
        width: 400px;
        margin: 50px auto;
        background: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

        .form-container h2 {
            text-align: center;
            margin-bottom: 20px;
            color: #e74c3c;
        }

    .form-group {
        margin-bottom: 15px;
    }

    label {
        font-weight: bold;
        display: block;
        margin-bottom: 5px;
    }

    input, select {
        width: 100%;
        padding: 10px;
        border-radius: 6px;
        border: 1px solid #ccc;
    }

    .btn {
        width: 100%;
        padding: 12px;
        background: #e74c3c;
        color: white;
        border: none;
        border-radius: 6px;
        font-weight: bold;
        cursor: pointer;
        margin-top: 10px;
    }

        .btn:hover {
            background: #c0392b;
        }

    .text-danger {
        color: red;
        font-size: 12px;
    }
</style>

<div class="form-container">
    <h2><i class="fa-solid fa-droplet"></i> Donate Blood</h2>

    <form asp-action="Donate" asp-controller="Home" method="post">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label>Full Name</label>
            <input asp-for="FullName" placeholder="Enter your name" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

      

        <div class="form-group">
            <label>Gender</label>
            <select asp-for="Gender">
                <option value="">Select Gender</option>
                <option>Male</option>
                <option>Female</option>
                <option>Other</option>
            </select>
            <span asp-validation-for="Gender" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Blood Group</label>
            <select asp-for="BloodGroup">
                <option value="">Select</option>
                <option>A+</option>
                <option>A-</option>
                <option>B+</option>
                <option>B-</option>
                <option>O+</option>
                <option>O-</option>
                <option>AB+</option>
                <option>AB-</option>
            </select>
            <span asp-validation-for="BloodGroup" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Last Donation Date</label>
            <input asp-for="LastDonationDate" type="date" />
        </div>

        <div class="form-group">
            <label>Location</label>
            <input asp-for="Location" placeholder="Your area" />
            <span asp-validation-for="Location" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Contact Number</label>
            <input asp-for="ContactNumber" placeholder="01XXXXXXXXX" />
            <span asp-validation-for="ContactNumber" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label>Email</label>
            <input asp-for="Email" type="email" placeholder="example@email.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <button type="submit" class="btn">Submit Donation</button>
    </form>
</div>
