@{
    ViewData["Title"] = "Request Blood";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f4f6f9;
    }

    .form-container {
        width: 460px;
        margin: 50px auto;
        background: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

        .form-container h2 {
            text-align: center;
            margin-bottom: 20px;
            color: #27ae60;
        }

    .form-group {
        margin-bottom: 15px;
    }

    label {
        font-weight: bold;
        display: block;
        margin-bottom: 5px;
    }

    input, select, textarea {
        width: 100%;
        padding: 10px;
        border-radius: 6px;
        border: 1px solid #ccc;
        box-sizing: border-box;
        font-size: 14px;
    }

    textarea {
        resize: none;
        height: 80px;
    }

    .btn {
        width: 100%;
        padding: 12px;
        background: #27ae60;
        color: white;
        border: none;
        border-radius: 6px;
        font-weight: bold;
        cursor: pointer;
        margin-top: 10px;
        display: block;
        text-align: center;
        text-decoration: none;
        font-size: 14px;
    }

        .btn:hover {
            background: #1e8449;
        }

        .btn:disabled {
            background: #ccc;
            cursor: not-allowed;
            color: #888;
        }

    .section-divider {
        border: none;
        border-top: 1px solid #e0e0e0;
        margin: 20px 0;
    }

    .section-title {
        font-size: 15px;
        font-weight: bold;
        color: #27ae60;
        margin-bottom: 10px;
    }

    .expense-notice {
        font-size: 13px;
        color: #555;
        background: #f9f9f9;
        border-left: 3px solid #27ae60;
        padding: 9px 12px;
        margin-bottom: 14px;
    }

    .invoice-table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 14px;
        font-size: 14px;
    }

        .invoice-table td {
            padding: 9px 14px;
            border-bottom: 1px solid #f0f0f0;
        }

        .invoice-table tr:last-child td {
            border-bottom: none;
        }

        .invoice-table td:last-child {
            text-align: right;
            color: #555;
        }

        .invoice-table tfoot td {
            font-weight: bold;
            background: #f4f4f4;
            border-top: 1px solid #ddd;
        }

            .invoice-table tfoot td:last-child {
                color: #27ae60;
                font-size: 15px;
            }

    #mobile-number-group {
        display: none;
    }

    .paid-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        font-weight: bold;
        color: #27ae60;
        background: #eaf7f0;
        border: 1px solid #a8dfc0;
        border-radius: 6px;
        padding: 8px 14px;
        margin-top: 10px;
        width: 100%;
        justify-content: center;
    }

    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }

        .modal-overlay.open {
            display: flex;
        }

    .modal-box {
        background: white;
        border-radius: 12px;
        width: 320px;
        padding: 28px 24px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    }

    .modal-title {
        font-size: 17px;
        font-weight: bold;
        color: #222;
        margin-bottom: 4px;
    }

    .modal-sub {
        font-size: 13px;
        color: #777;
        margin-bottom: 16px;
    }

    .modal-amount {
        font-size: 26px;
        font-weight: bold;
        color: #27ae60;
        margin-bottom: 18px;
    }

    .modal-box label {
        font-size: 12px;
        font-weight: bold;
        color: #555;
        margin-bottom: 5px;
    }

    .modal-box input {
        margin-bottom: 12px;
    }

    .modal-btn-row {
        display: flex;
        gap: 10px;
        margin-top: 16px;
    }

    .modal-cancel {
        flex: 1;
        padding: 10px;
        background: #f0f0f0;
        border: none;
        border-radius: 6px;
        font-weight: bold;
        cursor: pointer;
        font-size: 14px;
        color: #444;
    }

        .modal-cancel:hover {
            background: #e0e0e0;
        }

    .modal-confirm {
        flex: 1;
        padding: 10px;
        background: #27ae60;
        color: white;
        border: none;
        border-radius: 6px;
        font-weight: bold;
        cursor: pointer;
        font-size: 14px;
    }

        .modal-confirm:hover {
            background: #1e8449;
        }

    .error-msg {
        font-size: 12px;
        color: #e74c3c;
        margin-top: 6px;
        display: none;
    }

    .processing-box {
        text-align: center;
        padding: 10px 0;
    }

    .spinner {
        width: 44px;
        height: 44px;
        border: 4px solid #e0e0e0;
        border-top-color: #27ae60;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin: 0 auto 16px;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .success-circle {
        width: 54px;
        height: 54px;
        background: #eaf7f0;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 14px;
    }

    .processing-box .big {
        font-size: 16px;
        font-weight: bold;
        color: #222;
        margin-bottom: 6px;
    }

    .processing-box p {
        font-size: 13px;
        color: #777;
    }

    .done-btn {
        width: 100%;
        padding: 11px;
        background: #27ae60;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 14px;
        font-weight: bold;
        cursor: pointer;
        margin-top: 18px;
    }

        .done-btn:hover {
            background: #1e8449;
        }
</style>

<div class="form-container">
    <h2><i class="fa-solid fa-hand-holding-heart"></i> Request Blood</h2>

    <form id="blood-request-form" asp-controller="Home" asp-action="RequestBlood" method="post">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label>Patient Name</label>
            <input type="text" name="RequesterName" placeholder="Enter patient name" required>
        </div>
        <div class="form-group">
            <label>Blood Group Needed</label>
            <select name="BloodGroup" required>
                <option value="">Select</option>
                <option>A+</option>
                <option>A-</option>
                <option>B+</option>
                <option>B-</option>
                <option>O+</option>
                <option>O-</option>
                <option>AB+</option>
                <option>AB-</option>
            </select>
        </div>
        <div class="form-group">
            <label>Quantity (Units)</label>
            <input type="number" name="Quantity" id="quantity-input"
                   min="1" max="20" value="1" placeholder="Enter units needed"
                   required onchange="updateTotal()" oninput="updateTotal()">
        </div>
        <div class="form-group">
            <label>Required Date</label>
            <input type="date" name="RequiredDate" required>
        </div>

        <div class="form-group">
            <label>Hospital / Location</label>
            <input type="text" name="Hospital" placeholder="Where needed">
        </div>
        <div class="form-group">
            <label>Contact Number</label>
            <input type="text" name="ContactNumber" placeholder="01XXXXXXXXX">
        </div>
        <div class="form-group">
            <label>Additional Notes</label>
            <textarea name="Notes" placeholder="Optional details..."></textarea>
        </div>

        <hr class="section-divider">
        <div class="section-title"><i class="fa-solid fa-file-invoice-dollar"></i> Expense Breakdown</div>
        <div class="expense-notice">
            The following charges are fixed and managed by our staff. These expenses cover the materials required for the blood collection process.
        </div>
        <table class="invoice-table">
            <tbody>
                <tr><td>Needle</td><td id="cost-needle">Tk 10</td></tr>
                <tr><td>Blood collection bag</td><td id="cost-bag">Tk 100</td></tr>
                <tr><td>Gloves (pair)</td><td id="cost-gloves">Tk 30</td></tr>
                <tr><td>Antiseptic wipe</td><td id="cost-wipe">Tk 10</td></tr>
                <tr><td>Bandage</td><td id="cost-bandage">Tk 15</td></tr>
                <tr>
                    <td style="color:#555">Quantity (Units)</td>
                    <td id="cost-qty" style="color:#555">× 1</td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td>Total</td>
                    <td id="cost-total">Tk 165</td>
                </tr>
            </tfoot>
        </table>

        <hr class="section-divider">
        <div class="section-title"><i class="fa-solid fa-credit-card"></i> Payment</div>

        <div class="form-group">
            <label>Payment Method</label>
            <select id="payment-method" name="PaymentMethod" onchange="toggleMobileField()">
                <option value="">Select payment method</option>
                <option>bKash</option>
                <option>Nagad</option>
                <option>Rocket</option>
                <option>Cash on site</option>
                <option>Bank transfer</option>
            </select>
        </div>

        <div class="form-group" id="mobile-number-group">
            <label id="mobile-number-label">Mobile Number</label>
            <input type="text" name="MobileNumber" id="mobile-number" placeholder="01XXXXXXXXX">
        </div>

        <div id="pay-section">
            <button type="button" class="btn" id="pay-now-btn" onclick="openPaymentModal()" disabled>
                <i class="fa-solid fa-lock"></i> Pay Tk <span id="btn-total-display">165</span>
            </button>
        </div>

        <div id="paid-section" style="display:none;">
            <div class="paid-badge">
                <i class="fa-solid fa-circle-check"></i> Payment Successful — Tk <span id="paid-total-display">165</span> Paid
            </div>
        </div>

        <hr class="section-divider">
        <button type="submit" class="btn" id="submit-btn" disabled>
            <i class="fa-solid fa-paper-plane"></i> Submit Request
        </button>
    </form>
</div>

<!-- Payment Modal -->
<div class="modal-overlay" id="modal-overlay">
    <div class="modal-box">
        <div id="modal-step-1">
            <div class="modal-title" id="modal-title">bKash Payment</div>
            <div class="modal-sub" id="modal-sub">Send to: 01700-000000</div>
            <div class="modal-amount">Tk <span id="modal-amount-display">165</span></div>
            <label id="modal-number-label">Your bKash Number</label>
            <input type="text" id="modal-number-input" placeholder="01XXXXXXXXX" oninput="clearError()">
            <label>PIN</label>
            <input type="password" id="modal-pin-input" placeholder="Enter PIN" maxlength="5" oninput="clearError()">
            <div class="error-msg" id="error-msg">
                <i class="fa-solid fa-circle-exclamation"></i> Please enter a valid number and PIN.
            </div>
            <div class="modal-btn-row">
                <button type="button" class="modal-cancel" onclick="closeModal()">Cancel</button>
                <button type="button" class="modal-confirm" onclick="confirmPayment()">Confirm Pay</button>
            </div>
        </div>
        <div id="modal-step-2" style="display:none;">
            <div class="processing-box" id="processing-content">
                <div class="spinner"></div>
                <p class="big">Processing payment...</p>
                <p>Please wait</p>
            </div>
        </div>
    </div>
</div>

<script>
    const unitCost = 165;
    const cashMethods = ['Cash on site', 'Bank transfer'];

    function updateTotal() {
        const qty = parseInt(document.getElementById('quantity-input').value) || 1;
        const total = unitCost * qty;

        document.getElementById('cost-needle').textContent   = 'Tk ' + (10  * qty);
        document.getElementById('cost-bag').textContent      = 'Tk ' + (100 * qty);
        document.getElementById('cost-gloves').textContent   = 'Tk ' + (30  * qty);
        document.getElementById('cost-wipe').textContent     = 'Tk ' + (10  * qty);
        document.getElementById('cost-bandage').textContent  = 'Tk ' + (15  * qty);
        document.getElementById('cost-qty').textContent      = '× ' + qty;
        document.getElementById('cost-total').textContent    = 'Tk ' + total;

        // update pay button
        const payBtn = document.getElementById('pay-now-btn');
        const method = document.getElementById('payment-method').value;
        if (method && !cashMethods.includes(method)) {
            payBtn.innerHTML = '<i class="fa-solid fa-credit-card"></i> Pay Tk ' + total;
        }

        // update modal amount and paid badge
        document.getElementById('modal-amount-display').textContent = total;
        document.getElementById('btn-total-display').textContent    = total;
        document.getElementById('paid-total-display').textContent   = total;
    }

    function toggleMobileField() {
        const val   = document.getElementById('payment-method').value;
        const group = document.getElementById('mobile-number-group');
        const label = document.getElementById('mobile-number-label');
        const payBtn = document.getElementById('pay-now-btn');
        const qty   = parseInt(document.getElementById('quantity-input').value) || 1;
        const total = unitCost * qty;

        if (['bKash', 'Nagad', 'Rocket'].includes(val)) {
            group.style.display  = 'block';
            label.textContent    = val + ' Number';
        } else {
            group.style.display  = 'none';
        }

        if (val) {
            payBtn.disabled = false;
            payBtn.innerHTML = cashMethods.includes(val)
                ? '<i class="fa-solid fa-money-bill-wave"></i> Confirm Payment (Cash)'
                : '<i class="fa-solid fa-credit-card"></i> Pay Tk ' + total;
        } else {
            payBtn.disabled = true;
            payBtn.innerHTML = '<i class="fa-solid fa-lock"></i> Pay Tk <span id="btn-total-display">' + total + '</span>';
        }
    }

    function openPaymentModal() {
        const val = document.getElementById('payment-method').value;
        if (!val) return;

        const qty   = parseInt(document.getElementById('quantity-input').value) || 1;
        const total = unitCost * qty;
        document.getElementById('modal-amount-display').textContent = total;

        if (cashMethods.includes(val)) {
            document.getElementById('modal-step-1').style.display = 'none';
            document.getElementById('modal-step-2').style.display = 'block';
            document.getElementById('modal-overlay').classList.add('open');
            startProcessing(val, total);
            return;
        }

        const numberMap = { bKash: '01700-000000', Nagad: '01800-000000', Rocket: '01900-000000' };
        document.getElementById('modal-title').textContent       = val + ' Payment';
        document.getElementById('modal-sub').textContent         = 'Send to: ' + (numberMap[val] || '');
        document.getElementById('modal-number-label').textContent = 'Your ' + val + ' Number';
        document.getElementById('modal-number-input').value      = '';
        document.getElementById('modal-pin-input').value         = '';
        document.getElementById('modal-step-1').style.display    = 'block';
        document.getElementById('modal-step-2').style.display    = 'none';
        document.getElementById('modal-overlay').classList.add('open');
    }

    function closeModal() {
        document.getElementById('modal-overlay').classList.remove('open');
    }

    function clearError() {
        document.getElementById('error-msg').style.display = 'none';
    }

    function confirmPayment() {
        const num = document.getElementById('modal-number-input').value.trim();
        const pin = document.getElementById('modal-pin-input').value.trim();
        if (num.length < 11 || pin.length < 4) {
            document.getElementById('error-msg').style.display = 'block';
            return;
        }
        const val   = document.getElementById('payment-method').value;
        const qty   = parseInt(document.getElementById('quantity-input').value) || 1;
        const total = unitCost * qty;
        document.getElementById('modal-step-1').style.display = 'none';
        document.getElementById('modal-step-2').style.display = 'block';
        startProcessing(val, total);
    }

    function startProcessing(method, total) {
        document.getElementById('processing-content').innerHTML = `
            <div class="spinner"></div>
            <p class="big">Processing payment...</p>
            <p>Please wait</p>
        `;
        setTimeout(function () {
            document.getElementById('processing-content').innerHTML = `
                <div class="success-circle">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="12" r="12" fill="#27ae60"/>
                        <path d="M6.5 12.5l3.5 3.5 7-8" stroke="white" stroke-width="2"
                              stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <p class="big">Payment Successful!</p>
                <p>Tk ${total} paid via ${method}</p>
                <button type="button" class="done-btn" onclick="onPaymentDone(${total})">
                    <i class="fa-solid fa-check"></i> Done
                </button>
            `;
        }, 2500);
    }

        function onPaymentDone(total) {
        closeModal();
        document.getElementById('pay-section').style.display         = 'none';
        document.getElementById('paid-section').style.display        = 'block';
        document.getElementById('paid-total-display').textContent    = total;
        document.getElementById('mobile-number-group').style.display = 'none';

        // Use readOnly instead of disabled so values still submit with the form
        document.getElementById('quantity-input').readOnly           = true;
        document.getElementById('quantity-input').style.background   = '#f0f0f0';
        document.getElementById('quantity-input').style.color        = '#888';

        // Lock payment method visually without disabling it
        document.getElementById('payment-method').style.pointerEvents = 'none';
        document.getElementById('payment-method').style.background    = '#f0f0f0';
        document.getElementById('payment-method').style.color         = '#888';

        document.getElementById('submit-btn').disabled               = false;
        document.getElementById('submit-btn').innerHTML =
            '<i class="fa-solid fa-paper-plane"></i> Submit Request';
    }
</script>