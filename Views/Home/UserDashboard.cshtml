@model BBMS.Models.UserDashboardViewModel

@{
    ViewData["Title"] = "User Dashboard";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
    * {
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f4f6f9;
    }

    .dashboard {
        width: 92%;
        margin: 32px auto;
    }

    /* Header */
    .header {
        background: #8b0000;
        color: white;
        padding: 28px 32px;
        border-radius: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

        .header::before {
            content: '';
            position: absolute;
            right: -40px;
            top: -50px;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }

        .header::after {
            content: '';
            position: absolute;
            right: 120px;
            bottom: -60px;
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }

    .header-left h2 {
        font-size: 22px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 4px;
    }

    .header-left p {
        font-size: 13px;
        color: #ffb3b3;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 20px;
        z-index: 1;
    }

    .header-stat {
        text-align: center;
    }

        .header-stat .val {
            font-size: 20px;
            font-weight: 700;
            color: #fff;
        }

        .header-stat .lbl {
            font-size: 11px;
            color: #ffb3b3;
            margin-top: 2px;
        }

    .h-divider {
        width: 1px;
        height: 40px;
        background: rgba(255,255,255,0.2);
    }

    .blood-badge {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: rgba(255,255,255,0.15);
        border: 2px solid rgba(255,255,255,0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        font-weight: 700;
        color: #fff;
    }

    /* Info Cards */
    .info-row {
        display: flex;
        gap: 16px;
        margin-top: 22px;
        flex-wrap: wrap;
    }

    .info-card {
        flex: 1;
        min-width: 160px;
        background: white;
        padding: 18px 20px;
        border-radius: 10px;
        border: 1px solid #f0e0e0;
        border-left: 4px solid #8b0000;
    }

        .info-card span {
            font-size: 12px;
            color: #999;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .info-card h4 {
            margin-top: 6px;
            font-size: 17px;
            font-weight: 700;
            color: #1a1a1a;
        }

            .info-card h4.blood {
                color: #8b0000;
            }

    .available {
        color: #1a7a1a;
    }

    .not-available {
        color: #8b0000;
    }

    /* Section Title */
    .section-title {
        margin-top: 28px;
        margin-bottom: 14px;
        font-size: 15px;
        font-weight: 700;
        color: #1a1a1a;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .section-title::before {
            content: '';
            display: block;
            width: 4px;
            height: 16px;
            background: #8b0000;
            border-radius: 2px;
        }

    /* Action Cards */
    .card-container {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }

    .card {
        flex: 1;
        min-width: 180px;
        background: white;
        padding: 24px 20px;
        border-radius: 10px;
        text-align: center;
        border: 1px solid #f0e0e0;
        border-top: 4px solid #8b0000;
        transition: transform 0.2s, box-shadow 0.2s;
        cursor: pointer;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 24px rgba(139,0,0,0.1);
        }

    .card-icon {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: #fff0f0;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 12px;
    }

        .card-icon i {
            color: #8b0000;
            font-size: 18px;
        }

    .card a {
        text-decoration: none;
        color: #8b0000;
        font-weight: 700;
        font-size: 15px;
        display: block;
    }

    .card p {
        font-size: 12px;
        color: #999;
        margin-top: 5px;
    }

    /* Table */
    .table-section {
        margin-top: 24px;
        background: white;
        padding: 24px;
        border-radius: 10px;
        border: 1px solid #f0e0e0;
    }

        .table-section h3 {
            font-size: 15px;
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .table-section h3::before {
                content: '';
                display: block;
                width: 4px;
                height: 16px;
                background: #8b0000;
                border-radius: 2px;
            }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        background: #8b0000;
        color: white;
        padding: 12px 16px;
        font-size: 13px;
        font-weight: 600;
        text-align: left;
    }

    td {
        padding: 12px 16px;
        border-bottom: 1px solid #f5eded;
        font-size: 13px;
        color: #333;
    }

    tr:last-child td {
        border-bottom: none;
    }

    tr:hover td {
        background: #fff8f8;
    }

    .status-pill {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        background: #e8f5e9;
        color: #2e7d32;
    }
</style>

<div class="dashboard">

    <!-- HEADER -->
    <div class="header">
        <div class="header-left">
            <h2>Welcome, @Model.Name</h2>      @* ✅ was: @userName *@
            <p>Blood Donor Dashboard</p>
        </div>
        <div class="header-right">
            <div class="header-stat">
                <div class="val">@Model.TotalDonations</div>     @* ✅ was: hardcoded 2 *@
                <div class="lbl">Donations</div>
            </div>
            <div class="h-divider"></div>
            <div class="header-stat">
                <div class="val">@Model.LastDonationDate</div>   @* ✅ was: hardcoded "10 Mar" *@
                <div class="lbl">Last Donated</div>
            </div>
            <div class="h-divider"></div>
            <div class="blood-badge">@Model.BloodGroup</div>     @* ✅ was: @bloodGroup *@
        </div>
    </div>

    <!-- INFO -->
    <div class="info-row">
        <div class="info-card">
            <span>Donor Name</span>
            <h4>@Model.Name</h4>                                 @* ✅ was: @userName *@
        </div>
        <div class="info-card">
            <span>Blood Group</span>
            <h4 class="blood">@Model.BloodGroup</h4>             @* ✅ was: @bloodGroup *@
        </div>
        <div class="info-card">
            <span>Last Donation</span>
            <h4>@Model.LastDonationDate</h4>                     @* ✅ was: @lastDonation *@
        </div>
        <div class="info-card">
            <span>Status</span>
            <h4 class="@(Model.DonorStatus == "Available" ? "available" : "not-available")">
                @Model.DonorStatus                               @* ✅ was: @status *@
            </h4>
        </div>
    </div>

    <!-- ACTIONS -->
    <div class="section-title">Actions</div>
    <div class="card-container">
        <div class="card">
            <div class="card-icon"><i class="fa-solid fa-droplet"></i></div>
            <a asp-controller="Home" asp-action="Donate">Donate Blood</a>
            <p>Schedule your donation</p>
        </div>
        <div class="card">
            <div class="card-icon"><i class="fa-solid fa-hand-holding-heart"></i></div>
            <a asp-controller="Home" asp-action="RequestBlood">Request Blood</a>
            <p>Send emergency request</p>
        </div>
        <div class="card">
            <div class="card-icon"><i class="fa-solid fa-list-check"></i></div>
            <a asp-controller="Home" asp-action="BloodRequests">My Requests</a>
            <p>View all your blood requests</p>
        </div>
    </div>

    <!-- DONATIONS TABLE -->
    <div class="table-section">
        <h3>Recent Donations</h3>
        <table>
            <tr>
                <th>Date</th>
                <th>Blood Group</th>
                <th>Donor Name</th>
                <th>Status</th>
            </tr>

            @* ✅ was: hardcoded rows *@
            @if (Model.MyDonations != null && Model.MyDonations.Any())
            {
                @foreach (var d in Model.MyDonations)
                {
                    <tr>
                        <td>@d.CreatedAt.ToString("dd-MM-yyyy")</td>
                        <td>@d.BloodGroup</td>
                        <td>@d.FullName</td>
                        <td><span class="status-pill">Completed</span></td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" style="text-align:center; color:#999; padding:20px;">
                        No donations recorded yet.
                    </td>
                </tr>
            }
        </table>
    </div>
    <!-- BLOOD REQUESTS TABLE -->
    <div class="table-section" style="margin-top:24px;">
        <h3>My Blood Requests</h3>
        <table>
            <tr>
                <th>Invoice No</th>
                <th>Blood Group</th>
                <th>Quantity</th>
                <th>Hospital</th>
                <th>Required Date</th>
                <th>Status</th>
                <th>Refund</th>
            </tr>
            @if (Model.MyRequests != null && Model.MyRequests.Any())
            {
                foreach (var r in Model.MyRequests)
                {
                    <tr>
                        <td style="font-family:'Courier New',monospace;font-size:12px;font-weight:700;color:#8b0000;">
                            @r.InvoiceNumber
                        </td>
                        <td>
                            <span style="background:#fdecea;color:#c0392b;border:1px solid #f5b7b1;
                                             border-radius:6px;font-size:13px;font-weight:700;
                                             padding:2px 10px;">
                                @r.BloodGroup
                            </span>
                        </td>
                        <td>@r.Quantity unit(s)</td>
                        <td>@(string.IsNullOrEmpty(r.Hospital) ? "—" : r.Hospital)</td>
                        <td>@r.RequiredDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (r.Status == "Pending")
                            {
                                <span class="status-pill" style="background:#fff3e0;color:#e65100;">
                                    <i class="fa-solid fa-clock"></i> Pending
                                </span>
                            }
                            else if (r.Status == "Approved")
                            {
                                <span class="status-pill" style="background:#e8f5e9;color:#2e7d32;">
                                    <i class="fa-solid fa-circle-check"></i> Approved
                                </span>
                            }
                            else
                            {
                                <span class="status-pill" style="background:#fde8e8;color:#b30000;">
                                    <i class="fa-solid fa-circle-xmark"></i> Rejected
                                </span>
                            }
                        </td>
                        <td>
                            @if (r.Status == "Approved")
                            {
                                <a asp-controller="Home" asp-action="DownloadInvoice"
                                   asp-route-id="@r.Id" target="_blank"
                                   style="color:#6a1b9a;font-size:12px;font-weight:600;text-decoration:none;">
                                    <i class="fa-solid fa-file-pdf"></i> Invoice
                                </a>
                            }
                            else if (r.Status == "Rejected")
                            {
                                @if (r.RefundStatus == null)
                                {
                                    <form method="post" asp-controller="Home"
                                          asp-action="RequestRefund" asp-route-id="@r.Id">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                style="background:#fff3e0;color:#e65100;border:none;
                                                                   padding:4px 10px;border-radius:5px;font-size:12px;
                                                                   font-weight:600;cursor:pointer;"
                                                onclick="return confirm('Request refund for this rejected request?')">
                                            <i class="fa-solid fa-money-bill-wave"></i> Refund
                                        </button>
                                    </form>
                                }
                                else if (r.RefundStatus == "Requested")
                                {
                                    <span style="font-size:12px;color:#e65100;font-weight:600;">
                                        <i class="fa-solid fa-clock"></i> Refund Pending
                                    </span>
                                }
                                else if (r.RefundStatus == "Processed")
                                {
                                    <span style="font-size:12px;color:#2e7d32;font-weight:600;">
                                        <i class="fa-solid fa-circle-check"></i> Refunded
                                    </span>
                                }
                            }
                            else
                            {
                                <span style="font-size:12px;color:#bbb;">—</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" style="text-align:center;color:#999;padding:20px;">
                        No blood requests made yet.
                    </td>
                </tr>
            }
        </table>
    </div>

   