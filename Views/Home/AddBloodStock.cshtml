@model BBMS.Models.BloodStock
@{
    ViewData["Title"] = "Add Stock Entry";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f4f6f9;
    }

    .dashboard {
        width: 92%;
        max-width: 760px;
        margin: 32px auto 50px;
    }

    .header {
        background: #8b0000;
        color: white;
        padding: 28px 32px;
        border-radius: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        overflow: hidden;
        margin-bottom: 28px;
    }

    .header-left h2 {
        font-size: 22px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 5px;
    }

    .header-left p {
        font-size: 13px;
        color: #ffb3b3;
    }

    .header-right {
        z-index: 1;
    }

    .btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.2);
        color: #ffb3b3;
        padding: 9px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s;
    }

        .btn-ghost:hover {
            background: rgba(255,255,255,0.18);
        }

    /* PREVIEW */
    .preview-card {
        background: white;
        border: 1px solid #f0e0e0;
        border-left: 4px solid #8b0000;
        border-radius: 10px;
        padding: 20px 24px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .preview-avatar {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #8b0000;
        color: white;
        font-size: 20px;
        font-weight: 900;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 4px solid #fff0f0;
        box-shadow: 0 4px 16px rgba(139,0,0,0.2);
        transition: all 0.3s;
    }

    .preview-info {
        flex: 1;
    }

        .preview-info .p-group {
            font-size: 18px;
            font-weight: 800;
            color: #1a1a1a;
            min-height: 24px;
        }

        .preview-info .p-name {
            font-size: 13px;
            color: #888;
            margin-top: 3px;
            min-height: 18px;
        }

        .preview-info .p-tags {
            display: flex;
            gap: 8px;
            margin-top: 10px;
            flex-wrap: wrap;
        }

    .p-tag {
        font-size: 11px;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 20px;
        background: #fff0f0;
        color: #8b0000;
    }

        .p-tag.green {
            background: #e6f9ef;
            color: #1a8a4a;
        }

        .p-tag.yellow {
            background: #fff8e1;
            color: #b8860b;
        }

        .p-tag.red {
            background: #fff0f0;
            color: #8b0000;
        }

    /* FORM CARD */
    .form-card {
        background: white;
        border: 1px solid #f0e0e0;
        border-radius: 10px;
        overflow: hidden;
    }

    .form-card-header {
        background: #8b0000;
        color: white;
        padding: 14px 22px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        font-weight: 700;
    }

    .form-body {
        padding: 28px;
    }

    .form-section-title {
        font-size: 12px;
        font-weight: 700;
        color: #8b0000;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 2px solid #fff0f0;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 28px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .form-group.full {
            grid-column: 1 / -1;
        }

    label {
        font-size: 12px;
        font-weight: 700;
        color: #555;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        label i {
            color: #8b0000;
            font-size: 11px;
        }

        label .req {
            color: #8b0000;
        }

    input[type="text"], input[type="number"], input[type="date"], select, textarea {
        padding: 10px 13px;
        border: 1px solid #ddd;
        border-radius: 7px;
        font-size: 13px;
        color: #333;
        background: #fafafa;
        outline: none;
        font-family: inherit;
        width: 100%;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        input:focus, select:focus, textarea:focus {
            border-color: #8b0000;
            box-shadow: 0 0 0 3px rgba(139,0,0,0.07);
            background: white;
        }

        input.error, select.error {
            border-color: #e53935;
            box-shadow: 0 0 0 3px rgba(229,57,53,0.08);
        }

    .err-msg {
        font-size: 11px;
        color: #e53935;
        display: none;
        align-items: center;
        gap: 4px;
    }

        .err-msg.show {
            display: flex;
        }

    textarea {
        resize: vertical;
        min-height: 80px;
    }

    /* BLOOD GROUP BUTTONS */
    .blood-group-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        margin-bottom: 6px;
    }

    .blood-btn {
        padding: 12px 6px;
        border-radius: 8px;
        border: 2px solid #f0e0e0;
        background: white;
        font-size: 14px;
        font-weight: 800;
        color: #8b0000;
        cursor: pointer;
        text-align: center;
        transition: all 0.15s;
        font-family: inherit;
    }

        .blood-btn:hover {
            border-color: #8b0000;
            background: #fff0f0;
        }

        .blood-btn.selected {
            background: #8b0000;
            color: white;
            border-color: #8b0000;
            box-shadow: 0 4px 12px rgba(139,0,0,0.25);
        }

        .blood-btn .bg-sub {
            display: block;
            font-size: 10px;
            font-weight: 500;
            color: #aaa;
            margin-top: 3px;
        }

        .blood-btn.selected .bg-sub {
            color: rgba(255,255,255,0.7);
        }

    /* STOCK INDICATOR */
    .stock-indicator {
        margin-top: 10px;
        padding: 12px 16px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 10px;
        transition: all 0.3s;
    }

        .stock-indicator.good {
            background: #e6f9ef;
            color: #1a8a4a;
            border: 1px solid #b7ecd0;
        }

        .stock-indicator.low {
            background: #fff8e1;
            color: #b8860b;
            border: 1px solid #ffe082;
        }

        .stock-indicator.critical {
            background: #fff0f0;
            color: #8b0000;
            border: 1px solid #f5c0c0;
        }

        .stock-indicator.empty {
            background: #f5f5f5;
            color: #aaa;
            border: 1px solid #e0e0e0;
        }

    .progress-wrap {
        margin-top: 8px;
    }

    .progress-label {
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        color: #aaa;
        margin-bottom: 5px;
    }

    .progress-bar-bg {
        height: 8px;
        background: #f0e0e0;
        border-radius: 4px;
        overflow: hidden;
    }

    .progress-bar-fill {
        height: 100%;
        border-radius: 4px;
        background: #8b0000;
        transition: width 0.4s, background 0.4s;
        width: 0%;
    }

    .units-wrap {
        position: relative;
    }

        .units-wrap input[type="number"] {
            padding-right: 60px;
        }

    .units-suffix {
        position: absolute;
        right: 13px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 12px;
        color: #aaa;
        font-weight: 600;
        pointer-events: none;
    }

    /* ACTIONS */
    .form-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
        padding: 20px 28px;
        border-top: 1px solid #f5eded;
        background: #fffafa;
    }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 22px;
        border-radius: 8px;
        border: 1px solid #ddd;
        background: white;
        color: #555;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        font-family: inherit;
        transition: all 0.2s;
    }

        .btn-cancel:hover {
            border-color: #8b0000;
            color: #8b0000;
        }

    .btn-reset {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        border-radius: 8px;
        border: 1px solid #f0e0e0;
        background: #fff5f5;
        color: #8b0000;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        font-family: inherit;
        transition: all 0.2s;
    }

        .btn-reset:hover {
            background: #ffe0e0;
        }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 26px;
        border-radius: 8px;
        border: none;
        background: #8b0000;
        color: white;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        box-shadow: 0 4px 12px rgba(139,0,0,0.25);
        transition: all 0.2s;
    }

        .btn-submit:hover {
            background: #6e0000;
        }

    .divider {
        border: none;
        border-top: 1px solid #f5eded;
        margin: 4px 0 24px;
    }

    @@media (max-width: 600px) {
        .form-grid {
            grid-template-columns: 1fr;
        }

        .blood-group-grid {
            grid-template-columns: repeat(4, 1fr);
        }

        .preview-card {
            flex-direction: column;
            text-align: center;
        }

        .preview-info .p-tags {
            justify-content: center;
        }
    }
</style>

<div class="dashboard">

    <!-- HEADER -->
    <div class="header">
        <div class="header-left">
            <h2><i class="fa-solid fa-droplet" style="margin-right:10px"></i>Add Stock Entry</h2>
            <p>Record new blood units into the inventory</p>
        </div>
        <div class="header-right">
            <a asp-controller="Home" asp-action="ManageBloodStock" class="btn-ghost">
                <i class="fa-solid fa-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <!-- LIVE PREVIEW -->
    <div class="preview-card">
        <div class="preview-avatar" id="previewAvatar">?</div>
        <div class="preview-info">
            <div class="p-group" id="previewGroup">Select a blood group</div>
            <div class="p-name" id="previewName">—</div>
            <div class="p-tags">
                <span class="p-tag" id="previewUnits">Units: 0</span>
                <span class="p-tag" id="previewStatus">Status: —</span>
            </div>
        </div>
    </div>

    <!-- FORM -->
    <form asp-action="AddBloodStock" asp-controller="Home" method="post" id="stockForm">
        @Html.AntiForgeryToken()

        <!--
            This hidden field carries the selected blood group value.
            The blood-btn buttons are NOT <input> elements so we use JS to populate this.
        -->
        <input type="hidden" asp-for="BloodGroup" id="selectedGroup" />

        <div class="form-card">
            <div class="form-card-header">
                <i class="fa-solid fa-flask"></i> Stock Entry Details
            </div>
            <div class="form-body">

                <!-- ── BLOOD GROUP ── -->
                <div class="form-section-title"><i class="fa-solid fa-droplet"></i> Blood Group</div>
                <div class="blood-group-grid">
                    @foreach (var g in new[] { "A+", "A-", "B+", "B-", "O+", "O-", "AB+", "AB-" })
                    {
                        <button type="button" class="blood-btn" data-group="@g" onclick="selectGroup(this)">
                            @g
                            <span class="bg-sub">Select</span>
                        </button>
                    }
                </div>
                <span class="err-msg" id="err-group"><i class="fa-solid fa-circle-exclamation"></i> Please select a blood group.</span>
                <hr class="divider" />

                <!-- ── UNITS & STATUS ── -->
                <div class="form-section-title"><i class="fa-solid fa-flask"></i> Stock Details</div>
                <div class="form-grid">

                    <div class="form-group">
                        <label><i class="fa-solid fa-flask"></i> Available Units <span class="req">*</span></label>
                        <div class="units-wrap">
                            <input asp-for="Units" type="number" id="unitCount"
                                   min="0" max="999" placeholder="e.g. 50" oninput="updateUnits()" />
                            <span class="units-suffix">units</span>
                        </div>
                        <span class="err-msg" id="err-units"><i class="fa-solid fa-circle-exclamation"></i> Enter a valid unit count.</span>

                        <!-- Stock level indicator -->
                        <div class="stock-indicator empty" id="stockIndicator">
                            <i class="fa-solid fa-circle-info"></i>
                            <span id="stockIndicatorText">Enter units to see stock level</span>
                        </div>

                        <!-- Progress bar -->
                        <div class="progress-wrap">
                            <div class="progress-label">
                                <span>0</span><span>75+ units</span>
                            </div>
                            <div class="progress-bar-bg">
                                <div class="progress-bar-fill" id="progressFill"></div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label><i class="fa-solid fa-toggle-on"></i> Stock Status <span class="req">*</span></label>
                        <select asp-for="Status" id="stockStatus">
                            <option value="">— Auto / Select —</option>
                            <option value="sufficient">Sufficient (30+ units)</option>
                            <option value="low">Low Stock (15–29 units)</option>
                            <option value="critical">Critical (0–14 units)</option>
                        </select>
                        <span class="err-msg" id="err-status"><i class="fa-solid fa-circle-exclamation"></i> Please select a status.</span>
                    </div>

                </div>

                <!-- ── DATES ── -->
                <div class="form-section-title"><i class="fa-solid fa-calendar"></i> Dates</div>
                <div class="form-grid">

                    <div class="form-group">
                        <label><i class="fa-solid fa-calendar-day"></i> Collection Date <span class="req">*</span></label>
                        <input asp-for="CollectionDate" type="date" id="collectionDate" />
                        <span class="err-msg" id="err-date"><i class="fa-solid fa-circle-exclamation"></i> Collection date is required.</span>
                    </div>

                    <div class="form-group">
                        <label><i class="fa-solid fa-calendar-xmark"></i> Expiry Date</label>
                        <input asp-for="ExpiryDate" type="date" id="expiryDate" />
                    </div>

                </div>

                <!-- ── NOTES ── -->
                <div class="form-section-title"><i class="fa-solid fa-note-sticky"></i> Notes</div>
                <div class="form-group">
                    <label><i class="fa-solid fa-pen"></i> Additional Notes</label>
                    <textarea asp-for="Notes" id="stockNotes" placeholder="Any additional notes…"></textarea>
                </div>

            </div><!-- /form-body -->

            <div class="form-actions">
                <a asp-controller="Home" asp-action="ManageBloodStock" class="btn-cancel">
                    <i class="fa-solid fa-xmark"></i> Cancel
                </a>
                <button type="button" class="btn-reset" onclick="resetForm()">
                    <i class="fa-solid fa-rotate-left"></i> Reset
                </button>
                <button type="button" class="btn-submit" onclick="submitForm()">
                    <i class="fa-solid fa-floppy-disk"></i> Save Entry
                </button>
            </div>

        </div><!-- /form-card -->
    </form>
</div>

<script>
    const groupNames = {
        'A+':'A Positive','A-':'A Negative','B+':'B Positive','B-':'B Negative',
        'O+':'O Positive','O-':'O Negative','AB+':'AB Positive','AB-':'AB Negative'
    };
    let selectedGroupValue = '';

    // ── SELECT BLOOD GROUP ────────────────────────
    function selectGroup(btn) {
        document.querySelectorAll('.blood-btn').forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
        selectedGroupValue = btn.dataset.group;
        document.getElementById('selectedGroup').value = selectedGroupValue;  // <-- binds to model

        document.getElementById('previewAvatar').innerText = selectedGroupValue;
        document.getElementById('previewGroup').innerText  = selectedGroupValue;
        document.getElementById('previewName').innerText   = groupNames[selectedGroupValue] || '';
        document.getElementById('err-group').classList.remove('show');
        updateUnits();
    }

    // ── UNITS INDICATOR ───────────────────────────
    function updateUnits() {
        const units = parseInt(document.getElementById('unitCount').value) || 0;
        const pct   = Math.min((units / 75) * 100, 100);
        const fill  = document.getElementById('progressFill');
        fill.style.width = pct + '%';

        const indicator = document.getElementById('stockIndicator');
        const indicText = document.getElementById('stockIndicatorText');
        const statusSel = document.getElementById('stockStatus');
        const previewUnits  = document.getElementById('previewUnits');
        const previewStatus = document.getElementById('previewStatus');

        previewUnits.innerText = 'Units: ' + units;

        if (units === 0) {
            indicator.className     = 'stock-indicator empty';
            indicText.innerText     = 'Enter units to see stock level';
            fill.style.background   = '#ccc';
            previewStatus.className = 'p-tag';
            previewStatus.innerText = 'Status: —';
            return;
        }
        if (units >= 30) {
            indicator.className     = 'stock-indicator good';
            indicText.innerText     = 'Sufficient — stock level is adequate';
            fill.style.background   = '#1a8a4a';
            if (!statusSel.value) statusSel.value = 'sufficient';
            previewStatus.className = 'p-tag green';
            previewStatus.innerText = 'Sufficient';
        } else if (units >= 15) {
            indicator.className     = 'stock-indicator low';
            indicText.innerText     = 'Low Stock — consider restocking soon';
            fill.style.background   = '#b8860b';
            if (!statusSel.value) statusSel.value = 'low';
            previewStatus.className = 'p-tag yellow';
            previewStatus.innerText = 'Low Stock';
        } else {
            indicator.className     = 'stock-indicator critical';
            indicText.innerText     = 'Critical — immediate restocking needed!';
            fill.style.background   = '#8b0000';
            if (!statusSel.value) statusSel.value = 'critical';
            previewStatus.className = 'p-tag red';
            previewStatus.innerText = 'Critical';
        }
    }

    // ── VALIDATION ────────────────────────────────
    function validate() {
        let ok = true;

        if (!selectedGroupValue) {
            document.getElementById('err-group').classList.add('show');
            ok = false;
        }

        const units  = document.getElementById('unitCount').value;
        const unitEl = document.getElementById('unitCount');
        if (!units || parseInt(units) < 0) {
            unitEl.classList.add('error');
            document.getElementById('err-units').classList.add('show');
            ok = false;
        } else {
            unitEl.classList.remove('error');
            document.getElementById('err-units').classList.remove('show');
        }

        const statusEl = document.getElementById('stockStatus');
        if (!statusEl.value) {
            statusEl.classList.add('error');
            document.getElementById('err-status').classList.add('show');
            ok = false;
        } else {
            statusEl.classList.remove('error');
            document.getElementById('err-status').classList.remove('show');
        }

        const dateEl = document.getElementById('collectionDate');
        if (!dateEl.value) {
            dateEl.classList.add('error');
            document.getElementById('err-date').classList.add('show');
            ok = false;
        } else {
            dateEl.classList.remove('error');
            document.getElementById('err-date').classList.remove('show');
        }

        return ok;
    }

    // ── SUBMIT ────────────────────────────────────
    function submitForm() {
        if (!validate()) return;
        document.getElementById('stockForm').submit();
    }

    // ── RESET ─────────────────────────────────────
    function resetForm() {
        document.querySelectorAll('.blood-btn').forEach(b => b.classList.remove('selected'));
        selectedGroupValue = '';
        document.getElementById('selectedGroup').value = '';

        ['unitCount','collectionDate','expiryDate','stockNotes'].forEach(id => {
            const el = document.getElementById(id);
            if (el) { el.value = ''; el.classList.remove('error'); }
        });
        const statusEl = document.getElementById('stockStatus');
        statusEl.selectedIndex = 0;
        statusEl.classList.remove('error');

        document.querySelectorAll('.err-msg').forEach(e => e.classList.remove('show'));

        const fill = document.getElementById('progressFill');
        fill.style.width = '0%';
        fill.style.background = '#8b0000';
        document.getElementById('stockIndicator').className = 'stock-indicator empty';
        document.getElementById('stockIndicatorText').innerText = 'Enter units to see stock level';

        document.getElementById('previewAvatar').innerText  = '?';
        document.getElementById('previewGroup').innerText   = 'Select a blood group';
        document.getElementById('previewName').innerText    = '\u2014';
        document.getElementById('previewUnits').innerText   = 'Units: 0';
        document.getElementById('previewStatus').className  = 'p-tag';
        document.getElementById('previewStatus').innerText  = 'Status: \u2014';
    }

    // Clear errors on input
    document.querySelectorAll('input, select').forEach(el => {
        el.addEventListener('input', () => {
            el.classList.remove('error');
            const err = document.getElementById('err-' + el.id);
            if (err) err.classList.remove('show');
        });
    });

    // Default collection date to today
    document.getElementById('collectionDate').valueAsDate = new Date();
</script>