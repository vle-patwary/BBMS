@model List<BBMS.Models.BloodStock>
@{
    ViewData["Title"] = "Home";
}

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    /* ── HERO ── */
    .hero {
        background: #7a0000;
        padding: 64px 40px 56px;
        text-align: center;
        position: relative;
        overflow: hidden;
        width: 100%;
    }

    .hero-blob1 {
        position: absolute;
        right: -80px;
        top: -80px;
        width: 340px;
        height: 340px;
        border-radius: 50%;
        background: rgba(255,255,255,0.05);
        pointer-events: none;
    }

    .hero-blob2 {
        position: absolute;
        left: -80px;
        bottom: -80px;
        width: 260px;
        height: 260px;
        border-radius: 50%;
        background: rgba(255,255,255,0.04);
        pointer-events: none;
    }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255,255,255,0.1);
        color: #ffcccc;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        padding: 5px 14px;
        border-radius: 20px;
        margin-bottom: 18px;
        border: 0.5px solid rgba(255,255,255,0.18);
        position: relative;
        z-index: 1;
    }

        .hero-eyebrow i {
            font-size: 13px;
        }

    .hero h1 {
        font-size: 38px;
        font-weight: 600;
        color: #fff;
        line-height: 1.18;
        margin-bottom: 10px;
        position: relative;
        z-index: 1;
    }

        .hero h1 span {
            color: #ffb3b3;
        }

    .hero-sub {
        font-size: 15px;
        color: rgba(255,255,255,0.6);
        margin-bottom: 32px;
        position: relative;
        z-index: 1;
    }

    .hero-stats {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 34px;
        position: relative;
        z-index: 1;
    }

    .stat-box {
        padding: 0 28px;
        text-align: center;
    }

        .stat-box .num {
            font-size: 28px;
            font-weight: 600;
            color: #fff;
            line-height: 1;
        }

        .stat-box .lbl {
            font-size: 11px;
            color: rgba(255,255,255,0.5);
            margin-top: 5px;
            letter-spacing: 0.6px;
            text-transform: uppercase;
        }

    .hero-divider {
        width: 0.5px;
        height: 44px;
        background: rgba(255,255,255,0.2);
        flex-shrink: 0;
    }

    .hero-btns {
        display: flex;
        justify-content: center;
        gap: 12px;
        position: relative;
        z-index: 1;
    }

    .btn-donate {
        background: #fff;
        color: #7a0000;
        padding: 12px 28px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border: none;
        transition: background 0.15s;
    }

        .btn-donate:hover {
            background: #ffe5e5;
        }

    .btn-request {
        background: transparent;
        color: #fff;
        padding: 12px 28px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border: 0.5px solid rgba(255,255,255,0.4);
        transition: background 0.15s;
    }

        .btn-request:hover {
            background: rgba(255,255,255,0.1);
        }

    @@keyframes statPop {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.25);
        }

        100% {
            transform: scale(1);
        }
    }

    .stat-pop {
        animation: statPop 0.2s ease;
    }

    /* ── SECTION HEADER ── */
    .section {
        padding: 52px 40px;
        background: #fff;
        text-align: center;
    }

    .sec-label {
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #8b0000;
        margin-bottom: 6px;
    }

    .sec-title {
        font-size: 22px;
        font-weight: 600;
        color: #1a1a1a;
        margin-bottom: 34px;
    }

    /* ── SERVICE CARDS ── */
    .svc-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        max-width: 700px;
        margin: 0 auto;
    }

    .svc-card {
        background: #fff;
        border: 0.5px solid #e8d8d8;
        border-radius: 12px;
        padding: 24px 20px;
        text-align: left;
        transition: border-color 0.15s;
    }

        .svc-card:hover {
            border-color: #8b0000;
        }

    .svc-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: #fff0f0;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 14px;
    }

        .svc-icon i {
            font-size: 20px;
            color: #8b0000;
        }

    .svc-name {
        font-size: 14px;
        font-weight: 600;
        color: #1a1a1a;
        margin-bottom: 6px;
    }

    .svc-desc {
        font-size: 13px;
        color: #666;
        line-height: 1.6;
    }

    /* ── BLOOD STOCK SECTION ── */
    .stock-section {
        padding: 52px 40px;
        background: #fdf7f7;
        border-top: 0.5px solid #f0e0e0;
        border-bottom: 0.5px solid #f0e0e0;
        text-align: center;
    }

    /* ── ALERT BANNER ── */
    .alert-bar {
        background: #fff5f5;
        border: 0.5px solid #f7c1c1;
        border-radius: 10px;
        padding: 14px 18px;
        display: flex;
        align-items: center;
        gap: 12px;
        max-width: 700px;
        margin: 0 auto 24px;
        text-align: left;
    }

    .alert-icon {
        font-size: 22px;
        color: #8b0000;
        flex-shrink: 0;
    }

    .alert-text {
        flex: 1;
    }

    .alert-title {
        font-size: 13px;
        font-weight: 600;
        color: #7a0000;
    }

    .alert-sub {
        font-size: 12px;
        color: #a05050;
        margin-top: 2px;
    }

    .alert-btn {
        background: #8b0000;
        color: #fff;
        padding: 8px 16px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        white-space: nowrap;
        text-decoration: none;
        display: inline-block;
    }

        .alert-btn:hover {
            background: #6e0000;
        }

    /* ── BLOOD GRID ── */
    .blood-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        max-width: 700px;
        margin: 0 auto;
    }

    .b-card {
        background: #fff;
        border: 0.5px solid #e8d8d8;
        border-radius: 12px;
        padding: 18px 14px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 7px;
        transition: border-color 0.15s; 
    }
        .b-card:hover {
            border-color: #8b0000; /* ← add this */
        }

    .b-type {
        font-size: 22px;
        font-weight: 700;
        color: #8b0000;
    }

    .b-units {
        font-size: 11px;
        color: #888;
    }

    .b-bar {
        width: 100%;
        height: 4px;
        background: #f0e8e8;
        border-radius: 4px;
        overflow: hidden;
    }

    .b-fill {
        height: 100%;
        border-radius: 4px;
        transition: width 0.6s ease;
    }

    .pill {
        font-size: 11px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 20px;
    }

    .p-ok {
        background: #e8f7ee;
        color: #1a6638;
    }

    .p-low {
        background: #fef7e0;
        color: #92600a;
    }

    .p-crit {
        background: #fce8e8;
        color: #8b0000;
    }

   
</style>

@* ── HERO ── *@
<div class="hero">
    <div class="hero-blob1"></div>
    <div class="hero-blob2"></div>

    <div class="hero-eyebrow">
        <i class="ti ti-heart" aria-hidden="true"></i> Saving lives since 2020
    </div>

    <h1>Blood Bank<br /><span>Management System</span></h1>
    <p class="hero-sub">Every drop counts &mdash; donate blood, save a life today</p>

    <div class="hero-stats">
        <div class="stat-box">
            <div class="num" id="stat-donors" data-target="@ViewBag.TotalDonors" data-suffix="">0</div>
            <div class="lbl">Donors</div>
        </div>
        <div class="hero-divider"></div>
        <div class="stat-box">
            <div class="num" id="stat-lives" data-target="200" data-suffix="+">0</div>
            <div class="lbl">Lives Saved</div>
        </div>
        <div class="hero-divider"></div>
        <div class="stat-box">
            <div class="num" id="stat-groups" data-target="@ViewBag.TotalGroups" data-suffix="">0</div>
            <div class="lbl">Blood Groups</div>
        </div>
    </div>

    <div class="hero-btns">
        <a href="/Home/Donate" class="btn-donate">
            <i class="ti ti-heart" aria-hidden="true"></i> Donate Blood
        </a>
        <a href="/Home/RequestBlood" class="btn-request">
            <i class="ti ti-clipboard-list" aria-hidden="true"></i> Request Blood
        </a>
    </div>
</div>

@* ── SERVICES ── *@
<div class="section">
    <div class="sec-label">What we offer</div>
    <div class="sec-title">Our Services</div>
    <div class="svc-grid">
        <div class="svc-card">
            <div class="svc-icon"><i class="ti ti-heart" aria-hidden="true"></i></div>
            <div class="svc-name">Blood Donation</div>
            <div class="svc-desc">Register as a donor and help save lives by donating blood.</div>
        </div>
        <div class="svc-card">
            <div class="svc-icon"><i class="ti ti-clipboard-list" aria-hidden="true"></i></div>
            <div class="svc-name">Request Blood</div>
            <div class="svc-desc">Hospitals and patients can request blood quickly and easily.</div>
        </div>
        <div class="svc-card">
            <div class="svc-icon"><i class="ti ti-activity" aria-hidden="true"></i></div>
            <div class="svc-name">Track Requests</div>
            <div class="svc-desc">Check the status of your blood request in real time.</div>
        </div>
    </div>
</div>

@* ── BLOOD AVAILABILITY ── *@
<div class="stock-section">
    <div class="sec-label">Live Inventory</div>
    <div class="sec-title">Blood Availability</div>

    @{
        var criticalStock = Model?.FirstOrDefault(s => s.Status == "critical");
    }
    @if (criticalStock != null)
    {
        <div class="alert-bar">
            <i class="ti ti-alert-triangle alert-icon" aria-hidden="true"></i>
            <div class="alert-text">
                <div class="alert-title">@criticalStock.BloodGroup is critically low</div>
                <div class="alert-sub">Only @criticalStock.Units unit(s) remain &mdash; urgent donors needed now</div>
            </div>
            <a href="/Home/Donate" class="alert-btn">Donate Now</a>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="blood-grid">
            @foreach (var stock in Model)
            {
                var pillClass = stock.Status == "sufficient" ? "p-ok"
                : stock.Status == "low" ? "p-low"
                : "p-crit";

                var label = stock.Status == "sufficient" ? "Sufficient"
                : stock.Status == "low" ? "Low Stock"
                : "Critical";

                var fillColor = stock.Status == "sufficient" ? "#1a6638"
                : stock.Status == "low" ? "#92600a"
                : "#8b0000";

                @* Progress width: cap at 100 units = 100% *@
                var pct = Math.Min((stock.Units / 50.0) * 100, 100);

                <div class="b-card">
                    <div class="b-type">@stock.BloodGroup</div>
                    <div class="b-units">@stock.Units units</div>
                    <div class="b-bar">
                        <div class="b-fill" style="width:@(pct.ToString("0"))%; background:@fillColor;"></div>
                    </div>
                    <span class="pill @pillClass">@label</span>
                </div>
            }
        </div>
    }
    else
    {
        <p style="color:#aaa; font-size:14px; margin-top:10px;">No blood stock records available.</p>
    }
</div>


@* ── Tabler Icons ── *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@@3.19.0/dist/tabler-icons.min.css" />

<script>
    function countUp(el, target, suffix, duration) {
        const start = performance.now();
        function step(now) {
            const progress = Math.min((now - start) / duration, 1);
            const ease = 1 - Math.pow(1 - progress, 3);
            el.textContent = Math.round(ease * target) + suffix;
            if (progress < 1) {
                requestAnimationFrame(step);
            } else {
                el.textContent = target + suffix;
                el.classList.add('stat-pop');
                setTimeout(() => el.classList.remove('stat-pop'), 150);
            }
        }
        requestAnimationFrame(step);
    }

    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.hero-stats .num').forEach(function (el, i) {
            const target = parseInt(el.dataset.target, 10) || 0;
            const suffix = el.dataset.suffix || '';
            setTimeout(() => countUp(el, target, suffix, 1300), i * 200);
        });
    });
</script>
