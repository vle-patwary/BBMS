@model YourApp.Models.BloodRequest
@{
    ViewData["Title"] = "Request Successful";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f4f6f9;
        margin: 0;
        padding: 30px 0;
    }

    /* ── Success Banner ── */
    .success-banner {
        max-width: 680px;
        margin: 0 auto 24px;
        background: #eaf7f0;
        border: 1px solid #a8dfc0;
        border-radius: 10px;
        padding: 18px 24px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

        .success-banner .icon-circle {
            width: 48px;
            height: 48px;
            background: #27ae60;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .success-banner .icon-circle i {
                color: white;
                font-size: 20px;
            }

        .success-banner h2 {
            margin: 0 0 4px;
            font-size: 17px;
            color: #1a7a44;
        }

        .success-banner p {
            margin: 0;
            font-size: 13px;
            color: #2e8b57;
        }

    /* ── Invoice Card ── */
    .invoice-card {
        max-width: 680px;
        margin: 0 auto;
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.09);
        overflow: hidden;
    }

    /* Header */
    .invoice-header {
        background: #27ae60;
        color: white;
        padding: 28px 32px 22px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

        .invoice-header .org-name {
            font-size: 22px;
            font-weight: 700;
            margin: 0 0 4px;
        }

        .invoice-header .org-sub {
            font-size: 12px;
            opacity: 0.85;
            margin: 0;
        }

        .invoice-header .inv-meta {
            text-align: right;
            font-size: 12px;
            opacity: 0.9;
            line-height: 1.9;
        }

            .invoice-header .inv-meta strong {
                font-size: 15px;
                display: block;
            }

    /* Status ribbon */
    .status-ribbon {
        background: #1e8449;
        color: white;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        text-align: center;
        padding: 6px 0;
    }

    /* Body */
    .invoice-body {
        padding: 28px 32px;
    }

    /* Two-column info grid */
    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 28px;
    }

    .info-block h4 {
        font-size: 11px;
        font-weight: 700;
        color: #27ae60;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin: 0 0 10px;
        border-bottom: 1px solid #e8f5ee;
        padding-bottom: 6px;
    }

    .info-block table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

        .info-block table td {
            padding: 5px 0;
            vertical-align: top;
        }

            .info-block table td:first-child {
                color: #888;
                width: 120px;
                white-space: nowrap;
            }

            .info-block table td:last-child {
                color: #222;
                font-weight: 500;
            }

    /* Blood group badge */
    .blood-badge {
        display: inline-block;
        background: #fdecea;
        color: #c0392b;
        border: 1px solid #f5b7b1;
        border-radius: 6px;
        font-size: 15px;
        font-weight: 700;
        padding: 2px 12px;
    }

    /* Expense table */
    .section-label {
        font-size: 11px;
        font-weight: 700;
        color: #27ae60;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin: 0 0 10px;
        border-bottom: 1px solid #e8f5ee;
        padding-bottom: 6px;
    }

    .expense-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
        margin-bottom: 24px;
    }

        .expense-table thead tr {
            background: #f4f4f4;
        }

        .expense-table thead th {
            padding: 9px 14px;
            text-align: left;
            font-size: 11px;
            font-weight: 700;
            color: #666;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid #e0e0e0;
        }

            .expense-table thead th:last-child {
                text-align: right;
            }

        .expense-table tbody td {
            padding: 10px 14px;
            border-bottom: 1px solid #f5f5f5;
            color: #333;
        }

            .expense-table tbody td:last-child {
                text-align: right;
                color: #555;
            }

        .expense-table tfoot td {
            padding: 11px 14px;
            font-weight: 700;
            border-top: 2px solid #e0e0e0;
            background: #f9fffe;
        }

            .expense-table tfoot td:last-child {
                text-align: right;
                color: #27ae60;
                font-size: 16px;
            }

    /* Payment row */
    .payment-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #f9fffe;
        border: 1px solid #c8eedd;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 24px;
        font-size: 13px;
        flex-wrap: wrap;
        gap: 8px;
    }

        .payment-row .pay-label {
            color: #555;
        }

        .payment-row .pay-value {
            font-weight: 700;
            color: #27ae60;
            font-size: 14px;
        }

        .payment-row .pay-status {
            background: #27ae60;
            color: white;
            font-size: 11px;
            font-weight: 600;
            padding: 3px 10px;
            border-radius: 20px;
        }

    /* Barcode */
    .barcode-section {
        text-align: center;
        border-top: 1px dashed #ccc;
        padding-top: 22px;
        margin-bottom: 22px;
    }

        .barcode-section .ref-number {
            font-family: 'Courier New', monospace;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 3px;
            color: #222;
            display: block;
            margin-bottom: 4px;
        }

        .barcode-section .ref-label {
            font-size: 11px;
            color: #aaa;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

    .barcode-lines {
        display: flex;
        justify-content: center;
        gap: 2px;
        margin: 12px auto 8px;
        height: 48px;
        width: 220px;
    }

        .barcode-lines span {
            display: inline-block;
            height: 100%;
            background: #222;
        }

    /* Patient notes box */
    .patient-notes-box {
        background: #f4f6f9;
        border-left: 4px solid #27ae60;
        border-radius: 0 6px 6px 0;
        padding: 10px 14px;
        font-size: 13px;
        color: #444;
        margin-bottom: 24px;
        line-height: 1.6;
    }

        .patient-notes-box .notes-label {
            font-size: 11px;
            font-weight: 700;
            color: #27ae60;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 4px;
        }

    /* Important notes */
    .note-box {
        background: #fff8e1;
        border-left: 4px solid #f39c12;
        border-radius: 0 6px 6px 0;
        padding: 12px 16px;
        font-size: 12.5px;
        color: #6d4c00;
        margin-bottom: 24px;
        line-height: 1.7;
    }

        .note-box strong {
            display: block;
            margin-bottom: 4px;
            font-size: 13px;
            color: #5a3a00;
        }

        .note-box ul {
            margin: 6px 0 0;
            padding-left: 18px;
        }

            .note-box ul li {
                margin-bottom: 3px;
            }

    /* Footer */
    .invoice-footer {
        background: #f9f9f9;
        border-top: 1px solid #ececec;
        padding: 16px 32px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12px;
        color: #aaa;
    }

        .invoice-footer span i {
            color: #e74c3c;
        }

    /* Action Buttons */
    .action-buttons {
        max-width: 680px;
        margin: 20px auto 40px;
        display: flex;
        gap: 12px;
    }

    .btn-print {
        flex: 1;
        padding: 12px;
        background: #27ae60;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: bold;
        cursor: pointer;
        font-family: 'Segoe UI', sans-serif;
    }

        .btn-print:hover {
            background: #1e8449;
        }

    .btn-home {
        flex: 1;
        padding: 12px;
        background: white;
        color: #27ae60;
        border: 1px solid #27ae60;
        border-radius: 8px;
        font-size: 14px;
        font-weight: bold;
        cursor: pointer;
        text-align: center;
        text-decoration: none;
        display: block;
        font-family: 'Segoe UI', sans-serif;
    }

        .btn-home:hover {
            background: #f0faf4;
        }

    /* Print */
    @@media print {
        body {
            background: white;
            padding: 0;
        }

        .action-buttons, .success-banner {
            display: none !important;
        }

        .invoice-card {
            box-shadow: none;
            border-radius: 0;
            max-width: 100%;
        }
    }
</style>

<!-- Success Banner -->
<div class="success-banner">
    <div class="icon-circle">
        <i class="fa-solid fa-circle-check"></i>
    </div>
    <div>
        <h2>Blood Request Submitted Successfully!</h2>
        <p>Your request has been received. Please present this invoice at the blood bank to collect the blood.</p>
    </div>
</div>

<!-- Invoice Card -->
<div class="invoice-card">

    <!-- Green Header -->
    <div class="invoice-header">
        <div>
            <p class="org-name"><i class="fa-solid fa-droplet"></i> BBMS Blood Bank</p>
            <p class="org-sub">Dhaka Medical College Road, Dhaka-1000 &nbsp;|&nbsp; +880 1700-000000</p>
        </div>
        <div class="inv-meta">
            <strong>BLOOD REQUEST INVOICE</strong>
            Invoice No: @Model.InvoiceNumber <br>
            Date: @Model.RequestDate.ToString("dd MMM yyyy") <br>
            Time: @Model.RequestDate.ToString("hh:mm tt")
        </div>
    </div>

    <!-- Ribbon -->
    <div class="status-ribbon">
        <i class="fa-solid fa-circle-check"></i>&nbsp; Payment Confirmed &nbsp;·&nbsp; Request Submitted — Pending Approval
    </div>

    <!-- Body -->
    <div class="invoice-body">

        <!-- Patient & Request Info -->
        <div class="info-grid">

            <div class="info-block">
                <h4><i class="fa-solid fa-user-injured"></i> Requester Details</h4>
                <table>
                    <tr>
                        <td>Requester Name</td>
                        <td>@Model.RequesterName</td>
                    </tr>
                    <tr>
                        <td>Blood Group</td>
                        <td><span class="blood-badge">@Model.BloodGroup</span></td>
                    </tr>
                    <tr>
                        <td>Units Required</td>
                        <td>@Model.UnitsRequired unit(s)</td>
                    </tr>
                    <tr>
                        <td>Contact</td>
                        <td>@Model.ContactNumber</td>
                    </tr>
                    <tr>
                        <td>Required Date</td>
                        <td>@Model.RequiredDate.ToString("dd MMM yyyy")</td>
                    </tr>
                </table>
            </div>

            <div class="info-block">
                <h4><i class="fa-solid fa-hospital"></i> Request Details</h4>
                <table>
                    <tr>
                        <td>Hospital</td>
                        <td>@Model.Hospital</td>
                    </tr>
                    <tr>
                        <td>Request ID</td>
                        <td>#@Model.InvoiceNumber</td>
                    </tr>
                    <tr>
                        <td>Request Date</td>
                        <td>@Model.RequestDate.ToString("dd MMM yyyy")</td>
                    </tr>
                    <tr>
                        <td>Status</td>
                        <td>
                            <span style="background:#fff8e1; color:#b8860b; border:1px solid #ffe082;
                                         padding:2px 10px; border-radius:20px; font-size:12px; font-weight:600;">
                                ⏳ Pending
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <td>Valid Until</td>
                        <td>@Model.RequestDate.AddDays(3).ToString("dd MMM yyyy")</td>
                    </tr>
                </table>
            </div>

        </div>

        @* Additional notes — only rendered if the user filled them in *@
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="patient-notes-box">
                <div class="notes-label"><i class="fa-solid fa-note-sticky"></i> Additional Notes</div>
                <div>@Model.Notes</div>
            </div>
        }

        <!-- Expense Breakdown -->
        <div class="section-label">
            <i class="fa-solid fa-file-invoice-dollar"></i> Expense Breakdown
        </div>
        <table class="expense-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Item</th>
                    <th>Qty</th>
                    <th>Amount</th>
                </tr>
            </thead>
            <tbody>
                <tr><td>1</td><td>Needle</td><td>1</td><td>Tk 10</td></tr>
                <tr><td>2</td><td>Blood collection bag</td><td>1</td><td>Tk 100</td></tr>
                <tr><td>3</td><td>Gloves (pair)</td><td>1</td><td>Tk 30</td></tr>
                <tr><td>4</td><td>Antiseptic wipe</td><td>1</td><td>Tk 10</td></tr>
                <tr><td>5</td><td>Bandage</td><td>1</td><td>Tk 15</td></tr>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3">Total Paid</td>
                    <td>Tk 165</td>
                </tr>
            </tfoot>
        </table>

        <!-- Payment Info -->
        <div class="payment-row">
            <span class="pay-label"><i class="fa-solid fa-credit-card"></i> Payment Method</span>
            <span class="pay-value">
                @Model.PaymentMethod
                @if (!string.IsNullOrEmpty(Model.MobileNumber))
                {
                    <text> &nbsp;·&nbsp; @Model.MobileNumber</text>
                }
            </span>
            <span class="pay-status"><i class="fa-solid fa-check"></i> PAID</span>
        </div>

        <!-- Barcode Section -->
        <div class="barcode-section">
            <div class="barcode-lines" id="barcode-lines"></div>
            <span class="ref-number">@Model.InvoiceNumber</span>
            <span class="ref-label">Present this code at the blood bank counter</span>
        </div>

        <!-- Important Notes -->
        <div class="note-box">
            <strong><i class="fa-solid fa-triangle-exclamation"></i> Important — Please Read Before Visiting</strong>
            <ul>
                <li>Bring this invoice (printed or on your phone) to the blood bank.</li>
                <li>A valid National ID or passport of the patient or guardian is required.</li>
                <li>This invoice is valid for <strong>3 days</strong> from the date of issue.</li>
                <li>Blood will only be released after admin/staff approval.</li>
                <li>For assistance, call our helpline: <strong>+880 1700-000000</strong></li>
            </ul>
        </div>

    </div>

    <!-- Invoice Footer -->
    <div class="invoice-footer">
        <span>Generated by BBMS Blood Bank System</span>
        <span>Made with <i class="fa-solid fa-heart"></i> to save lives</span>
        <span>Ref: @Model.InvoiceNumber</span>
    </div>

</div>

<!-- Action Buttons -->
<div class="action-buttons">
    <button class="btn-print" onclick="window.print()">
        <i class="fa-solid fa-print"></i> Print Invoice
    </button>
    <a asp-controller="Home" asp-action="Index" class="btn-home">
        <i class="fa-solid fa-house"></i> Back to Home
    </a>
</div>

<script>
    // Generate a visual barcode from the invoice number
    (function () {
        const seed      = '@Model.InvoiceNumber';
        const container = document.getElementById('barcode-lines');
        const widths    = [1, 2, 3, 1, 2];

        for (let i = 0; i < 55; i++) {
            const bar  = document.createElement('span');
            const code = seed.charCodeAt(i % seed.length);
            bar.style.width = (widths[i % widths.length] + (code % 2)) + 'px';
            if (i % 3 === 0) bar.style.height = '80%';
            container.appendChild(bar);
        }
    })();
</script>
