@model List<BBMS.Models.BloodStock>
@{
    ViewData["Title"] = "Manage Blood Stock";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f4f6f9;
    }

    .dashboard {
        width: 92%;
        margin: 32px auto 50px;
    }

    .header {
        background: #8b0000;
        color: white;
        padding: 28px 32px;
        border-radius: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        overflow: hidden;
        margin-bottom: 26px;
    }

        .header::before {
            content: '';
            position: absolute;
            right: -40px;
            top: -50px;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }

        .header::after {
            content: '';
            position: absolute;
            right: 120px;
            bottom: -60px;
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }

    .header-left h2 {
        font-size: 22px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 5px;
    }

    .header-left p {
        font-size: 13px;
        color: #ffb3b3;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 12px;
        z-index: 1;
    }

    .header-stat {
        text-align: center;
    }

        .header-stat .val {
            font-size: 20px;
            font-weight: 700;
            color: #fff;
        }

        .header-stat .lbl {
            font-size: 11px;
            color: #ffb3b3;
            margin-top: 2px;
        }

    .h-divider {
        width: 1px;
        height: 40px;
        background: rgba(255,255,255,0.2);
    }

    .btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.2);
        color: #ffb3b3;
        padding: 9px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s;
    }

        .btn-ghost:hover {
            background: rgba(255,255,255,0.18);
        }

    .section-title {
        font-size: 15px;
        font-weight: 700;
        color: #1a1a1a;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
    }

        .section-title::before {
            content: '';
            display: block;
            width: 4px;
            height: 16px;
            background: #8b0000;
            border-radius: 2px;
        }

    .stat-row {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 26px;
    }

    .stat-card {
        flex: 1;
        min-width: 140px;
        background: white;
        border: 1px solid #f0e0e0;
        border-top: 4px solid #8b0000;
        border-radius: 10px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .sc-icon {
        width: 44px;
        height: 44px;
        background: #fff0f0;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .sc-icon i {
            color: #8b0000;
            font-size: 17px;
        }

    .sc-val {
        font-size: 24px;
        font-weight: 800;
        color: #8b0000;
    }

    .sc-lbl {
        font-size: 12px;
        color: #888;
        margin-top: 2px;
    }

    .toolbar {
        background: white;
        border: 1px solid #f0e0e0;
        border-radius: 10px;
        padding: 16px 22px;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 20px;
    }

    .search-wrap {
        flex: 1;
        min-width: 200px;
        position: relative;
    }

        .search-wrap i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #aaa;
            font-size: 13px;
        }

        .search-wrap input {
            width: 100%;
            padding: 9px 12px 9px 34px;
            border: 1px solid #ddd;
            border-radius: 7px;
            font-size: 13px;
            color: #333;
            background: #fafafa;
            outline: none;
            font-family: inherit;
        }

            .search-wrap input:focus {
                border-color: #8b0000;
            }

    .toolbar select {
        padding: 9px 12px;
        border: 1px solid #ddd;
        border-radius: 7px;
        font-size: 13px;
        color: #333;
        background: #fafafa;
        outline: none;
        font-family: inherit;
    }

    .btn-add {
        background: #8b0000;
        color: white;
        padding: 9px 18px;
        border-radius: 8px;
        border: none;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-family: inherit;
        text-decoration: none;
        transition: background 0.2s;
        white-space: nowrap;
    }

        .btn-add:hover {
            background: #6e0000;
        }

    .table-section {
        background: white;
        border: 1px solid #f0e0e0;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 40px;
    }

    .table-section-header {
        padding: 16px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #f5eded;
    }

        .table-section-header span {
            font-size: 14px;
            font-weight: 700;
            color: #1a1a1a;
        }

    .record-count {
        font-size: 12px;
        background: #fff0f0;
        color: #8b0000;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 20px;
    }

    .table-wrap {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead th {
        background: #8b0000;
        color: white;
        padding: 12px 16px;
        font-size: 12px;
        font-weight: 600;
        text-align: left;
        white-space: nowrap;
    }

    tbody td {
        padding: 13px 16px;
        border-bottom: 1px solid #f5eded;
        font-size: 13px;
        color: #333;
        vertical-align: middle;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    tbody tr:hover td {
        background: #fff8f8;
    }

    .blood-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .blood-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #8b0000;
        color: white;
        font-size: 13px;
        font-weight: 800;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .blood-group-name {
        font-weight: 700;
        color: #1a1a1a;
        font-size: 15px;
    }

    .blood-group-sub {
        font-size: 11px;
        color: #aaa;
        margin-top: 1px;
    }

    .units-cell {
        min-width: 140px;
    }

    .units-val {
        font-size: 14px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 5px;
    }

    .progress-bar-wrap {
        height: 6px;
        background: #f0e0e0;
        border-radius: 3px;
        overflow: hidden;
    }

    .progress-bar {
        height: 100%;
        border-radius: 3px;
        transition: width 0.4s;
    }

    .bar-good {
        background: #1a8a4a;
    }

    .bar-low {
        background: #b8860b;
    }

    .bar-critical {
        background: #8b0000;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .status-good {
        background: #e6f9ef;
        color: #1a8a4a;
    }

    .status-low {
        background: #fff8e1;
        color: #b8860b;
    }

    .status-critical {
        background: #fff0f0;
        color: #8b0000;
    }

    /* ── ACTIONS ── */
    .actions {
        display: flex;
        gap: 6px;
        align-items: center;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        border: none;
        font-family: inherit;
        transition: all 0.15s;
    }

    .btn-edit {
        background: #1565c0;
        color: white;
    }

        .btn-edit:hover {
            background: #0d47a1;
            color: white;
        }

    .btn-delete {
        background: #8b0000;
        color: white;
    }

        .btn-delete:hover {
            background: #6e0000;
            color: white;
        }

    /* ── MODAL BACKDROP ── */
    .bs-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.82);
        z-index: 999999;
        align-items: center;
        justify-content: center;
    }

        .bs-modal-overlay.show {
            display: flex;
            pointer-events: all;
        }

    .modal-box {
        background: #ffffff;
        isolation: isolate;
        border-radius: 12px;
        width: 500px;
        max-width: 95vw;
        box-shadow: 0 25px 70px rgba(0,0,0,0.6);
        overflow: hidden;
        position: relative;
        z-index: 1000000;
        animation: modalSlideIn 0.25s ease;
    }

    @@keyframes modalSlideIn {
        from {
            transform: translateY(-20px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .modal-header {
        background: #8b0000;
        color: white;
        padding: 16px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 14px;
        font-weight: 700;
    }

    .modal-header-title {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .modal-close {
        background: none;
        border: none;
        color: rgba(255,255,255,0.8);
        font-size: 20px;
        cursor: pointer;
        line-height: 1;
        padding: 2px 6px;
        border-radius: 4px;
        transition: all 0.15s;
    }

        .modal-close:hover {
            color: white;
            background: rgba(255,255,255,0.15);
        }

    .modal-body {
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 18px;
        background: #ffffff;
    }

    .modal-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .modal-group label {
            font-size: 12px;
            font-weight: 700;
            color: #555;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .modal-group label i {
                color: #8b0000;
                font-size: 11px;
            }

        .modal-group input,
        .modal-group select {
            padding: 10px 13px;
            border: 1px solid #ddd;
            border-radius: 7px;
            font-size: 13px;
            color: #333;
            background: #fafafa;
            outline: none;
            font-family: inherit;
            width: 100%;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .modal-group input:focus,
            .modal-group select:focus {
                border-color: #8b0000;
                box-shadow: 0 0 0 3px rgba(139,0,0,0.08);
                background: white;
            }

            .modal-group input[readonly] {
                background: #f5f5f5;
                color: #888;
                cursor: not-allowed;
            }

    .modal-note {
        background: #fff5f5;
        border: 1px solid #f0e0e0;
        border-left: 3px solid #8b0000;
        border-radius: 7px;
        padding: 10px 14px;
        font-size: 12px;
        color: #8b0000;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 16px 24px;
        border-top: 1px solid #f5eded;
        background: #ffffff;
    }

    .btn-cancel-modal {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 20px;
        border-radius: 8px;
        border: 1px solid #ddd;
        background: white;
        color: #555;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        font-family: inherit;
        transition: all 0.2s;
    }

        .btn-cancel-modal:hover {
            border-color: #8b0000;
            color: #8b0000;
        }

    .btn-save-modal {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 22px;
        border-radius: 8px;
        border: none;
        background: #8b0000;
        color: white;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        box-shadow: 0 4px 12px rgba(139,0,0,0.25);
        transition: all 0.2s;
    }

        .btn-save-modal:hover {
            background: #6e0000;
        }

    /* ── DELETE MODAL ── */
    .delete-modal-box {
        background: #ffffff;
        isolation: isolate;
        border-radius: 12px;
        width: 420px;
        max-width: 95vw;
        overflow: hidden;
        box-shadow: 0 25px 70px rgba(0,0,0,0.6);
        position: relative;
        z-index: 1000000;
        animation: modalSlideIn 0.25s ease;
    }

    .delete-modal-header {
        background: #8b0000;
        color: white;
        padding: 16px 22px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        font-weight: 700;
    }

    .delete-modal-body {
        padding: 24px;
        font-size: 13px;
        color: #444;
        line-height: 1.6;
        background: #ffffff;
    }

        .delete-modal-body strong {
            color: #8b0000;
        }

    .delete-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 16px 24px;
        border-top: 1px solid #f5eded;
        background: #ffffff;
    }

    .btn-confirm-delete {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 22px;
        border-radius: 8px;
        border: none;
        background: #8b0000;
        color: white;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        transition: all 0.2s;
    }

        .btn-confirm-delete:hover {
            background: #6e0000;
        }

    @@media (max-width: 700px) {
        .stat-row {
            flex-direction: column;
        }

        .actions {
            flex-wrap: wrap;
        }
    }
</style>

<div class="dashboard">

    <!-- HEADER -->
    <div class="header">
        <div class="header-left">
            <h2><i class="fa-solid fa-droplet" style="margin-right:10px"></i>Manage Blood Stock</h2>
            <p>Monitor and update available blood unit inventory</p>
        </div>
        <div class="header-right">
            <div class="header-stat">
                <div class="val">@ViewBag.TotalGroups</div><div class="lbl">Blood Groups</div>
            </div>
            <div class="h-divider"></div>
            <div class="header-stat">
                <div class="val">@ViewBag.TotalUnits</div><div class="lbl">Total Units</div>
            </div>
            <div class="h-divider"></div>
            <div class="header-stat">
                <div class="val">@ViewBag.CriticalCount</div><div class="lbl">Critical</div>
            </div>
            <div class="h-divider"></div>
            <a asp-controller="Home" asp-action="Admin" class="btn-ghost">
                <i class="fa-solid fa-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <!-- STAT CARDS -->
    <div class="section-title">Overview</div>
    <div class="stat-row">
        <div class="stat-card">
            <div class="sc-icon"><i class="fa-solid fa-droplet"></i></div>
            <div><div class="sc-val">@ViewBag.TotalUnits</div><div class="sc-lbl">Total Units</div></div>
        </div>
        <div class="stat-card">
            <div class="sc-icon"><i class="fa-solid fa-circle-check"></i></div>
            <div><div class="sc-val">@ViewBag.SufficientCount</div><div class="sc-lbl">Sufficient</div></div>
        </div>
        <div class="stat-card">
            <div class="sc-icon"><i class="fa-solid fa-clock"></i></div>
            <div><div class="sc-val">@ViewBag.LowCount</div><div class="sc-lbl">Low</div></div>
        </div>
        <div class="stat-card">
            <div class="sc-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
            <div><div class="sc-val">@ViewBag.CriticalCount</div><div class="sc-lbl">Critical</div></div>
        </div>
        <div class="stat-card">
            <div class="sc-icon"><i class="fa-solid fa-calendar-day"></i></div>
            <div><div class="sc-val">Today</div><div class="sc-lbl">Last Updated</div></div>
        </div>
    </div>

    <!-- TOOLBAR -->
    <div class="toolbar">
        <div class="search-wrap">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="searchInput" placeholder="Search blood group…" oninput="filterTable()">
        </div>
        <select id="statusFilter" onchange="filterTable()">
            <option value="">All Status</option>
            <option value="sufficient">Sufficient</option>
            <option value="low">Low Stock</option>
            <option value="critical">Critical</option>
        </select>
        <a asp-action="AddBloodStock" asp-controller="Home" class="btn-add">
            <i class="fa-solid fa-plus"></i> Add Blood Entry
        </a>
    </div>

    <!-- TABLE -->
    <div class="table-section">
        <div class="table-section-header">
            <span><i class="fa-solid fa-list" style="color:#8b0000;margin-right:8px"></i>Blood Inventory</span>
            <span class="record-count" id="recordCount">@Model.Count records</span>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Blood Group</th>
                        <th>Available Units</th>
                        <th>Status</th>
                        <th>Last Updated</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="stockBody">
                    @foreach (var item in Model)
                    {
                        var barClass = item.Status == "sufficient" ? "bar-good" : item.Status == "low" ? "bar-low" : "bar-critical";
                        var badgeClass = item.Status == "sufficient" ? "status-good" : item.Status == "low" ? "status-low" : "status-critical";
                        var avatarColor = item.Status == "sufficient" ? "#8b0000" : item.Status == "low" ? "#b8860b" : "#6e0000";
                        var barWidth = Math.Min((item.Units / 75.0) * 100, 100).ToString("F0");
                        var badgeIcon = item.Status == "sufficient" ? "fa-circle-check" : item.Status == "low" ? "fa-clock" : "fa-triangle-exclamation";
                        var badgeLabel = item.Status == "sufficient" ? "Sufficient" : item.Status == "low" ? "Low Stock" : "Critical";

                        <tr data-group="@item.BloodGroup" data-units="@item.Units" data-status="@item.Status">
                            <td>
                                <div class="blood-cell">
                                    <div class="blood-avatar" style="background:@avatarColor">@item.BloodGroup</div>
                                    <div>
                                        <div class="blood-group-name">@item.BloodGroup</div>
                                        <div class="blood-group-sub">Added @item.CollectionDate.ToString("dd MMM yyyy")</div>
                                    </div>
                                </div>
                            </td>
                            <td class="units-cell">
                                <div class="units-val">@item.Units units</div>
                                <div class="progress-bar-wrap">
                                    <div class="progress-bar @barClass" style="width:@barWidth%"></div>
                                </div>
                            </td>
                            <td>
                                <span class="status-badge @badgeClass">
                                    <i class="fa-solid @badgeIcon"></i> @badgeLabel
                                </span>
                            </td>
                            <td>@item.LastUpdated.ToString("dd MMM yyyy")</td>
                            <td>
                                <div class="actions">
                                    <button class="action-btn btn-edit"
                                            onclick="openEditModal('@item.BloodGroup', @item.Units, '@item.LastUpdated.ToString("dd MMM yyyy")', @item.Id)">
                                        <i class="fa-solid fa-pen-to-square"></i> Edit
                                    </button>
                                    <button class="action-btn btn-delete"
                                            onclick="openDeleteModal(@item.Id, '@item.BloodGroup')">
                                        <i class="fa-solid fa-trash"></i> Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div style="padding:14px 22px; border-top:1px solid #f5eded; font-size:13px; color:#888;">
            Showing <span id="pageInfo">@Model.Count</span> blood group entries
        </div>
    </div>
</div>

<!-- ═══════════════════════════════
     EDIT MODAL
═══════════════════════════════ -->
<div class="bs-modal-overlay" id="editModal">
    <div class="modal-box">
        <div class="modal-header">
            <span class="modal-header-title">
                <i class="fa-solid fa-pen-to-square"></i>
                <span id="editModalTitle">Edit Stock</span>
            </span>
            <button class="modal-close" onclick="closeEditModal()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="modal-body">
            <div class="modal-note">
                <i class="fa-solid fa-circle-info"></i>
                <span id="editModalNote">Update the unit count and status below.</span>
            </div>
            <div class="modal-group">
                <label><i class="fa-solid fa-droplet"></i> Blood Group</label>
                <input type="text" id="edit-group" readonly>
            </div>
            <div class="modal-group">
                <label><i class="fa-solid fa-flask"></i> Available Units <span style="color:#8b0000">*</span></label>
                <input type="number" id="edit-units" min="0" placeholder="Enter unit count">
            </div>
            <div class="modal-group">
                <label><i class="fa-solid fa-toggle-on"></i> Stock Status</label>
                <select id="edit-status">
                    <option value="sufficient">Sufficient (30+ units)</option>
                    <option value="low">Low Stock (15–29 units)</option>
                    <option value="critical">Critical (0–14 units)</option>
                </select>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-cancel-modal" onclick="closeEditModal()">
                <i class="fa-solid fa-xmark"></i> Cancel
            </button>
            <button class="btn-save-modal" onclick="saveEdit()">
                <i class="fa-solid fa-floppy-disk"></i> Save Changes
            </button>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════
     DELETE CONFIRM MODAL
═══════════════════════════════ -->
<div class="bs-modal-overlay" id="deleteModal">
    <div class="delete-modal-box">
        <div class="delete-modal-header">
            <i class="fa-solid fa-triangle-exclamation"></i> Confirm Delete
        </div>
        <div class="delete-modal-body">
            Are you sure you want to delete the blood stock entry for
            <strong id="deleteGroupLabel"></strong>?
            This action <strong>cannot be undone</strong>.
        </div>
        <div class="delete-modal-footer">
            <button class="btn-cancel-modal" onclick="closeDeleteModal()">
                <i class="fa-solid fa-xmark"></i> Cancel
            </button>
            <button class="btn-confirm-delete" onclick="confirmDelete()">
                <i class="fa-solid fa-trash"></i> Yes, Delete
            </button>
        </div>
    </div>
</div>

<!-- Hidden form — Edit -->
<form id="editForm" asp-action="UpdateBloodStock" asp-controller="Home" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="edit-form-id" />
    <input type="hidden" name="units" id="edit-form-units" />
    <input type="hidden" name="status" id="edit-form-status" />
</form>

<!-- Hidden form — Delete (only ONE, placed here at the bottom) -->
<form id="deleteForm" asp-action="DeleteBloodStock" asp-controller="Home" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="delete-form-id" />
</form>

<script>
    // ── Move modals to <body> so Bootstrap .container doesn't clip them ──
    document.addEventListener('DOMContentLoaded', function () {
        ['editModal', 'deleteModal'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) document.body.appendChild(el);
        });
    });

    // ── FILTER ────────────────────────────────────
    function filterTable() {
        const search = document.getElementById('searchInput').value.toLowerCase();
        const status = document.getElementById('statusFilter').value.toLowerCase();
        const rows   = document.querySelectorAll('#stockBody tr');
        let visible  = 0;
        rows.forEach(row => {
            const group     = (row.dataset.group  || '').toLowerCase();
            const rowStatus = (row.dataset.status || '').toLowerCase();
            const ok = (!search || group.includes(search)) && (!status || rowStatus === status);
            row.style.display = ok ? '' : 'none';
            if (ok) visible++;
        });
        document.getElementById('recordCount').innerText = visible + ' record' + (visible !== 1 ? 's' : '');
        document.getElementById('pageInfo').innerText    = visible;
    }

    // ── EDIT MODAL ────────────────────────────────
    function openEditModal(group, units, date, id) {
        document.getElementById('edit-form-id').value       = id;
        document.getElementById('editModalTitle').innerText = 'Edit Stock — ' + group;
        document.getElementById('edit-group').value         = group;
        document.getElementById('edit-units').value         = units;
        document.getElementById('editModalNote').innerText  = 'Last updated: ' + date + '. Change the values below.';

        const s = document.getElementById('edit-status');
        s.value = units >= 30 ? 'sufficient' : units >= 15 ? 'low' : 'critical';

        document.getElementById('editModal').classList.add('show');
        document.body.style.overflow = 'hidden';
    }

    function closeEditModal() {
        document.getElementById('editModal').classList.remove('show');
        document.body.style.overflow = '';
    }

    function saveEdit() {
        const units = parseInt(document.getElementById('edit-units').value);
        if (isNaN(units) || units < 0) {
            document.getElementById('edit-units').style.borderColor = '#e53935';
            document.getElementById('edit-units').focus();
            return;
        }
        document.getElementById('edit-form-units').value  = units;
        document.getElementById('edit-form-status').value = document.getElementById('edit-status').value;
        document.getElementById('editForm').submit();
    }

    document.addEventListener('DOMContentLoaded', function () {
        document.getElementById('editModal').addEventListener('click', function (e) {
            if (e.target === this) closeEditModal();
        });
        document.getElementById('deleteModal').addEventListener('click', function (e) {
            if (e.target === this) closeDeleteModal();
        });
    });

    // Auto-update status when units change
    document.getElementById('edit-units').addEventListener('input', function () {
        const units = parseInt(this.value);
        const sel   = document.getElementById('edit-status');
        if (!isNaN(units)) {
            sel.value = units >= 30 ? 'sufficient' : units >= 15 ? 'low' : 'critical';
        }
    });

    // ── DELETE MODAL ──────────────────────────────
    function openDeleteModal(id, group) {
        document.getElementById('delete-form-id').value      = id;
        document.getElementById('deleteGroupLabel').innerText = group;
        document.getElementById('deleteModal').classList.add('show');
        document.body.style.overflow = 'hidden';
    }

    function closeDeleteModal() {
        document.getElementById('deleteModal').classList.remove('show');
        document.body.style.overflow = '';
    }

    function confirmDelete() {
        document.getElementById('deleteForm').submit();
    }

    // ── TOAST ─────────────────────────────────────
    @if (TempData["SuccessMessage"] != null)
    {
            <text>
            window.addEventListener('DOMContentLoaded', () => showToast('@TempData["SuccessMessage"]'));
            </text>
    }

    function showToast(msg) {
        let t = document.getElementById('globalToast');
        if (!t) {
            t = document.createElement('div');
            t.id = 'globalToast';
            t.style.cssText = [
                'position:fixed','bottom:28px','right:28px','background:#1a8a4a','color:white',
                'padding:14px 22px','border-radius:10px','font-size:13px','font-weight:600',
                'display:flex','align-items:center','gap:10px','box-shadow:0 8px 28px rgba(0,0,0,0.18)',
                "font-family:'Segoe UI',sans-serif",'transform:translateY(80px)','opacity:0',
                'transition:all 0.35s cubic-bezier(.34,1.56,.64,1)','z-index:9999999'
            ].join(';');
            document.body.appendChild(t);
        }
        t.innerHTML = '<i class="fa-solid fa-circle-check"></i> ' + msg;
        setTimeout(() => { t.style.transform = 'translateY(0)';   t.style.opacity = '1'; }, 10);
        setTimeout(() => { t.style.transform = 'translateY(80px)'; t.style.opacity = '0'; }, 3200);
    }
</script>
