        </div>
        <div style="padding:14px 22px; border-top:1px solid #f5eded; font-size:13px; color:#888;">
            Showing <span id="pageInfo">8</span> blood group entries
        </div>
    </div>
</div>

<!-- UPDATE MODAL -->
<div class="modal-backdrop" id="updateModal">
    <div class="modal-box">
        <div class="modal-header">
            <span class="modal-header-title">
                <i class="fa-solid fa-droplet"></i>
                <span id="modalGroupTitle">Update Stock</span>
            </span>
            <button class="modal-close" onclick="closeUpdateModal()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="modal-body">
            <div class="modal-group">
                <label><i class="fa-solid fa-droplet"></i> Blood Group</label>
                <input type="text" id="modal-group" readonly style="background:#f0f0f0; color:#888;">
            </div>
            <div class="modal-group">
                <label><i class="fa-solid fa-flask"></i> Available Units <span style="color:#8b0000">*</span></label>
                <input type="number" id="modal-units" min="0" placeholder="Enter unit count">
            </div>
            <div class="modal-group">
                <label><i class="fa-solid fa-toggle-on"></i> Status</label>
                <select id="modal-status">
                    <option value="sufficient">Sufficient</option>
                    <option value="low">Low Stock</option>
                    <option value="critical">Critical</option>
                </select>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-cancel-modal" onclick="closeUpdateModal()">
                <i class="fa-solid fa-xmark"></i> Cancel
            </button>
            <button class="btn-save-modal" onclick="saveUpdate()">
                <i class="fa-solid fa-floppy-disk"></i> Save Changes
            </button>
        </div>
    </div>
</div>

<script>
    // ── FILTER ────────────────────────────────────
    function filterTable() {
        const search = document.getElementById('searchInput').value.toLowerCase();
        const status = document.getElementById('statusFilter').value.toLowerCase();
        const rows   = document.querySelectorAll('#stockBody tr');
        let visible  = 0;

        rows.forEach(row => {
            const group     = (row.dataset.group  || '').toLowerCase();
            const rowStatus = (row.dataset.status || '').toLowerCase();
            const ok = (!search || group.includes(search))
                    && (!status || rowStatus === status);
            row.style.display = ok ? '' : 'none';
            if (ok) visible++;
        });

        document.getElementById('recordCount').innerText = visible + ' record' + (visible !== 1 ? 's' : '');
        document.getElementById('pageInfo').innerText    = visible;
    }

    // ── UPDATE MODAL ──────────────────────────────
    function openUpdateModal(group, units, date) {
        document.getElementById('modalGroupTitle').innerText = 'Update – ' + group;
        document.getElementById('modal-group').value         = group;
        document.getElementById('modal-units').value         = units;

        const statusEl = document.getElementById('modal-status');
        if      (units >= 30) statusEl.value = 'sufficient';
        else if (units >= 15) statusEl.value = 'low';
        else                  statusEl.value = 'critical';

        document.getElementById('updateModal').classList.add('show');
    }

    function closeUpdateModal() {
        document.getElementById('updateModal').classList.remove('show');
    }

    function saveUpdate() {
        closeUpdateModal();
        showToast('Blood stock updated successfully!');
    }

    // ── ADD MODAL (reuse update modal) ────────────
    function openAddModal() {
        document.getElementById('modalGroupTitle').innerText = 'Add Stock Entry';
        document.getElementById('modal-group').value         = '';
        document.getElementById('modal-group').removeAttribute('readonly');
        document.getElementById('modal-group').style.background = '';
        document.getElementById('modal-group').style.color = '';
        document.getElementById('modal-units').value         = '';
        document.getElementById('modal-status').value        = 'sufficient';
        document.getElementById('updateModal').classList.add('show');
    }

    // ── BACKDROP CLICK ────────────────────────────
    document.getElementById('updateModal').addEventListener('click', function(e) {
        if (e.target === this) this.classList.remove('show');
    });

    // ── TOAST ─────────────────────────────────────
    function showToast(msg) {
        let t = document.getElementById('globalToast');
        if (!t) {
            t = document.createElement('div');
            t.id = 'globalToast';
            t.style.cssText = [
                'position:fixed','bottom:28px','right:28px',
                'background:#1a8a4a','color:white',
                'padding:14px 22px','border-radius:10px',
                'font-size:13px','font-weight:600',
                'display:flex','align-items:center','gap:10px',
                'box-shadow:0 8px 28px rgba(0,0,0,0.18)',
                "font-family:'Segoe UI',sans-serif",
                'transform:translateY(80px)','opacity:0',
                'transition:all 0.35s cubic-bezier(.34,1.56,.64,1)',
                'z-index:9999'
            ].join(';');
            document.body.appendChild(t);
        }
        t.innerHTML = '<i class="fa-solid fa-circle-check"></i> ' + msg;
        setTimeout(() => { t.style.transform = 'translateY(0)'; t.style.opacity = '1'; }, 10);
        setTimeout(() => { t.style.transform = 'translateY(80px)'; t.style.opacity = '0'; }, 3200);
    }
</script>
