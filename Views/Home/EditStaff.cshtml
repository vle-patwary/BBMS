@model BBMS.Models.Staff
@{
    ViewData["Title"] = "Edit Staff";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f4f6f9;
    }

    .page-wrap {
        width: 92%;
        max-width: 860px;
        margin: 32px auto 60px;
    }

    .header {
        background: #8b0000;
        color: white;
        padding: 28px 32px;
        border-radius: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        overflow: hidden;
        margin-bottom: 28px;
    }

        .header::before {
            content: '';
            position: absolute;
            right: -40px;
            top: -50px;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }

        .header::after {
            content: '';
            position: absolute;
            right: 120px;
            bottom: -60px;
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }

    .header-left h2 {
        font-size: 22px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 5px;
    }

    .header-left p {
        font-size: 13px;
        color: #ffb3b3;
    }

    .header-right {
        z-index: 1;
    }

    .btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.2);
        color: #ffb3b3;
        padding: 9px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s;
    }

        .btn-ghost:hover {
            background: rgba(255,255,255,0.18);
        }

    .form-card {
        background: white;
        border: 1px solid #f0e0e0;
        border-radius: 12px;
        overflow: hidden;
    }

    .form-card-header {
        background: #fff5f5;
        border-bottom: 1px solid #f0e0e0;
        padding: 16px 28px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .form-card-header i {
            color: #8b0000;
            font-size: 15px;
        }

        .form-card-header span {
            font-size: 14px;
            font-weight: 700;
            color: #1a1a1a;
        }

    .staff-id-badge {
        margin-left: auto;
        background: #fff0f0;
        color: #8b0000;
        font-size: 12px;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 20px;
        border: 1px solid #f0e0e0;
    }

    .form-body {
        padding: 28px;
        display: flex;
        flex-direction: column;
        gap: 22px;
    }

    .section-label {
        font-size: 12px;
        font-weight: 700;
        color: #8b0000;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 8px;
        padding-bottom: 10px;
        border-bottom: 1px solid #f5eded;
        margin-bottom: 4px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    .span-2 {
        grid-column: span 2;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .field label {
            font-size: 12px;
            font-weight: 700;
            color: #555;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .field label i {
                color: #8b0000;
                font-size: 11px;
            }

            .field label .req {
                color: #8b0000;
                margin-left: 2px;
            }

        .field input, .field select {
            padding: 10px 13px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 13px;
            color: #333;
            background: #fafafa;
            outline: none;
            font-family: inherit;
            width: 100%;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .field input:focus, .field select:focus {
                border-color: #8b0000;
                box-shadow: 0 0 0 3px rgba(139,0,0,0.08);
                background: white;
            }

        .field .hint {
            font-size: 11px;
            color: #aaa;
            margin-top: 2px;
        }

        .field .text-danger {
            font-size: 11px;
            color: #c0392b;
            margin-top: 2px;
            display: flex;
            align-items: center;
            gap: 4px;
        }

    .pw-wrap {
        position: relative;
    }

        .pw-wrap input {
            padding-right: 42px;
        }

    .pw-toggle {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: #aaa;
        font-size: 13px;
        padding: 0;
        transition: color 0.2s;
    }

        .pw-toggle:hover {
            color: #8b0000;
        }

    .form-footer {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
        padding: 20px 28px;
        border-top: 1px solid #f5eded;
        background: #fffafa;
    }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 22px;
        border-radius: 8px;
        border: 1px solid #ddd;
        background: white;
        color: #555;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        font-family: inherit;
        transition: all 0.2s;
    }

        .btn-cancel:hover {
            border-color: #8b0000;
            color: #8b0000;
        }

    .btn-save {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 26px;
        border-radius: 8px;
        border: none;
        background: #8b0000;
        color: white;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        box-shadow: 0 4px 14px rgba(139,0,0,0.25);
        transition: background 0.2s;
    }

        .btn-save:hover {
            background: #6e0000;
        }

    @@media (max-width: 680px) {
        .form-grid {
            grid-template-columns: 1fr;
        }

        .span-2 {
            grid-column: span 1;
        }
    }
</style>

<div class="page-wrap">

    <div class="header">
        <div class="header-left">
            <h2><i class="fa-solid fa-pen-to-square" style="margin-right:10px"></i>Edit Staff</h2>
            <p>Update details for <strong style="color:#fff">@Model.Name</strong></p>
        </div>
        <div class="header-right">
            <a asp-action="ManageStaff" asp-controller="Home" class="btn-ghost">
                <i class="fa-solid fa-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <div class="form-card">
        <div class="form-card-header">
            <i class="fa-solid fa-user-tie"></i>
            <span>Staff Information</span>
            <span class="staff-id-badge">STF-@Model.Id.ToString("D4")</span>
        </div>

        <form asp-action="EditStaff" asp-controller="Home" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="JoinDate" />
            <input type="hidden" asp-for="IdentityUserId" />

            <div class="form-body">

                <!-- Personal Info -->
                <div>
                    <div class="section-label">
                        <i class="fa-solid fa-circle-info"></i> Personal Information
                    </div>
                    <div class="form-grid">
                        <div class="field span-2">
                            <label>
                                <i class="fa-solid fa-user"></i>
                                Full Name <span class="req">*</span>
                            </label>
                            <input asp-for="Name" placeholder="e.g. Dr. Rahim Uddin" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="field">
                            <label>
                                <i class="fa-solid fa-envelope"></i>
                                Email <span class="req">*</span>
                            </label>
                            <input asp-for="Email" type="email" placeholder="e.g. staff@bbms.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="field">
                            <label>
                                <i class="fa-solid fa-phone"></i>
                                Contact Number <span class="req">*</span>
                            </label>
                            <input asp-for="Contact" placeholder="e.g. 01712345678" />
                            <span asp-validation-for="Contact" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Role & Status — Only Admin and Staff allowed -->
                <div>
                    <div class="section-label">
                        <i class="fa-solid fa-briefcase"></i> Role & Status
                    </div>
                    <div class="form-grid">
                        <div class="field">
                            <label>
                                <i class="fa-solid fa-tag"></i>
                                Role <span class="req">*</span>
                            </label>
                            <select asp-for="Role">
                                <option value="">— Select Role —</option>
                                <option value="Admin">Admin</option>
                                <option value="Staff">Staff</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger"></span>
                        </div>

                        <div class="field">
                            <label>
                                <i class="fa-solid fa-toggle-on"></i>
                                Status
                            </label>
                            <select asp-for="Status">
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                                <option value="On Leave">On Leave</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Password — plain name="NewPassword", NOT asp-for -->
                <div>
                    <div class="section-label">
                        <i class="fa-solid fa-lock"></i> Change Password
                    </div>
                    <div class="form-grid">
                        <div class="field span-2">
                            <label>
                                <i class="fa-solid fa-key"></i>
                                New Password
                            </label>
                            <div class="pw-wrap">
                                <input type="password"
                                       id="pwInput"
                                       name="NewPassword"
                                       placeholder="Leave blank to keep current password" />
                                <button type="button" class="pw-toggle" onclick="togglePassword()">
                                    <i class="fa-solid fa-eye" id="pwIcon"></i>
                                </button>
                            </div>
                            <span class="hint">
                                <i class="fa-solid fa-circle-info" style="color:#8b0000;font-size:10px"></i>
                                Minimum 6 characters. Leave blank to keep the existing password.
                            </span>
                        </div>
                    </div>
                </div>

            </div>

            <div class="form-footer">
                <a asp-action="ManageStaff" asp-controller="Home" class="btn-cancel">
                    <i class="fa-solid fa-xmark"></i> Cancel
                </a>
                <button type="submit" class="btn-save">
                    <i class="fa-solid fa-floppy-disk"></i> Save Changes
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function togglePassword() {
            const input = document.getElementById('pwInput');
            const icon  = document.getElementById('pwIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        }
    </script>
}