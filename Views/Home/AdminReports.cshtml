@{
    ViewData["Title"] = "Generate Reports";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

<style>
    * {
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f4f6f9;
    }

    .reports-wrapper {
        width: 92%;
        margin: 32px auto;
    }

    /* HEADER */
    .header {
        background: #8b0000;
        color: white;
        padding: 28px 32px;
        border-radius: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        overflow: hidden;
        margin-bottom: 28px;
    }

        .header::before {
            content: '';
            position: absolute;
            right: -40px;
            top: -50px;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }

        .header::after {
            content: '';
            position: absolute;
            right: 120px;
            bottom: -60px;
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }

    .header-left h2 {
        font-size: 22px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 4px;
    }

    .header-left p {
        font-size: 13px;
        color: #ffb3b3;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 16px;
        z-index: 1;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.3);
        color: #fff;
        padding: 9px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s;
    }

        .back-btn:hover {
            background: rgba(255,255,255,0.25);
        }

    /* STATS */
    .section-title {
        margin-top: 28px;
        margin-bottom: 14px;
        font-size: 15px;
        font-weight: 700;
        color: #1a1a1a;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .section-title::before {
            content: '';
            display: block;
            width: 4px;
            height: 16px;
            background: #8b0000;
            border-radius: 2px;
        }

    .stats-grid {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 8px;
    }

    .stat-card {
        flex: 1;
        min-width: 140px;
        background: white;
        border: 1px solid #f0e0e0;
        border-top: 4px solid #8b0000;
        border-radius: 10px;
        padding: 18px 20px;
        text-align: center;
    }

        .stat-card .s-val {
            font-size: 26px;
            font-weight: 800;
            color: #8b0000;
        }

        .stat-card .s-lbl {
            font-size: 12px;
            color: #888;
            margin-top: 4px;
        }

    /* REPORT CARD */
    .report-card {
        background: white;
        border: 1px solid #f0e0e0;
        border-radius: 10px;
        margin-bottom: 32px;
        overflow: hidden;
    }

    .report-card-header {
        background: #8b0000;
        color: white;
        padding: 14px 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .report-card-header h3 {
            font-size: 14px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }

    .download-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.35);
        color: white;
        padding: 7px 16px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }

        .download-btn:hover {
            background: rgba(255,255,255,0.28);
        }

    /* FILTER BAR */
    .table-filter-bar {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        padding: 14px 22px;
        border-bottom: 1px solid #f5eded;
        background: #fffafa;
    }

        .table-filter-bar input[type="text"],
        .table-filter-bar input[type="date"],
        .table-filter-bar select {
            padding: 7px 11px;
            border: 1px solid #ddd;
            border-radius: 7px;
            font-size: 12px;
            color: #333;
            background: #fafafa;
            outline: none;
            font-family: inherit;
        }

        .table-filter-bar input[type="text"] {
            min-width: 180px;
            flex: 1;
        }

        .table-filter-bar input:focus,
        .table-filter-bar select:focus {
            border-color: #8b0000;
        }

        .table-filter-bar label {
            font-size: 12px;
            font-weight: 600;
            color: #666;
            white-space: nowrap;
        }

    .btn-search {
        background: #8b0000;
        color: white;
        padding: 7px 16px;
        border-radius: 7px;
        border: none;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: inherit;
        transition: background 0.2s;
    }

        .btn-search:hover {
            background: #6e0000;
        }

    .btn-clear {
        background: white;
        color: #8b0000;
        padding: 7px 14px;
        border-radius: 7px;
        border: 1px solid #f0e0e0;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: inherit;
        transition: all 0.2s;
    }

        .btn-clear:hover {
            border-color: #8b0000;
            background: #fff0f0;
        }

    /* TABLE */
    .report-table-wrap {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    thead th {
        background: #fff5f5;
        color: #8b0000;
        padding: 11px 16px;
        font-weight: 700;
        text-align: left;
        border-bottom: 2px solid #f0e0e0;
        white-space: nowrap;
    }

    tbody td {
        padding: 11px 16px;
        border-bottom: 1px solid #f5eded;
        color: #333;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    tbody tr:hover td {
        background: #fff8f8;
    }

    .badge {
        display: inline-block;
        padding: 3px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .badge-green {
        background: #e6f9ef;
        color: #1a8a4a;
    }

    .badge-red {
        background: #fff0f0;
        color: #8b0000;
    }

    .badge-yellow {
        background: #fff8e1;
        color: #b8860b;
    }

    .badge-blue {
        background: #e8f4fd;
        color: #1565c0;
    }

    .badge-gray {
        background: #f0f0f0;
        color: #555;
    }

    .summary-row td {
        background: #fff5f5 !important;
        font-weight: 700;
        color: #8b0000 !important;
        border-top: 2px solid #f0e0e0;
    }

    /* EMPTY STATE */
    .empty-state {
        text-align: center;
        padding: 40px 20px;
        color: #aaa;
    }

        .empty-state i {
            font-size: 36px;
            margin-bottom: 10px;
            display: block;
            color: #f0e0e0;
        }

        .empty-state p {
            font-size: 13px;
        }

    /* PAGINATION */
    .pagination-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 22px;
        border-top: 1px solid #f5eded;
        font-size: 13px;
        color: #888;
        flex-wrap: wrap;
        gap: 8px;
    }

    .page-info {
        font-size: 12px;
        color: #888;
    }

    .page-btns {
        display: flex;
        gap: 4px;
        align-items: center;
    }

    .page-btn {
        min-width: 32px;
        height: 32px;
        padding: 0 8px;
        border-radius: 6px;
        border: 1px solid #f0e0e0;
        background: white;
        font-size: 12px;
        font-weight: 600;
        color: #555;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s;
        font-family: inherit;
    }

        .page-btn:hover {
            border-color: #8b0000;
            color: #8b0000;
        }

        .page-btn.active {
            background: #8b0000;
            color: white;
            border-color: #8b0000;
        }

        .page-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

    /* DOWNLOAD ALL */
    .download-all-wrap {
        text-align: center;
        margin: 30px 0 50px;
    }

    .btn-download-all {
        background: #8b0000;
        color: white;
        border: none;
        padding: 14px 36px;
        border-radius: 9px;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: background 0.2s;
        font-family: inherit;
    }

        .btn-download-all:hover {
            background: #6e0000;
        }

    @@media print {
        .download-btn, .table-filter-bar, .back-btn,
        .pagination-bar, .download-all-wrap {
            display: none !important;
        }
    }
</style>

<div class="reports-wrapper">

    <!-- HEADER -->
    <div class="header">
        <div class="header-left">
            <h2><i class="fa-solid fa-chart-bar" style="margin-right:10px"></i>Generate Reports</h2>
            <p>View and download all system reports as PDF</p>
        </div>
        <div class="header-right">
            <a asp-controller="Home" asp-action="Admin" class="back-btn">
                <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <!-- QUICK STATS -->
    <div class="section-title">Overview</div>
    <div class="stats-grid">
        <div class="stat-card">
            <div class="s-val">@ViewBag.TotalDonors</div>
            <div class="s-lbl">Total Donors</div>
        </div>
        <div class="stat-card">
            <div class="s-val">@ViewBag.PendingRequests</div>
            <div class="s-lbl">Pending Requests</div>
        </div>
        <div class="stat-card">
            <div class="s-val">@ViewBag.TotalBloodUnits</div>
            <div class="s-lbl">Blood Units in Stock</div>
        </div>
        <div class="stat-card">
            <div class="s-val">@ViewBag.ActiveStaff</div>
            <div class="s-lbl">Active Staff</div>
        </div>
        <div class="stat-card">
            <div class="s-val">@ViewBag.TotalHospitals</div>
            <div class="s-lbl">Partner Hospitals</div>
        </div>
    </div>

    @* ─────────────────────────────────────────────────────────
       1. DONORS
    ───────────────────────────────────────────────────────── *@
    <div class="section-title">Donors Report</div>
    <div class="report-card" id="section-donors">
        <div class="report-card-header">
            <h3><i class="fa-solid fa-users"></i> Registered Donors</h3>
            <button class="download-btn" onclick="downloadDonorsPDF()">
                <i class="fa-solid fa-file-pdf"></i> Download PDF
            </button>
        </div>
        <div class="table-filter-bar">
            <i class="fa-solid fa-filter" style="color:#8b0000;font-size:13px"></i>
            <input type="text" id="donors-search" placeholder="Search name, blood group, contact…">
            <label>Blood Group:</label>
            <select id="donors-blood">
                <option value="">All Groups</option>
                <option>A+</option>
                <option>A-</option>
                <option>B+</option>
                <option>B-</option>
                <option>O+</option>
                <option>O-</option>
                <option>AB+</option>
                <option>AB-</option>
            </select>
            <label>Eligibility:</label>
            <select id="donors-eligibility">
                <option value="">All</option>
                <option>Eligible</option>
                <option>Deferred</option>
            </select>
            <button class="btn-search" onclick="filterTable('donors')">
                <i class="fa-solid fa-magnifying-glass"></i> Search
            </button>
            <button class="btn-clear" onclick="clearFilter('donors')">
                <i class="fa-solid fa-xmark"></i> Clear
            </button>
        </div>
        <div class="report-table-wrap">
            <table id="tbl-donors">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Donor Name</th>
                        <th>Blood Group</th>
                        <th>Gender</th>
                        <th>Age</th>
                        <th>Contact</th>
                        <th>Last Donation</th>
                        <th>Total Donations</th>
                        <th>Eligibility</th>
                    </tr>
                </thead>
                <tbody id="tbody-donors">
                    @{
                        int donorSerial = 1;
                        var donorList = ViewBag.DonorList as List<BBMS.Models.DonateBlood>;
                    }
                    @if (donorList != null && donorList.Any())
                    {
                        foreach (var d in donorList)
                        {
                            <tr>
                                <td>@(donorSerial++)</td>
                                <td>
                                    <div>@d.FullName</div>
                                    <div style="font-size:11px;color:#8b0000">@d.DonorId</div>
                                </td>
                                <td>@d.BloodGroup</td>
                                <td>@d.Gender</td>
                                <td>@d.Age</td>
                                <td>@d.ContactNumber</td>
                                <td>@(d.LastDonationDate.HasValue? d.LastDonationDate.Value.ToString("dd MMM yyyy") : "—")</td>
                                <td style="text-align:center">@d.TotalDonations</td>
                                <td>
                                    <span class="badge @(d.Eligibility == "Eligible" ? "badge-green" : "badge-yellow")">
                                        @d.Eligibility
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9">
                                <div class="empty-state">
                                    <i class="fa-solid fa-users-slash"></i>
                                    <p>No donors found.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="pagination-bar" id="pag-donors">
            <span class="page-info" id="info-donors"></span>
            <div class="page-btns" id="btns-donors"></div>
        </div>
    </div>

    @* ─────────────────────────────────────────────────────────
       2. BLOOD STOCK
    ───────────────────────────────────────────────────────── *@
    <div class="section-title">Blood Stock Report</div>
    <div class="report-card" id="section-stock">
        <div class="report-card-header">
            <h3><i class="fa-solid fa-syringe"></i> Blood Inventory Summary</h3>
            <button class="download-btn" onclick="downloadPDF('section-stock','Blood_Stock_Report')">
                <i class="fa-solid fa-file-pdf"></i> Download PDF
            </button>
        </div>
        <div class="table-filter-bar">
            <i class="fa-solid fa-filter" style="color:#8b0000;font-size:13px"></i>
            <input type="text" id="stock-search" placeholder="Search blood group, stock level…">
            <label>Stock Level:</label>
            <select id="stock-level">
                <option value="">All Levels</option>
                <option value="sufficient">Sufficient</option>
                <option value="low">Low</option>
                <option value="critical">Critical</option>
            </select>
            <button class="btn-search" onclick="filterTable('stock')">
                <i class="fa-solid fa-magnifying-glass"></i> Search
            </button>
            <button class="btn-clear" onclick="clearFilter('stock')">
                <i class="fa-solid fa-xmark"></i> Clear
            </button>
        </div>
        <div class="report-table-wrap">
            <table id="tbl-stock">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Blood Group</th>
                        <th>Available Units</th>
                        <th>Last Updated</th>
                        <th>Stock Level</th>
                    </tr>
                </thead>
                <tbody id="tbody-stock">
                    @{
                        int stockSerial = 1;
                        var stockList = ViewBag.BloodStockList as List<BBMS.Models.BloodStock>;
                    }
                    @if (stockList != null && stockList.Any())
                    {
                        foreach (var s in stockList)
                        {
                            string badgeClass = s.Status?.ToLower() switch
                            {
                                "sufficient" => "badge-green",
                                "low" => "badge-yellow",
                                "critical" => "badge-red",
                                _ => "badge-gray"
                            };
                            string badgeLabel = s.Status?.ToLower() switch
                            {
                                "sufficient" => "Sufficient",
                                "low" => "Low",
                                "critical" => "Critical",
                                _ => s.Status ?? "Unknown"
                            };
                            <tr>
                                <td>@(stockSerial++)</td>
                                <td><strong>@s.BloodGroup</strong></td>
                                <td>@s.Units</td>
                                <td>@s.LastUpdated.ToString("dd MMM yyyy")</td>
                                <td><span class="badge @badgeClass">@badgeLabel</span></td>
                            </tr>
                        }
                        <tr class="summary-row">
                            <td colspan="2" style="text-align:right">Total Units:</td>
                            <td><strong>@stockList.Sum(s => s.Units)</strong></td>
                            <td colspan="2"></td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state">
                                    <i class="fa-solid fa-syringe"></i>
                                    <p>No blood stock data found.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="pagination-bar" id="pag-stock">
            <span class="page-info" id="info-stock"></span>
            <div class="page-btns" id="btns-stock"></div>
        </div>
    </div>

    @* ─────────────────────────────────────────────────────────
       3. BLOOD REQUESTS  ← now reading from DB
    ───────────────────────────────────────────────────────── *@
    <div class="section-title">Blood Requests Report</div>
    <div class="report-card" id="section-requests">
        <div class="report-card-header">
            <h3><i class="fa-solid fa-file-medical"></i> Blood Request Log</h3>
            <button class="download-btn" onclick="downloadPDF('section-requests','Blood_Requests_Report')">
                <i class="fa-solid fa-file-pdf"></i> Download PDF
            </button>
        </div>
        <div class="table-filter-bar">
            <i class="fa-solid fa-filter" style="color:#8b0000;font-size:13px"></i>
            <input type="text" id="requests-search" placeholder="Search requester, hospital, invoice…">
            <label>Blood Group:</label>
            <select id="requests-blood">
                <option value="">All Groups</option>
                <option>A+</option>
                <option>A-</option>
                <option>B+</option>
                <option>B-</option>
                <option>O+</option>
                <option>O-</option>
                <option>AB+</option>
                <option>AB-</option>
            </select>
            <label>Status:</label>
            <select id="requests-status">
                <option value="">All Status</option>
                <option>Approved</option>
                <option>Pending</option>
                <option>Rejected</option>
            </select>
            <label>From:</label><input type="date" id="requests-from">
            <label>To:</label><input type="date" id="requests-to">
            <button class="btn-search" onclick="filterTable('requests')">
                <i class="fa-solid fa-magnifying-glass"></i> Search
            </button>
            <button class="btn-clear" onclick="clearFilter('requests')">
                <i class="fa-solid fa-xmark"></i> Clear
            </button>
        </div>
        <div class="report-table-wrap">
            <table id="tbl-requests">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Invoice No.</th>
                        <th>Requester Name</th>
                        <th>Blood Group</th>
                        <th>Units Needed</th>
                        <th>Hospital</th>
                        <th>Request Date</th>
                        <th>Required By</th>
                        <th>Total Cost (৳)</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="tbody-requests">
                    @{
                        int reqSerial = 1;
                        var requestList = ViewBag.BloodRequestList as List<YourApp.Models.BloodRequest>;
                    }
                    @if (requestList != null && requestList.Any())
                    {
                        foreach (var r in requestList)
                        {
                            string reqBadge = r.Status switch
                            {
                                "Approved" => "badge-green",
                                "Rejected" => "badge-red",
                                "Pending" => "badge-yellow",
                                _ => "badge-gray"
                            };
                            <tr data-date="@r.RequestDate.ToString("yyyy-MM-dd")">
                                <td>@(reqSerial++)</td>
                                <td style="font-size:11px;color:#8b0000;font-weight:700">
                                    @r.InvoiceNumber
                                </td>
                                <td>@r.RequesterName</td>
                                <td><strong>@r.BloodGroup</strong></td>
                                <td style="text-align:center">@r.UnitsRequired</td>
                                <td>@(r.Hospital ?? "—")</td>
                                <td>@r.RequestDate.ToString("dd MMM yyyy")</td>
                                <td>@r.RequiredDate.ToString("dd MMM yyyy")</td>
                                <td>৳ @r.TotalCost.ToString("N0")</td>
                                <td><span class="badge @reqBadge">@r.Status</span></td>
                            </tr>
                        }
                        <!-- Summary row -->
                        <tr class="summary-row">
                            <td colspan="4" style="text-align:right">Total Requests:</td>
                            <td style="text-align:center"><strong>@requestList.Count</strong></td>
                            <td colspan="3" style="text-align:right">Total Revenue:</td>
                            <td><strong>৳ @requestList.Sum(r => r.TotalCost).ToString("N0")</strong></td>
                            <td></td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="10">
                                <div class="empty-state">
                                    <i class="fa-solid fa-file-medical"></i>
                                    <p>No blood requests found.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="pagination-bar" id="pag-requests">
            <span class="page-info" id="info-requests"></span>
            <div class="page-btns" id="btns-requests"></div>
        </div>
    </div>

    

</div>

<script>
    // ════════════════════════════════════════════════════
    // PAGINATION + FILTER ENGINE
    // ════════════════════════════════════════════════════
    const PAGE_SIZE  = 10;
    const tableState = {};
    const tables     = ['donors','stock','requests'];

    function initTable(name) {
        const tbody = document.getElementById('tbody-' + name);
        const rows  = [...tbody.querySelectorAll('tr:not(.summary-row)')].filter(r => {
            // Skip the empty-state colspan rows from pagination
            return r.querySelector('td[colspan]') === null || r.querySelector('.empty-state') === null;
        });
        // Actually: include all real data rows (no empty-state cell), exclude summary
        const dataRows = [...tbody.querySelectorAll('tr:not(.summary-row)')].filter(r =>
            !r.querySelector('.empty-state')
        );
        tableState[name] = { allRows: dataRows, filteredRows: dataRows, currentPage: 1 };
        renderPage(name);
    }

    function renderPage(name) {
        const state      = tableState[name];
        const { filteredRows, currentPage } = state;
        const total      = filteredRows.length;
        const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
        const page       = Math.min(currentPage, totalPages);
        state.currentPage = page;

        const start = (page - 1) * PAGE_SIZE;
        const end   = start + PAGE_SIZE;

        // Hide all data rows, show only current page slice
        state.allRows.forEach(r => r.style.display = 'none');
        filteredRows.forEach((r, i) => {
            r.style.display = (i >= start && i < end) ? '' : 'none';
        });

        // Always show summary rows
        const tbody = document.getElementById('tbody-' + name);
        tbody.querySelectorAll('.summary-row').forEach(r => r.style.display = '');

        // Info text
        const infoEl = document.getElementById('info-' + name);
        if (total === 0) {
            infoEl.textContent = 'No records found';
        } else {
            const s = Math.min(start + 1, total);
            const e = Math.min(end, total);
            infoEl.textContent = `Showing ${s}–${e} of ${total} records`;
        }

        // Page buttons
        const btnsEl = document.getElementById('btns-' + name);
        btnsEl.innerHTML = '';

        btnsEl.appendChild(makeBtn('‹', page <= 1, () => { state.currentPage = page - 1; renderPage(name); }));

        for (let p = 1; p <= totalPages; p++) {
            if (p === 1 || p === totalPages || (p >= page - 2 && p <= page + 2)) {
                const btn = makeBtn(p, false, () => { state.currentPage = p; renderPage(name); });
                if (p === page) btn.classList.add('active');
                btnsEl.appendChild(btn);
            } else if (p === page - 3 || p === page + 3) {
                const dots = document.createElement('span');
                dots.textContent = '…';
                dots.style.cssText = 'padding:0 4px;color:#aaa;font-size:13px;line-height:32px';
                btnsEl.appendChild(dots);
            }
        }

        btnsEl.appendChild(makeBtn('›', page >= totalPages, () => { state.currentPage = page + 1; renderPage(name); }));
    }

    function makeBtn(label, disabled, onClick) {
        const btn = document.createElement('button');
        btn.className   = 'page-btn';
        btn.textContent = label;
        btn.disabled    = disabled;
        if (!disabled) btn.addEventListener('click', onClick);
        return btn;
    }

    // ── FILTER ────────────────────────────────────────────
    function filterTable(name) {
        const state  = tableState[name];
        const search = (document.getElementById(name + '-search')?.value || '').toLowerCase().trim();

        // Date range filter (requests only)
        const fromEl = document.getElementById(name + '-from');
        const toEl   = document.getElementById(name + '-to');
        const fromDate = fromEl?.value ? new Date(fromEl.value) : null;
        const toDate   = toEl?.value   ? new Date(toEl.value)   : null;

        const extraIds = {
            donors:    ['donors-blood',    'donors-eligibility'],
            stock:     ['stock-level'],
            requests:  ['requests-blood',  'requests-status'],
            staff:     ['staff-status'],
            hospitals: ['hospitals-status'],
        };
        const extras = (extraIds[name] || []).map(id => {
            const el = document.getElementById(id);
            return el ? el.value.toLowerCase() : '';
        });

        state.filteredRows = state.allRows.filter(row => {
            const text = row.textContent.toLowerCase();
            const matchSearch = !search || text.includes(search);
            const matchExtras = extras.every(v => !v || text.includes(v));

            // Date range (only for requests table)
            let matchDate = true;
            if (name === 'requests' && (fromDate || toDate)) {
                const rowDateStr = row.dataset.date;
                if (rowDateStr) {
                    const rowDate = new Date(rowDateStr);
                    if (fromDate && rowDate < fromDate) matchDate = false;
                    if (toDate   && rowDate > toDate)   matchDate = false;
                }
            }

            return matchSearch && matchExtras && matchDate;
        });

        state.currentPage = 1;
        renderPage(name);
    }

    function clearFilter(name) {
        const sections = {
            donors: 'section-donors', stock: 'section-stock',
            requests: 'section-requests', staff: 'section-staff',
            hospitals: 'section-hospitals',
        };
        const sec = document.getElementById(sections[name]);
        if (sec) {
            sec.querySelectorAll('.table-filter-bar input, .table-filter-bar select').forEach(el => {
                if (el.tagName === 'SELECT') el.selectedIndex = 0;
                else el.value = '';
            });
        }
        tableState[name].filteredRows = tableState[name].allRows;
        tableState[name].currentPage  = 1;
        renderPage(name);
    }

    // Enter key triggers search
    document.addEventListener('keydown', function(e) {
        if (e.key !== 'Enter') return;
        tables.forEach(name => {
            const input = document.getElementById(name + '-search');
            if (document.activeElement === input) filterTable(name);
        });
    });

    document.addEventListener('DOMContentLoaded', () => { tables.forEach(initTable); });

    // ════════════════════════════════════════════════════
    // PDF ENGINE  — reads from tableState (ignores pagination)
    // ════════════════════════════════════════════════════
    const { jsPDF } = window.jspdf;
    const DARK_RED  = [139, 0, 0];
    const LIGHT_RED = [255, 240, 240];
    const HEADER_BG = [255, 245, 245];
    const TEXT_DARK = [30,  30,  30];
    const TEXT_GRAY = [120, 120, 120];
    const WHITE     = [255, 255, 255];

    // Map section IDs → tableState keys
    const sectionTableMap = {
        'section-donors':    'donors',
        'section-stock':     'stock',
        'section-requests':  'requests',
       
    };

    function statusColor(text) {
        const t = text.toLowerCase();
        if (['active','approved','normal','eligible','sufficient'].includes(t)) return [26, 138, 74];
        if (['pending','inactive','low','on leave','deferred','pending approval'].includes(t)) return [184, 134, 11];
        if (['rejected','critical'].includes(t)) return [139, 0, 0];
        return [80, 80, 80];
    }

    // ── Read ALL rows directly from tableState (no DOM visibility tricks) ──
    function buildDocContent(sectionId) {
        const section   = document.getElementById(sectionId);
        const title     = section.querySelector('.report-card-header h3').innerText.trim();
        const table     = section.querySelector('table');
        const headers   = [...table.querySelectorAll('thead th')].map(th => th.innerText.trim());
        const rows      = [];
        const isSummary = [];

        const tableKey = sectionTableMap[sectionId];

        if (tableKey && tableState[tableKey]) {
            // Read from allRows (all data, regardless of current page)
            tableState[tableKey].allRows.forEach(tr => {
                const cells = [...tr.querySelectorAll('td')].map(td => td.innerText.trim());
                rows.push(cells);
                isSummary.push(false);
            });
        }

        // Also grab any summary rows directly from the DOM (always visible)
        table.querySelectorAll('tbody tr.summary-row').forEach(tr => {
            rows.push([...tr.querySelectorAll('td')].map(td => td.innerText.trim()));
            isSummary.push(true);
        });

        return { title, headers, rows, isSummary };
    }

    function addPageDecor(doc, reportTitle) {
        const pageW  = doc.internal.pageSize.getWidth();
        const pageH  = doc.internal.pageSize.getHeight();
        const margin = 14;
        // Header bar
        doc.setFillColor(...DARK_RED);
        doc.rect(0, 0, pageW, 20, 'F');
        doc.setFont('helvetica', 'bold'); doc.setFontSize(11); doc.setTextColor(...WHITE);
        doc.text('Blood Bank Management System', margin, 13);
        doc.setFont('helvetica', 'normal'); doc.setFontSize(8);
        doc.text(reportTitle, pageW - margin, 13, { align: 'right' });
        // Footer bar
        doc.setFillColor(245, 237, 237);
        doc.rect(0, pageH - 12, pageW, 12, 'F');
        doc.setFontSize(7); doc.setTextColor(...TEXT_GRAY);
        doc.text(`Generated: ${new Date().toLocaleString()}`, margin, pageH - 4);
        doc.text(`Page ${doc.internal.getCurrentPageInfo().pageNumber}`, pageW - margin, pageH - 4, { align: 'right' });
    }

    function drawSection(doc, { title, headers, rows, isSummary }, startY) {
        const pageW  = doc.internal.pageSize.getWidth();
        const margin = 14;
        const usable = pageW - margin * 2;

        // Section title bar
        doc.setFillColor(...DARK_RED);
        doc.roundedRect(margin, startY, usable, 10, 2, 2, 'F');
        doc.setFont('helvetica', 'bold'); doc.setFontSize(9); doc.setTextColor(...WHITE);
        doc.text(title, margin + 5, startY + 6.5);

        doc.autoTable({
            startY: startY + 12,
            head: [headers],
            body: rows,
            margin: { left: margin, right: margin },
            tableWidth: usable,
            styles: { fontSize: 7.5, cellPadding: 3, overflow: 'linebreak', textColor: TEXT_DARK },
            headStyles: {
                fillColor: HEADER_BG, textColor: DARK_RED,
                fontStyle: 'bold', lineWidth: 0.1, lineColor: [240, 224, 224]
            },
            bodyStyles: { lineWidth: 0.1, lineColor: [245, 237, 237] },
            alternateRowStyles: { fillColor: [255, 252, 252] },
            didParseCell: function (data) {
                if (data.section === 'body' && isSummary[data.row.index]) {
                    data.cell.styles.fillColor = LIGHT_RED;
                    data.cell.styles.fontStyle = 'bold';
                    data.cell.styles.textColor = DARK_RED;
                }
            },
            willDrawCell: function (data) {
                if (data.section === 'body') {
                    const text = (data.cell.raw || '').toString().trim();
                    const keywords = ['Active','Eligible','Approved','Normal','Sufficient',
                        'Inactive','Deferred','Pending','Low','On Leave',
                        'Rejected','Critical','Pending Approval'];
                    if (keywords.includes(text)) {
                        const [r, g, b] = statusColor(text);
                        doc.setTextColor(r, g, b);
                    }
                }
            },
            didDrawCell: function () { doc.setTextColor(...TEXT_DARK); },
            didDrawPage:  function () { addPageDecor(doc, title); }
        });

        return doc.lastAutoTable.finalY + 10;
    }

    // ── Generic single-section PDF (same style as donors) ────────────────
    function downloadPDF(sectionId, filename) {
        const doc     = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });
        const pageW   = doc.internal.pageSize.getWidth();
        const pageH   = doc.internal.pageSize.getHeight();
        const margin  = 14;
        const content = buildDocContent(sectionId);

        // Full-width header banner (same style as donors PDF)
        doc.setFillColor(...DARK_RED);
        doc.rect(0, 0, pageW, 28, 'F');
        doc.setFont('helvetica', 'bold'); doc.setFontSize(14); doc.setTextColor(...WHITE);
        doc.text('Blood Bank Management System', margin, 12);
        doc.setFont('helvetica', 'normal'); doc.setFontSize(9);
        doc.text(content.title, margin, 20);
        doc.setFontSize(8);
        doc.text(`Generated: ${new Date().toLocaleString()}`, pageW - margin, 20, { align: 'right' });

        // Summary stat boxes
        const tableKey  = sectionTableMap[sectionId];
        const totalRows = tableState[tableKey]?.allRows.length ?? 0;
        const boxY      = 34;
        const boxes     = getSummaryBoxes(sectionId, totalRows);

        boxes.forEach((b, i) => {
            const bx = margin + i * 63;
            doc.setFillColor(250, 245, 245);
            doc.roundedRect(bx, boxY, 55, 18, 2, 2, 'F');
            doc.setDrawColor(...b.color); doc.setLineWidth(0.5);
            doc.roundedRect(bx, boxY, 55, 18, 2, 2, 'S');
            doc.setFont('helvetica', 'bold'); doc.setFontSize(14); doc.setTextColor(...b.color);
            doc.text(String(b.value), bx + 27.5, boxY + 10, { align: 'center' });
            doc.setFont('helvetica', 'normal'); doc.setFontSize(7); doc.setTextColor(100, 100, 100);
            doc.text(b.label, bx + 27.5, boxY + 15, { align: 'center' });
        });

        doc.autoTable({
            startY: boxY + (boxes.length ? 24 : 8),
            head: [content.headers],
            body: content.rows,
            margin: { left: margin, right: margin },
            styles: { fontSize: 7.5, cellPadding: 3, overflow: 'linebreak', textColor: TEXT_DARK },
            headStyles: {
                fillColor: DARK_RED, textColor: WHITE,
                fontStyle: 'bold', fontSize: 8
            },
            alternateRowStyles: { fillColor: [255, 250, 250] },
            bodyStyles: { lineWidth: 0.1, lineColor: [240, 220, 220] },
            didParseCell: function (data) {
                if (data.section === 'body' && content.isSummary[data.row.index]) {
                    data.cell.styles.fillColor = LIGHT_RED;
                    data.cell.styles.fontStyle = 'bold';
                    data.cell.styles.textColor = DARK_RED;
                }
            },
            willDrawCell: function (data) {
                if (data.section === 'body') {
                    const text = (data.cell.raw || '').toString().trim();
                    const keywords = ['Active','Eligible','Approved','Normal','Sufficient',
                        'Inactive','Deferred','Pending','Low','On Leave',
                        'Rejected','Critical','Pending Approval'];
                    if (keywords.includes(text)) {
                        const [r, g, b] = statusColor(text);
                        doc.setTextColor(r, g, b);
                    }
                }
            },
            didDrawCell: function () { doc.setTextColor(...TEXT_DARK); },
            didDrawPage: function () {
                doc.setFillColor(245, 237, 237);
                doc.rect(0, pageH - 10, pageW, 10, 'F');
                doc.setFontSize(7); doc.setTextColor(...TEXT_GRAY);
                doc.text('Blood Bank Management System — Confidential', margin, pageH - 3);
                doc.text(`Page ${doc.internal.getCurrentPageInfo().pageNumber}`, pageW - margin, pageH - 3, { align: 'right' });
            }
        });

        doc.save(`${filename}_${new Date().toISOString().slice(0, 10)}.pdf`);
    }

    // Build summary stat boxes per section
    function getSummaryBoxes(sectionId, totalRows) {
        const rows = tableState[sectionTableMap[sectionId]]?.allRows ?? [];

        if (sectionId === 'section-stock') {
            const sufficient = rows.filter(r => r.innerText.toLowerCase().includes('sufficient')).length;
            const low        = rows.filter(r => r.innerText.toLowerCase().includes('low')).length;
            const critical   = rows.filter(r => r.innerText.toLowerCase().includes('critical')).length;
            return [
                { label: 'Total Groups',  value: totalRows,  color: DARK_RED        },
                { label: 'Sufficient',    value: sufficient, color: [26, 138, 74]   },
                { label: 'Low Stock',     value: low,        color: [184, 134, 11]  },
                { label: 'Critical',      value: critical,   color: [139, 0, 0]     },
            ];
        }
        if (sectionId === 'section-requests') {
            const approved = rows.filter(r => r.innerText.includes('Approved')).length;
            const pending  = rows.filter(r => r.innerText.includes('Pending')).length;
            const rejected = rows.filter(r => r.innerText.includes('Rejected')).length;
            return [
                { label: 'Total Requests', value: totalRows, color: DARK_RED        },
                { label: 'Approved',       value: approved,  color: [26, 138, 74]   },
                { label: 'Pending',        value: pending,   color: [184, 134, 11]  },
                { label: 'Rejected',       value: rejected,  color: [139, 0, 0]     },
            ];
        }
        if (sectionId === 'section-staff') {
            const active  = rows.filter(r => r.innerText.includes('Active')).length;
            const onLeave = rows.filter(r => r.innerText.includes('On Leave')).length;
            return [
                { label: 'Total Staff', value: totalRows, color: DARK_RED       },
                { label: 'Active',      value: active,    color: [26, 138, 74]  },
                { label: 'On Leave',    value: onLeave,   color: [184, 134, 11] },
            ];
        }
        if (sectionId === 'section-hospitals') {
            const active  = rows.filter(r => r.innerText.includes('Active')).length;
            const pending = rows.filter(r => r.innerText.includes('Pending')).length;
            return [
                { label: 'Total Hospitals', value: totalRows, color: DARK_RED       },
                { label: 'Active',          value: active,    color: [26, 138, 74]  },
                { label: 'Pending',         value: pending,   color: [184, 134, 11] },
            ];
        }
        return [{ label: 'Total Records', value: totalRows, color: DARK_RED }];
    }

