                    <tr><td><strong>A-</strong></td><td>4</td><td>1</td><td>3</td><td>1</td><td>2025-04-29</td><td><span class="badge badge-yellow">Low</span></td></tr>
                    <tr><td><strong>B+</strong></td><td>12</td><td>2</td><td>6</td><td>0</td><td>2025-04-30</td><td><span class="badge badge-green">Normal</span></td></tr>
                    <tr><td><strong>B-</strong></td><td>2</td><td>0</td><td>2</td><td>2</td><td>2025-04-28</td><td><span class="badge badge-red">Critical</span></td></tr>
                    <tr><td><strong>O+</strong></td><td>20</td><td>5</td><td>14</td><td>3</td><td>2025-04-30</td><td><span class="badge badge-green">Normal</span></td></tr>
                    <tr><td><strong>O-</strong></td><td>6</td><td>2</td><td>5</td><td>1</td><td>2025-04-30</td><td><span class="badge badge-yellow">Low</span></td></tr>
                    <tr><td><strong>AB+</strong></td><td>5</td><td>1</td><td>3</td><td>0</td><td>2025-04-29</td><td><span class="badge badge-yellow">Low</span></td></tr>
                    <tr><td><strong>AB-</strong></td><td>3</td><td>0</td><td>1</td><td>1</td><td>2025-04-27</td><td><span class="badge badge-yellow">Low</span></td></tr>
                    <tr class="summary-row">
