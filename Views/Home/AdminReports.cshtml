<script>
    // ══════════════════════════════════════════════════════
    // PAGINATION + FILTER ENGINE
    // ══════════════════════════════════════════════════════

    const PAGE_SIZE = 10;

    // State per table: { allRows, filteredRows, currentPage }
    const tableState = {};

    const tables = ['donors', 'stock', 'requests', 'staff', 'hospitals', 'history'];

    function initTable(name) {
        const tbody = document.getElementById('tbody-' + name);
        const rows  = [...tbody.querySelectorAll('tr:not(.summary-row)')];
        tableState[name] = { allRows: rows, filteredRows: rows, currentPage: 1 };
        renderPage(name);
    }

    function renderPage(name) {
        const state = tableState[name];
        const { filteredRows, currentPage } = state;
        const total     = filteredRows.length;
        const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
        const page       = Math.min(currentPage, totalPages);
        state.currentPage = page;

        const start = (page - 1) * PAGE_SIZE;
        const end   = start + PAGE_SIZE;

        // Show/hide rows
        state.allRows.forEach(r => r.style.display = 'none');
        filteredRows.forEach((r, i) => {
            r.style.display = (i >= start && i < end) ? '' : 'none';
        });

        // Info text
        const infoEl = document.getElementById('info-' + name);
        if (total === 0) {
            infoEl.textContent = 'No records found';
        } else {
            const s = Math.min(start + 1, total);
            const e = Math.min(end, total);
            infoEl.textContent = `Showing ${s}–${e} of ${total} records`;
        }

        // Pagination buttons
        const btnsEl = document.getElementById('btns-' + name);
        btnsEl.innerHTML = '';

        // Prev
        const prev = makeBtn('‹', page <= 1, () => { state.currentPage = page - 1; renderPage(name); });
        btnsEl.appendChild(prev);

        // Page numbers (show max 5 around current)
        const delta = 2;
        for (let p = 1; p <= totalPages; p++) {
            if (p === 1 || p === totalPages || (p >= page - delta && p <= page + delta)) {
                const btn = makeBtn(p, false, () => { state.currentPage = p; renderPage(name); });
                if (p === page) btn.classList.add('active');
                btnsEl.appendChild(btn);
            } else if (p === page - delta - 1 || p === page + delta + 1) {
                const dots = document.createElement('span');
                dots.textContent = '…';
                dots.style.cssText = 'padding: 0 4px; color:#aaa; font-size:13px; line-height:32px;';
                btnsEl.appendChild(dots);
            }
        }

        // Next
        const next = makeBtn('›', page >= totalPages, () => { state.currentPage = page + 1; renderPage(name); });
        btnsEl.appendChild(next);
    }

    function makeBtn(label, disabled, onClick) {
        const btn = document.createElement('button');
        btn.className   = 'page-btn';
        btn.textContent = label;
        btn.disabled    = disabled;
        if (!disabled) btn.addEventListener('click', onClick);
        return btn;
    }

    // ── FILTER ──────────────────────────────────────
    function filterTable(name) {
        const state  = tableState[name];
        const search = (document.getElementById(name + '-search')?.value || '').toLowerCase().trim();

        // Extra selects per table
        const extraIds = {
            donors:    ['donors-blood', 'donors-eligibility'],
            stock:     ['stock-level'],
            requests:  ['requests-blood', 'requests-status'],
            staff:     ['staff-status'],
            hospitals: ['hospitals-status'],
            history:   ['history-blood'],
        };
        const extras = (extraIds[name] || []).map(id => {
            const el = document.getElementById(id);
            return el ? el.value.toLowerCase() : '';
        });

        state.filteredRows = state.allRows.filter(row => {
            const text = row.textContent.toLowerCase();
            const matchSearch = !search || text.includes(search);
            const matchExtras = extras.every(v => !v || text.includes(v));
            return matchSearch && matchExtras;
        });

        state.currentPage = 1;
        renderPage(name);
    }

    function clearFilter(name) {
        const inputs  = document.querySelectorAll(`#pag-${name}`);
        // Clear all inputs in the filter bar above this table
        const card = document.getElementById('section-' + name) ||
                     document.getElementById('pag-' + name)?.closest('.report-card');

        // Find filter bar inside same report-card
        const sections = {
            donors:    'section-donors',
            stock:     'section-stock',
            requests:  'section-requests',
            staff:     'section-staff',
            hospitals: 'section-hospitals',
            history:   'section-history',
        };
        const sec = document.getElementById(sections[name]);
        if (sec) {
            sec.querySelectorAll('.table-filter-bar input, .table-filter-bar select').forEach(el => {
                if (el.tagName === 'SELECT') el.selectedIndex = 0;
                else el.value = '';
            });
        }

        tableState[name].filteredRows = tableState[name].allRows;
        tableState[name].currentPage  = 1;
        renderPage(name);
    }

    // Allow pressing Enter to search
    document.addEventListener('keydown', function(e) {
        if (e.key !== 'Enter') return;
        tables.forEach(name => {
            const input = document.getElementById(name + '-search');
            if (document.activeElement === input) filterTable(name);
        });
    });

    // ── INIT ALL TABLES ──────────────────────────────
    document.addEventListener('DOMContentLoaded', () => {
        tables.forEach(initTable);
    });

    // ══════════════════════════════════════════════════════
    // PDF ENGINE (unchanged from original)
    // ══════════════════════════════════════════════════════
    const { jsPDF } = window.jspdf;
    const DARK_RED  = [139, 0, 0];
    const LIGHT_RED = [255, 240, 240];
    const HEADER_BG = [255, 245, 245];
    const TEXT_DARK = [30,  30,  30];
    const TEXT_GRAY = [120, 120, 120];
    const WHITE     = [255, 255, 255];

    function statusColor(text) {
        const t = text.toLowerCase();
        if (['active','approved','normal','eligible'].includes(t))  return [26, 138, 74];
        if (['pending','inactive','low','on leave','deferred'].includes(t)) return [184, 134, 11];
        if (['rejected','critical'].includes(t))  return [139, 0, 0];
        if (['processing','urgent'].includes(t))  return [21, 101, 192];
        return [80, 80, 80];
    }

    function buildDocContent(sectionId) {
        const section = document.getElementById(sectionId);
        const title   = section.querySelector('.report-card-header h3').innerText.trim();
        const table   = section.querySelector('table');
        const headers = [...table.querySelectorAll('thead th')].map(th => th.innerText.trim());
        const rows    = [];
        const isSummary = [];
        table.querySelectorAll('tbody tr').forEach(tr => {
            rows.push([...tr.querySelectorAll('td')].map(td => td.innerText.trim()));
            isSummary.push(tr.classList.contains('summary-row'));
        });
        return { title, headers, rows, isSummary };
    }

    function drawSection(doc, { title, headers, rows, isSummary }, startY) {
        const pageW  = doc.internal.pageSize.getWidth();
        const margin = 14;
        const usable = pageW - margin * 2;
        doc.setFillColor(...DARK_RED);
        doc.roundedRect(margin, startY, usable, 10, 2, 2, 'F');
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(9);
        doc.setTextColor(...WHITE);
        doc.text(title, margin + 5, startY + 6.5);
        doc.autoTable({
            startY: startY + 12,
            head: [headers],
            body: rows,
            margin: { left: margin, right: margin },
            tableWidth: usable,
            styles: { fontSize: 7.5, cellPadding: 3, overflow: 'linebreak', textColor: TEXT_DARK },
            headStyles: { fillColor: HEADER_BG, textColor: DARK_RED, fontStyle: 'bold', lineWidth: 0.1, lineColor: [240, 224, 224] },
            bodyStyles: { lineWidth: 0.1, lineColor: [245, 237, 237] },
            alternateRowStyles: { fillColor: [255, 252, 252] },
            didParseCell: function(data) {
                if (data.section === 'body' && isSummary[data.row.index]) {
                    data.cell.styles.fillColor  = LIGHT_RED;
                    data.cell.styles.fontStyle  = 'bold';
                    data.cell.styles.textColor  = DARK_RED;
                }
            },
            willDrawCell: function(data) {
                if (data.section === 'body') {
                    const text = data.cell.raw ? data.cell.raw.toString().trim() : '';
                    const keywords = ['Active','Eligible','Approved','Normal','Inactive','Deferred',
                                      'Pending','Low','On Leave','Rejected','Critical','Processing','Urgent','Pending Approval'];
                    if (keywords.includes(text)) { const [r,g,b] = statusColor(text); doc.setTextColor(r,g,b); }
                }
            },
            didDrawCell: function() { doc.setTextColor(...TEXT_DARK); }
        });
        return doc.lastAutoTable.finalY + 10;
    }

    function addPageDecor(doc, reportTitle) {
        const pageW = doc.internal.pageSize.getWidth();
        const pageH = doc.internal.pageSize.getHeight();
        const margin = 14;
        doc.setFillColor(...DARK_RED);
        doc.rect(0, 0, pageW, 20, 'F');
        doc.setFont('helvetica', 'bold'); doc.setFontSize(11); doc.setTextColor(...WHITE);
        doc.text('Blood Bank Management System', margin, 13);
        doc.setFont('helvetica', 'normal'); doc.setFontSize(8);
        doc.text(reportTitle, pageW - margin, 13, { align: 'right' });
        doc.setFillColor(245, 237, 237);
        doc.rect(0, pageH - 12, pageW, 12, 'F');
        doc.setFontSize(7); doc.setTextColor(...TEXT_GRAY);
        doc.text(`Generated: ${new Date().toLocaleString()}`, margin, pageH - 4);
        doc.text(`Page ${doc.internal.getCurrentPageInfo().pageNumber}`, pageW - margin, pageH - 4, { align: 'right' });
    }

    function downloadPDF(sectionId, filename) {
        const doc     = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });
        const content = buildDocContent(sectionId);
        addPageDecor(doc, content.title);
        drawSection(doc, content, 26);
        const totalPages = doc.internal.getNumberOfPages();
        for (let p = 1; p <= totalPages; p++) { doc.setPage(p); addPageDecor(doc, content.title); }
        doc.save(`${filename}_${new Date().toISOString().slice(0,10)}.pdf`);
    }

    function downloadAllPDF() {
        const sections = [
            { id: 'section-donors',    name: 'Donors Report'          },
            { id: 'section-stock',     name: 'Blood Stock Report'      },
            { id: 'section-requests',  name: 'Blood Requests Report'   },
            { id: 'section-staff',     name: 'Staff Report'            },
            { id: 'section-hospitals', name: 'Hospital Report'         },
            { id: 'section-history',   name: 'Donation History Report' },
        ];
        const doc = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });
        let y = 26;
        sections.forEach((s, idx) => {
            if (idx > 0) { doc.addPage(); y = 26; }
            const content = buildDocContent(s.id);
            addPageDecor(doc, s.name);
            y = drawSection(doc, content, y);
        });
        const total = doc.internal.getNumberOfPages();
        for (let p = 1; p <= total; p++) {
            doc.setPage(p);
            const pageH = doc.internal.pageSize.getHeight();
            const pageW = doc.internal.pageSize.getWidth();
            doc.setFillColor(245, 237, 237);
            doc.rect(0, pageH - 12, pageW, 12, 'F');
            doc.setFontSize(7); doc.setTextColor(...TEXT_GRAY);
            doc.text(`Generated: ${new Date().toLocaleString()}`, 14, pageH - 4);
            doc.text(`Page ${p} of ${total}`, pageW - 14, pageH - 4, { align: 'right' });
        }
        doc.save(`Full_Blood_Bank_Report_${new Date().toISOString().slice(0,10)}.pdf`);
    }

    function downloadDonorsPDF() {
        const doc   = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });
        const pageW = doc.internal.pageSize.getWidth();
        const pageH = doc.internal.pageSize.getHeight();
        const margin = 14;
        doc.setFillColor(139, 0, 0);
        doc.rect(0, 0, pageW, 28, 'F');
        doc.setFont('helvetica', 'bold'); doc.setFontSize(14); doc.setTextColor(255,255,255);
        doc.text('Blood Bank Management System', margin, 12);
        doc.setFont('helvetica', 'normal'); doc.setFontSize(9);
        doc.text('Registered Donors Report', margin, 20);
        doc.setFontSize(8);
        doc.text(`Generated: ${new Date().toLocaleString()}`, pageW - margin, 20, { align: 'right' });
        const boxY = 34;
        const totalDonors   = document.querySelectorAll('#tbody-donors tr:not(.summary-row)').length;
        const eligibleCount = [...document.querySelectorAll('#tbody-donors tr:not(.summary-row)')].filter(r => r.innerText.includes('Eligible')).length;
        const deferredCount = totalDonors - eligibleCount;
        const summaryBoxes  = [
            { label: 'Total Donors', value: totalDonors,   color: [139, 0, 0]    },
            { label: 'Eligible',     value: eligibleCount, color: [26, 138, 74]  },
            { label: 'Deferred',     value: deferredCount, color: [184, 134, 11] },
        ];
        const boxW = 55;
        summaryBoxes.forEach((b, i) => {
            const bx = margin + i * (boxW + 8);
            doc.setFillColor(250, 245, 245);
            doc.roundedRect(bx, boxY, boxW, 18, 2, 2, 'F');
            doc.setDrawColor(...b.color); doc.setLineWidth(0.5);
            doc.roundedRect(bx, boxY, boxW, 18, 2, 2, 'S');
            doc.setFont('helvetica', 'bold'); doc.setFontSize(14); doc.setTextColor(...b.color);
            doc.text(String(b.value), bx + boxW / 2, boxY + 10, { align: 'center' });
            doc.setFont('helvetica', 'normal'); doc.setFontSize(7); doc.setTextColor(100,100,100);
            doc.text(b.label, bx + boxW / 2, boxY + 15, { align: 'center' });
        });
        const headers = ['#','Donor Name','Donor ID','Blood Group','Gender','Age','Contact','Last Donation','Total Donations','Eligibility'];
        const rows = [];
        document.querySelectorAll('#tbody-donors tr:not(.summary-row)').forEach((tr, idx) => {
            const tds = tr.querySelectorAll('td');
            rows.push([idx+1, tds[1].querySelector('div')?.innerText??tds[1].innerText,
                tds[1].querySelector('div:last-child')?.innerText??'',
                tds[2].innerText.trim(), tds[3].innerText.trim(), tds[4].innerText.trim(),
                tds[5].innerText.trim(), tds[6].innerText.trim(), tds[7].innerText.trim(), tds[8].innerText.trim()]);
        });
        doc.autoTable({
            startY: boxY + 24, head: [headers], body: rows,
            margin: { left: margin, right: margin },
            styles: { fontSize: 8, cellPadding: 3.5, textColor: [30,30,30] },
            headStyles: { fillColor: [139,0,0], textColor: [255,255,255], fontStyle: 'bold', fontSize: 8 },
            alternateRowStyles: { fillColor: [255,250,250] },
            bodyStyles: { lineWidth: 0.1, lineColor: [240,220,220] },
            didParseCell: function(data) {
                if (data.section === 'body' && data.column.index === 9) {
                    const val = data.cell.raw;
                    if (val === 'Eligible') data.cell.styles.textColor = [26,138,74];
                    if (val === 'Deferred') data.cell.styles.textColor = [184,134,11];
                    data.cell.styles.fontStyle = 'bold';
                }
            }
        });
        const totalPages = doc.internal.getNumberOfPages();
        for (let p = 1; p <= totalPages; p++) {
            doc.setPage(p);
            doc.setFillColor(245,237,237);
            doc.rect(0, pageH-10, pageW, 10, 'F');
            doc.setFontSize(7); doc.setTextColor(120,120,120);
            doc.text('Blood Bank Management System — Confidential', margin, pageH-3);
            doc.text(`Page ${p} of ${totalPages}`, pageW-margin, pageH-3, { align: 'right' });
        }
        doc.save(`Donors_Report_${new Date().toISOString().slice(0,10)}.pdf`);
    }
</script>
