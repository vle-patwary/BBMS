                    <tr><td>3</td><td>REQ-1003</td><td>Farhan Ahmed</td><td>B-</td><td>1</td><td>Square Hospital</td><td>2025-04-08</td><td>2025-04-09</td><td><span class="badge badge-red">Rejected</span></td></tr>
                    <tr><td>4</td><td>REQ-1004</td><td>Sumaiya Islam</td><td>AB+</td><td>2</td><td>Apollo Hospital</td><td>2025-04-10</td><td>2025-04-12</td><td><span class="badge badge-green">Approved</span></td></tr>
