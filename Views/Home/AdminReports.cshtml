@{
    ViewData["Title"] = "Generate Reports";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

<style>
    * {
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f4f6f9;
    }

    .reports-wrapper {
        width: 92%;
        margin: 32px auto;
    }

    .header {
        background: #8b0000;
        color: white;
        padding: 28px 32px;
        border-radius: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        overflow: hidden;
        margin-bottom: 28px;
    }

        .header::before {
            content: '';
            position: absolute;
            right: -40px;
            top: -50px;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }

        .header::after {
            content: '';
            position: absolute;
            right: 120px;
            bottom: -60px;
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }

    .header-left h2 {
        font-size: 22px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 4px;
    }

    .header-left p {
        font-size: 13px;
        color: #ffb3b3;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 16px;
        z-index: 1;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.3);
        color: #fff;
        padding: 9px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s;
    }

        .back-btn:hover {
            background: rgba(255,255,255,0.25);
        }

    .filter-bar {
        background: white;
        border: 1px solid #f0e0e0;
        border-radius: 10px;
        padding: 18px 24px;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 14px;
        margin-bottom: 24px;
    }

        .filter-bar label {
            font-size: 13px;
            font-weight: 600;
            color: #555;
        }

        .filter-bar input[type="date"],
        .filter-bar select {
            padding: 8px 12px;
            border: 1px solid #ddd;
            border-radius: 7px;
            font-size: 13px;
            color: #333;
            background: #fafafa;
            outline: none;
        }

            .filter-bar input[type="date"]:focus,
            .filter-bar select:focus {
                border-color: #8b0000;
            }

    .filter-sep {
        color: #ccc;
        font-size: 14px;
    }

    .section-title {
        margin-top: 28px;
        margin-bottom: 14px;
        font-size: 15px;
        font-weight: 700;
        color: #1a1a1a;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .section-title::before {
            content: '';
            display: block;
            width: 4px;
            height: 16px;
            background: #8b0000;
            border-radius: 2px;
        }

    .report-card {
        background: white;
        border: 1px solid #f0e0e0;
        border-radius: 10px;
        margin-bottom: 28px;
        overflow: hidden;
    }

    .report-card-header {
        background: #8b0000;
        color: white;
        padding: 14px 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .report-card-header h3 {
            font-size: 14px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .report-card-header h3 i {
                font-size: 16px;
            }

    .download-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.35);
        color: white;
        padding: 7px 16px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }

        .download-btn:hover {
            background: rgba(255,255,255,0.28);
        }

    .report-table-wrap {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    thead th {
        background: #fff5f5;
        color: #8b0000;
        padding: 11px 16px;
        font-weight: 700;
        text-align: left;
        border-bottom: 2px solid #f0e0e0;
        white-space: nowrap;
    }

    tbody td {
        padding: 11px 16px;
        border-bottom: 1px solid #f5eded;
        color: #333;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    tbody tr:hover td {
        background: #fff8f8;
    }

    .badge {
        display: inline-block;
        padding: 3px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .badge-green {
        background: #e6f9ef;
        color: #1a8a4a;
    }

    .badge-red {
        background: #fff0f0;
        color: #8b0000;
    }

    .badge-yellow {
        background: #fff8e1;
        color: #b8860b;
    }

    .badge-blue {
        background: #e8f4fd;
        color: #1565c0;
    }

    .badge-gray {
        background: #f0f0f0;
        color: #555;
    }

    .summary-row td {
        background: #fff5f5 !important;
        font-weight: 700;
        color: #8b0000 !important;
        border-top: 2px solid #f0e0e0;
    }

    .stats-grid {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 8px;
    }

    .stat-card {
        flex: 1;
        min-width: 140px;
        background: white;
        border: 1px solid #f0e0e0;
        border-top: 4px solid #8b0000;
        border-radius: 10px;
        padding: 18px 20px;
        text-align: center;
    }

        .stat-card .s-val {
            font-size: 26px;
            font-weight: 800;
            color: #8b0000;
        }

        .stat-card .s-lbl {
            font-size: 12px;
            color: #888;
            margin-top: 4px;
        }

    @@media print {
        .download-btn, .filter-bar, .back-btn {
            display: none !important;
        }
    }
</style>

<div class="reports-wrapper">

    <!-- HEADER -->
    <div class="header">
        <div class="header-left">
            <h2><i class="fa-solid fa-chart-bar" style="margin-right:10px"></i>Generate Reports</h2>
            <p>View and download all system reports as PDF</p>
        </div>
        <div class="header-right">
            <a asp-controller="Home" asp-action="Admin" class="back-btn">
                <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <!-- QUICK STATS -->
    <div class="section-title">Overview</div>
    <div class="stats-grid">
        <div class="stat-card"><div class="s-val">@ViewBag.TotalDonors</div><div class="s-lbl">Total Donors</div></div>
        <div class="stat-card"><div class="s-val">@ViewBag.PendingRequests</div><div class="s-lbl">Pending Requests</div></div>
        <div class="stat-card"><div class="s-val">80</div><div class="s-lbl">Blood Units in Stock</div></div>
        <div class="stat-card"><div class="s-val">@ViewBag.ActiveStaff</div><div class="s-lbl">Active Staff</div></div>
        <div class="stat-card"><div class="s-val">@ViewBag.TotalHospitals</div><div class="s-lbl">Partner Hospitals</div></div>
    </div>

    <!-- FILTER BAR -->
    <div class="filter-bar">
        <i class="fa-solid fa-filter" style="color:#8b0000"></i>
        <label>From:</label>
        <input type="date" id="filterFrom" value="2025-01-01">
        <span class="filter-sep">—</span>
        <label>To:</label>
        <input type="date" id="filterTo" value="2025-12-31">
        <label>Blood Group:</label>
        <select id="filterBlood">
            <option value="all">All Groups</option>
            <option>A+</option>
            <option>A-</option>
            <option>B+</option>
            <option>B-</option>
            <option>O+</option>
            <option>O-</option>
            <option>AB+</option>
            <option>AB-</option>
        </select>
    </div>

    <!-- ═══════════════════════════════════════════════
         1. DONORS REPORT  ← DYNAMIC
    ═══════════════════════════════════════════════ -->
    <div class="section-title">Donors Report</div>
    <div class="report-card" id="section-donors">
        <div class="report-card-header">
            <h3><i class="fa-solid fa-users"></i> Registered Donors</h3>
            <button class="download-btn" onclick="downloadDonorsPDF()">
                <i class="fa-solid fa-file-pdf"></i> Download PDF
            </button>
        </div>
        <div class="report-table-wrap">
            <table id="tbl-donors">
                <thead>
                    <tr>
                        <th>Serial</th>
                        <th>Donor Name</th>
                        <th>Blood Group</th>
                        <th>Gender</th>
                        <th>Age</th>
                        <th>Contact</th>
                        <th>Last Donation</th>
                        <th>Total Donations</th>
                        <th>Eligibility</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int donorSerial = 1;
                        var donorList = ViewBag.DonorList as List<BBMS.Models.DonateBlood>;
                    }
                    @if (donorList != null && donorList.Any())
                    {
                        foreach (var d in donorList)
                        {
                            <tr>
                                <td>@(donorSerial++)</td>
                                <td>
                                    <div>@d.FullName</div>
                                    <div style="font-size:11px; color:#8b0000;">@d.DonorId</div>
                                </td>
                                <td>@d.BloodGroup</td>
                                <td>@d.Gender</td>
                                <td>@d.Age</td>
                                <td>@d.ContactNumber</td>
                                <td>@(d.LastDonationDate.HasValue? d.LastDonationDate.Value.ToString("dd MMM yyyy") : "—")</td>
                                <td style="text-align:center;">@d.TotalDonations</td>
                                <td>
                                    <span class="badge @(d.Eligibility == "Eligible" ? "badge-green" : "badge-yellow")">
                                        @d.Eligibility
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="9" style="text-align:center; color:#aaa; padding:30px;">No donors found.</td></tr>
                    }
                    <tr class="summary-row">
                        <td colspan="7">Total Registered Donors</td>
                        <td colspan="2">@ViewBag.TotalDonors donors</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════
         2. BLOOD STOCK REPORT
    ═══════════════════════════════════════════════ -->
