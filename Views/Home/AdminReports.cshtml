@{
    ViewData["Title"] = "Generate Reports";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

<style>
    * {
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f4f6f9;
    }

    .reports-wrapper {
        width: 92%;
        margin: 32px auto;
    }

    /* HEADER */
    .header {
        background: #8b0000;
        color: white;
        padding: 28px 32px;
        border-radius: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        overflow: hidden;
        margin-bottom: 28px;
    }

        .header::before {
            content: '';
            position: absolute;
            right: -40px;
            top: -50px;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }

        .header::after {
            content: '';
            position: absolute;
            right: 120px;
            bottom: -60px;
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }

    .header-left h2 {
        font-size: 22px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 4px;
    }

    .header-left p {
        font-size: 13px;
        color: #ffb3b3;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 16px;
        z-index: 1;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.3);
        color: #fff;
        padding: 9px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s;
    }

        .back-btn:hover {
            background: rgba(255,255,255,0.25);
        }

    /* STATS */
    .section-title {
        margin-top: 28px;
        margin-bottom: 14px;
        font-size: 15px;
        font-weight: 700;
        color: #1a1a1a;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .section-title::before {
            content: '';
            display: block;
            width: 4px;
            height: 16px;
            background: #8b0000;
            border-radius: 2px;
        }

    .stats-grid {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 8px;
    }

    .stat-card {
        flex: 1;
        min-width: 140px;
        background: white;
        border: 1px solid #f0e0e0;
        border-top: 4px solid #8b0000;
        border-radius: 10px;
        padding: 18px 20px;
        text-align: center;
    }

        .stat-card .s-val {
            font-size: 26px;
            font-weight: 800;
            color: #8b0000;
        }

        .stat-card .s-lbl {
            font-size: 12px;
            color: #888;
            margin-top: 4px;
        }

    /* REPORT CARD */
    .report-card {
        background: white;
        border: 1px solid #f0e0e0;
        border-radius: 10px;
        margin-bottom: 32px;
        overflow: hidden;
    }

    .report-card-header {
        background: #8b0000;
        color: white;
        padding: 14px 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .report-card-header h3 {
            font-size: 14px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }

    .download-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.35);
        color: white;
        padding: 7px 16px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }

        .download-btn:hover {
            background: rgba(255,255,255,0.28);
        }

    /* PER-TABLE FILTER BAR */
    .table-filter-bar {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        padding: 14px 22px;
        border-bottom: 1px solid #f5eded;
        background: #fffafa;
    }

        .table-filter-bar input[type="text"],
        .table-filter-bar input[type="date"],
        .table-filter-bar select {
            padding: 7px 11px;
            border: 1px solid #ddd;
            border-radius: 7px;
            font-size: 12px;
            color: #333;
            background: #fafafa;
            outline: none;
            font-family: inherit;
        }

        .table-filter-bar input[type="text"] {
            min-width: 180px;
            flex: 1;
        }

        .table-filter-bar input:focus,
        .table-filter-bar select:focus {
            border-color: #8b0000;
        }

        .table-filter-bar label {
            font-size: 12px;
            font-weight: 600;
            color: #666;
            white-space: nowrap;
        }

    .btn-search {
        background: #8b0000;
        color: white;
        padding: 7px 16px;
        border-radius: 7px;
        border: none;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: inherit;
        transition: background 0.2s;
    }

        .btn-search:hover {
            background: #6e0000;
        }

    .btn-clear {
        background: white;
        color: #8b0000;
        padding: 7px 14px;
        border-radius: 7px;
        border: 1px solid #f0e0e0;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: inherit;
        transition: all 0.2s;
    }

        .btn-clear:hover {
            border-color: #8b0000;
            background: #fff0f0;
        }

    /* TABLE */
    .report-table-wrap {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    thead th {
        background: #fff5f5;
        color: #8b0000;
        padding: 11px 16px;
        font-weight: 700;
        text-align: left;
        border-bottom: 2px solid #f0e0e0;
        white-space: nowrap;
    }

    tbody td {
        padding: 11px 16px;
        border-bottom: 1px solid #f5eded;
        color: #333;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    tbody tr:hover td {
        background: #fff8f8;
    }

    .hidden-row {
        display: none;
    }

    .badge {
        display: inline-block;
        padding: 3px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .badge-green {
        background: #e6f9ef;
        color: #1a8a4a;
    }

    .badge-red {
        background: #fff0f0;
        color: #8b0000;
    }

    .badge-yellow {
        background: #fff8e1;
        color: #b8860b;
    }

    .badge-blue {
        background: #e8f4fd;
        color: #1565c0;
    }

    .badge-gray {
        background: #f0f0f0;
        color: #555;
    }

    .summary-row td {
        background: #fff5f5 !important;
        font-weight: 700;
        color: #8b0000 !important;
        border-top: 2px solid #f0e0e0;
    }

    /* PAGINATION */
    .pagination-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 22px;
        border-top: 1px solid #f5eded;
        font-size: 13px;
        color: #888;
        flex-wrap: wrap;
        gap: 8px;
    }

    .page-info {
        font-size: 12px;
        color: #888;
    }

    .page-btns {
        display: flex;
        gap: 4px;
        align-items: center;
    }

    .page-btn {
        min-width: 32px;
        height: 32px;
        padding: 0 8px;
        border-radius: 6px;
        border: 1px solid #f0e0e0;
        background: white;
        font-size: 12px;
        font-weight: 600;
        color: #555;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s;
        font-family: inherit;
    }

        .page-btn:hover {
            border-color: #8b0000;
            color: #8b0000;
        }

        .page-btn.active {
            background: #8b0000;
            color: white;
            border-color: #8b0000;
        }

        .page-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

    /* DOWNLOAD ALL */
    .download-all-wrap {
        text-align: center;
        margin: 30px 0 50px;
    }

    .btn-download-all {
        background: #8b0000;
        color: white;
        border: none;
        padding: 14px 36px;
        border-radius: 9px;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: background 0.2s;
        font-family: inherit;
    }

        .btn-download-all:hover {
            background: #6e0000;
        }

    @@media print {
        .download-btn, .table-filter-bar, .back-btn, .pagination-bar, .download-all-wrap {
            display: none !important;
        }
    }
</style>

<div class="reports-wrapper">

    <!-- HEADER -->
    <div class="header">
        <div class="header-left">
            <h2><i class="fa-solid fa-chart-bar" style="margin-right:10px"></i>Generate Reports</h2>
            <p>View and download all system reports as PDF</p>
        </div>
        <div class="header-right">
            <a asp-controller="Home" asp-action="Admin" class="back-btn">
                <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <!-- QUICK STATS -->
    <div class="section-title">Overview</div>
    <div class="stats-grid">
        <div class="stat-card"><div class="s-val">@ViewBag.TotalDonors</div><div class="s-lbl">Total Donors</div></div>
        <div class="stat-card"><div class="s-val">@ViewBag.PendingRequests</div><div class="s-lbl">Pending Requests</div></div>
        <div class="stat-card"><div class="s-val">80</div><div class="s-lbl">Blood Units in Stock</div></div>
        <div class="stat-card"><div class="s-val">@ViewBag.ActiveStaff</div><div class="s-lbl">Active Staff</div></div>
        <div class="stat-card"><div class="s-val">@ViewBag.TotalHospitals</div><div class="s-lbl">Partner Hospitals</div></div>
    </div>

    <!-- ═══════════════════ 1. DONORS ═══════════════════ -->
    <div class="section-title">Donors Report</div>
    <div class="report-card" id="section-donors">
        <div class="report-card-header">
            <h3><i class="fa-solid fa-users"></i> Registered Donors</h3>
            <button class="download-btn" onclick="downloadDonorsPDF()">
                <i class="fa-solid fa-file-pdf"></i> Download PDF
            </button>
        </div>

        <div class="table-filter-bar">
            <i class="fa-solid fa-filter" style="color:#8b0000;font-size:13px"></i>
            <input type="text" id="donors-search" placeholder="Search name, blood group, contact…">
            <label>Blood Group:</label>
            <select id="donors-blood">
                <option value="">All Groups</option>
                <option>A+</option>
                <option>A-</option>
                <option>B+</option>
                <option>B-</option>
                <option>O+</option>
                <option>O-</option>
                <option>AB+</option>
                <option>AB-</option>
            </select>
            <label>Eligibility:</label>
            <select id="donors-eligibility">
                <option value="">All</option>
                <option>Eligible</option>
                <option>Deferred</option>
            </select>
            <button class="btn-search" onclick="filterTable('donors')">
                <i class="fa-solid fa-magnifying-glass"></i> Search
            </button>
            <button class="btn-clear" onclick="clearFilter('donors')">
                <i class="fa-solid fa-xmark"></i> Clear
            </button>
        </div>

        <div class="report-table-wrap">
            <table id="tbl-donors">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Donor Name</th>
                        <th>Blood Group</th>
                        <th>Gender</th>
                        <th>Age</th>
                        <th>Contact</th>
                        <th>Last Donation</th>
                        <th>Total Donations</th>
                        <th>Eligibility</th>
                    </tr>
                </thead>
                <tbody id="tbody-donors">
                    @{
                        int donorSerial = 1;
                        var donorList = ViewBag.DonorList as List<BBMS.Models.DonateBlood>;
                    }
                    @if (donorList != null && donorList.Any())
                    {
                        foreach (var d in donorList)
                        {
                            <tr>
                                <td>@(donorSerial++)</td>
                                <td>
                                    <div>@d.FullName</div>
                                    <div style="font-size:11px;color:#8b0000">@d.DonorId</div>
                                </td>
                                <td>@d.BloodGroup</td>
                                <td>@d.Gender</td>
                                <td>@d.Age</td>
                                <td>@d.ContactNumber</td>
                                <td>@(d.LastDonationDate.HasValue? d.LastDonationDate.Value.ToString("dd MMM yyyy") : "—")</td>
                                <td style="text-align:center">@d.TotalDonations</td>
                                <td>
                                    <span class="badge @(d.Eligibility == "Eligible" ? "badge-green" : "badge-yellow")">
                                        @d.Eligibility
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="9" style="text-align:center;color:#aaa;padding:30px">No donors found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="pagination-bar" id="pag-donors">
            <span class="page-info" id="info-donors"></span>
            <div class="page-btns" id="btns-donors"></div>
        </div>
    </div>

    <!-- ═══════════════════ 2. BLOOD STOCK ═══════════════════ -->
    <div class="section-title">Blood Stock Report</div>
    <div class="report-card" id="section-stock">
        <div class="report-card-header">
            <h3><i class="fa-solid fa-syringe"></i> Blood Inventory Summary</h3>
            <button class="download-btn" onclick="downloadPDF('section-stock','Blood_Stock_Report')">
                <i class="fa-solid fa-file-pdf"></i> Download PDF
            </button>
        </div>

        <div class="table-filter-bar">
            <i class="fa-solid fa-filter" style="color:#8b0000;font-size:13px"></i>
            <input type="text" id="stock-search" placeholder="Search blood group, stock level…">
            <label>Stock Level:</label>
            <select id="stock-level">
                <option value="">All Levels</option>
                <option>Normal</option>
                <option>Low</option>
                <option>Critical</option>
            </select>
            <button class="btn-search" onclick="filterTable('stock')">
                <i class="fa-solid fa-magnifying-glass"></i> Search
            </button>
            <button class="btn-clear" onclick="clearFilter('stock')">
                <i class="fa-solid fa-xmark"></i> Clear
            </button>
        </div>

        <div class="report-table-wrap">
            <table id="tbl-stock">
                <thead>
                    <tr>
                        <th>Blood Group</th>
                        <th>Available Units</th>
                        <th>Reserved Units</th>
                        <th>Used This Month</th>
                        <th>Expiring Soon (≤7 days)</th>
                        <th>Last Updated</th>
                        <th>Stock Level</th>
                    </tr>
                </thead>
                <tbody id="tbody-stock">
                    <tr><td><strong>A+</strong></td><td>15</td><td>3</td><td>8</td><td>2</td><td>2025-04-30</td><td><span class="badge badge-green">Normal</span></td></tr>
                    <tr><td><strong>A-</strong></td><td>4</td><td>1</td><td>3</td><td>1</td><td>2025-04-29</td><td><span class="badge badge-yellow">Low</span></td></tr>
                    <tr><td><strong>B+</strong></td><td>12</td><td>2</td><td>6</td><td>0</td><td>2025-04-30</td><td><span class="badge badge-green">Normal</span></td></tr>
                    <tr><td><strong>B-</strong></td><td>2</td><td>0</td><td>2</td><td>2</td><td>2025-04-28</td><td><span class="badge badge-red">Critical</span></td></tr>
                    <tr><td><strong>O+</strong></td><td>20</td><td>5</td><td>14</td><td>3</td><td>2025-04-30</td><td><span class="badge badge-green">Normal</span></td></tr>
                    <tr><td><strong>O-</strong></td><td>6</td><td>2</td><td>5</td><td>1</td><td>2025-04-30</td><td><span class="badge badge-yellow">Low</span></td></tr>
                    <tr><td><strong>AB+</strong></td><td>5</td><td>1</td><td>3</td><td>0</td><td>2025-04-29</td><td><span class="badge badge-yellow">Low</span></td></tr>
                    <tr><td><strong>AB-</strong></td><td>3</td><td>0</td><td>1</td><td>1</td><td>2025-04-27</td><td><span class="badge badge-yellow">Low</span></td></tr>
                </tbody>
            </table>
        </div>
        <div class="pagination-bar" id="pag-stock">
            <span class="page-info" id="info-stock"></span>
            <div class="page-btns" id="btns-stock"></div>
        </div>
    </div>

    <!-- ═══════════════════ 3. BLOOD REQUESTS ═══════════════════ -->
    <div class="section-title">Blood Requests Report</div>
    <div class="report-card" id="section-requests">
        <div class="report-card-header">
            <h3><i class="fa-solid fa-file-medical"></i> Blood Request Log</h3>
            <button class="download-btn" onclick="downloadPDF('section-requests','Blood_Requests_Report')">
                <i class="fa-solid fa-file-pdf"></i> Download PDF
            </button>
        </div>

        <div class="table-filter-bar">
            <i class="fa-solid fa-filter" style="color:#8b0000;font-size:13px"></i>
            <input type="text" id="requests-search" placeholder="Search patient, hospital, request ID…">
            <label>Blood Group:</label>
            <select id="requests-blood">
                <option value="">All Groups</option>
                <option>A+</option>
                <option>A-</option>
                <option>B+</option>
                <option>B-</option>
                <option>O+</option>
                <option>O-</option>
                <option>AB+</option>
                <option>AB-</option>
            </select>
            <label>Status:</label>
            <select id="requests-status">
                <option value="">All Status</option>
                <option>Approved</option>
                <option>Pending</option>
                <option>Rejected</option>
                <option>Processing</option>
            </select>
            <label>From:</label>
            <input type="date" id="requests-from">
            <label>To:</label>
            <input type="date" id="requests-to">
            <button class="btn-search" onclick="filterTable('requests')">
                <i class="fa-solid fa-magnifying-glass"></i> Search
            </button>
            <button class="btn-clear" onclick="clearFilter('requests')">
                <i class="fa-solid fa-xmark"></i> Clear
            </button>
        </div>

        <div class="report-table-wrap">
            <table id="tbl-requests">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Request ID</th>
                        <th>Patient Name</th>
                        <th>Blood Group</th>
                        <th>Units Needed</th>
                        <th>Hospital</th>
                        <th>Request Date</th>
                        <th>Required By</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="tbody-requests">
                    <tr><td>1</td><td>REQ-1001</td><td>Kamal Uddin</td><td>A+</td><td>2</td><td>Dhaka Medical</td><td>2025-04-01</td><td>2025-04-03</td><td><span class="badge badge-green">Approved</span></td></tr>
                    <tr><td>2</td><td>REQ-1002</td><td>Rina Khatun</td><td>O+</td><td>3</td><td>BSMMU</td><td>2025-04-05</td><td>2025-04-06</td><td><span class="badge badge-yellow">Pending</span></td></tr>
                    <tr><td>3</td><td>REQ-1003</td><td>Farhan Ahmed</td><td>B-</td><td>1</td><td>Square Hospital</td><td>2025-04-08</td><td>2025-04-09</td><td><span class="badge badge-red">Rejected</span></td></tr>
                    <tr><td>4</td><td>REQ-1004</td><td>Sumaiya Islam</td><td>AB+</td><td>2</td><td>Apollo Hospital</td><td>2025-04-10</td><td>2025-04-12</td><td><span class="badge badge-green">Approved</span></td></tr>
                    <tr><td>5</td><td>REQ-1005</td><td>Jahir Raihan</td><td>O-</td><td>4</td><td>Dhaka Medical</td><td>2025-04-14</td><td>2025-04-15</td><td><span class="badge badge-yellow">Pending</span></td></tr>
                    <tr><td>6</td><td>REQ-1006</td><td>Mitu Begum</td><td>A-</td><td>1</td><td>Ibn Sina</td><td>2025-04-18</td><td>2025-04-20</td><td><span class="badge badge-blue">Processing</span></td></tr>
                </tbody>
            </table>
        </div>
        <div class="pagination-bar" id="pag-requests">
            <span class="page-info" id="info-requests"></span>
            <div class="page-btns" id="btns-requests"></div>
        </div>
    </div>

    <!-- ═══════════════════ 4. STAFF ═══════════════════ -->
    <div class="section-title">Staff Report</div>
    <div class="report-card" id="section-staff">
        <div class="report-card-header">
            <h3><i class="fa-solid fa-user-tie"></i> Staff Directory</h3>
            <button class="download-btn" onclick="downloadPDF('section-staff','Staff_Report')">
                <i class="fa-solid fa-file-pdf"></i> Download PDF
            </button>
        </div>

        <div class="table-filter-bar">
            <i class="fa-solid fa-filter" style="color:#8b0000;font-size:13px"></i>
            <input type="text" id="staff-search" placeholder="Search name, role, email…">
            <label>Status:</label>
            <select id="staff-status">
                <option value="">All Status</option>
                <option>Active</option>
                <option>Inactive</option>
                <option>On Leave</option>
            </select>
            <button class="btn-search" onclick="filterTable('staff')">
                <i class="fa-solid fa-magnifying-glass"></i> Search
            </button>
            <button class="btn-clear" onclick="clearFilter('staff')">
                <i class="fa-solid fa-xmark"></i> Clear
            </button>
        </div>

        <div class="report-table-wrap">
            <table id="tbl-staff">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Staff Name</th>
                        <th>Role</th>
