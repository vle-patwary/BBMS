@model List<YourApp.Models.BloodRequest>
@{
    ViewData["Title"] = "Blood Requests";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
    * {
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f4f6f9;
    }

    .dashboard {
        width: 92%;
        margin: 32px auto;
    }

    .header {
        background: #8b0000;
        color: white;
        padding: 26px 30px;
        border-radius: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .header h2 {
            margin: 0;
            font-size: 20px;
        }

        .header p {
            margin: 3px 0 0;
            font-size: 13px;
            color: #ffb3b3;
        }

    .stats-row {
        display: flex;
        gap: 16px;
        margin-top: 20px;
        flex-wrap: wrap;
    }

    .stat-card {
        flex: 1;
        min-width: 180px;
        background: white;
        padding: 18px;
        border-radius: 10px;
        border-top: 4px solid #8b0000;
        text-align: center;
    }

        .stat-card h3 {
            margin: 0;
            font-size: 22px;
            color: #8b0000;
        }

        .stat-card p {
            margin-top: 5px;
            font-size: 12px;
            color: #777;
        }

    .alert-success {
        background: #eaf7f0;
        border: 1px solid #a8dfc0;
        color: #1a7a44;
        padding: 12px 18px;
        border-radius: 8px;
        margin-top: 16px;
        font-size: 13px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .alert-error {
        background: #fdecea;
        border: 1px solid #f5b7b1;
        color: #b30000;
        padding: 12px 18px;
        border-radius: 8px;
        margin-top: 16px;
        font-size: 13px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .filter-bar {
        margin-top: 20px;
        background: white;
        padding: 16px;
        border-radius: 10px;
        border: 1px solid #f0e0e0;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: center;
    }

        .filter-bar input,
        .filter-bar select {
            padding: 8px 12px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 13px;
            font-family: 'Segoe UI', sans-serif;
        }

        .filter-bar input {
            flex: 1;
            min-width: 200px;
        }

    .btn-search {
        background: #8b0000;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 13px;
        font-family: 'Segoe UI', sans-serif;
    }

        .btn-search:hover {
            background: #6b0000;
        }

    .btn-clear {
        background: #f0f0f0;
        color: #444;
        border: none;
        padding: 8px 14px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 13px;
        font-family: 'Segoe UI', sans-serif;
        text-decoration: none;
        display: inline-block;
    }

        .btn-clear:hover {
            background: #e0e0e0;
        }

    .table-section {
        margin-top: 20px;
        background: white;
        padding: 20px;
        border-radius: 10px;
        border: 1px solid #f0e0e0;
        overflow-x: auto;
    }

        .table-section h3 {
            font-size: 15px;
            margin: 0 0 14px;
            color: #1a1a1a;
        }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        background: #8b0000;
        color: white;
        padding: 12px 14px;
        font-size: 13px;
        text-align: left;
        white-space: nowrap;
    }

    td {
        padding: 12px 14px;
        font-size: 13px;
        border-bottom: 1px solid #f5eded;
        color: #333;
        vertical-align: middle;
    }

    tr:hover td {
        background: #fff8f8;
    }

    .pill {
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .pill-pending {
        background: #fff3e0;
        color: #e65100;
    }

    .pill-approved {
        background: #e8f5e9;
        color: #2e7d32;
    }

    .pill-rejected {
        background: #fde8e8;
        color: #b30000;
    }

    .pill-refund-pending {
        background: #fff8e1;
        color: #f57f17;
    }

    .pill-refund-done {
        background: #e8f5e9;
        color: #2e7d32;
    }

    .blood-badge {
        display: inline-block;
        background: #fdecea;
        color: #c0392b;
        border: 1px solid #f5b7b1;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 700;
        padding: 2px 10px;
    }

    .action-btn {
        padding: 5px 11px;
        border-radius: 5px;
        font-size: 12px;
        border: none;
        cursor: pointer;
        font-family: 'Segoe UI', sans-serif;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        margin: 2px 1px;
    }

    .btn-approve {
        background: #e8f5e9;
        color: #2e7d32;
    }

        .btn-approve:hover {
            background: #c8e6c9;
        }

    .btn-reject {
        background: #fde8e8;
        color: #b30000;
    }

        .btn-reject:hover {
            background: #ffcdd2;
        }

    .btn-invoice {
        background: #f3e5f5;
        color: #6a1b9a;
    }

        .btn-invoice:hover {
            background: #e1bee7;
        }

    .btn-refund {
        background: #fff3e0;
        color: #e65100;
    }

        .btn-refund:hover {
            background: #ffe0b2;
        }

    .btn-refund-done {
        background: #e8f5e9;
        color: #2e7d32;
    }

        .btn-refund-done:hover {
            background: #c8e6c9;
        }

    .no-data {
        text-align: center;
        padding: 30px 20px;
        color: #999;
        font-size: 14px;
    }

        .no-data i {
            font-size: 32px;
            color: #ddd;
            display: block;
            margin-bottom: 10px;
        }

    .refund-date {
        font-size: 11px;
        color: #999;
        display: block;
        margin-top: 3px;
    }
</style>

<div class="dashboard">

    <!-- HEADER -->
    <div class="header">
        <div>
            <h2><i class="fa-solid fa-droplet"></i> Blood Requests</h2>
            <p>Manage and review incoming blood requests</p>
        </div>
    </div>

    <!-- STATS -->
    <div class="stats-row">
        <div class="stat-card">
            <h3>@ViewBag.TotalRequests</h3>
            <p><i class="fa-solid fa-list"></i> Total Requests</p>
        </div>
        <div class="stat-card">
            <h3>@ViewBag.Pending</h3>
            <p><i class="fa-solid fa-clock"></i> Pending</p>
        </div>
        @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
        {
            <div class="stat-card">
                <h3>@ViewBag.Approved</h3>
                <p><i class="fa-solid fa-circle-check"></i> Approved</p>
            </div>
            <div class="stat-card">
                <h3>@ViewBag.Rejected</h3>
                <p><i class="fa-solid fa-circle-xmark"></i> Rejected</p>
            </div>
        }
    </div>

    <!-- ALERTS -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-success">
            <i class="fa-solid fa-circle-check"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-error">
            <i class="fa-solid fa-circle-exclamation"></i> @TempData["ErrorMessage"]
        </div>
    }

    <!-- FILTER — Admin/Staff only -->
    @if (ViewBag.IsAdminOrStaff == true)
    {
        <form method="get" asp-controller="Home" asp-action="BloodRequests" class="filter-bar">
            <input type="text" name="search"
                   placeholder="Search by patient name or blood group..."
                   value="@ViewBag.Search" />
            <select name="status">
                <option value="">All Status</option>
                <option value="Pending" selected="@(ViewBag.Status == "Pending" ? "selected" : null)">Pending</option>
                <option value="Approved" selected="@(ViewBag.Status == "Approved" ? "selected" : null)">Approved</option>
                <option value="Rejected" selected="@(ViewBag.Status == "Rejected" ? "selected" : null)">Rejected</option>
            </select>
            <button type="submit" class="btn-search">
                <i class="fa-solid fa-magnifying-glass"></i> Search
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string) || !string.IsNullOrEmpty(ViewBag.Status as string))
            {
                <a asp-controller="Home" asp-action="BloodRequests" class="btn-clear">
                    <i class="fa-solid fa-xmark"></i> Clear
                </a>
            }
        </form>
    }

    <!-- TABLE -->
    <div class="table-section">
        <h3>
            All Requests
            <span style="font-size:12px;font-weight:400;color:#999;margin-left:8px;">
                (@(Model?.Count ?? 0) result@(Model?.Count == 1 ? "" : "s"))
            </span>
        </h3>

        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Invoice No</th>
                    <th>Patient Name</th>
                    <th>Blood Group</th>
                    <th>Hospital</th>
                    <th>Contact</th>
                    <th>Required Date</th>
                    <th>Request Date</th>
                    <th>Payment</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int rowNum = 1;
                    foreach (var r in Model)
                    {
                        <tr>
                            <td style="color:#aaa;font-size:12px;">@rowNum</td>
                            <td>
                                <span style="font-family:'Courier New',monospace;font-size:12px;font-weight:700;color:#8b0000;">
                                    @r.InvoiceNumber
                                </span>
                            </td>
                            <td style="font-weight:500;">@r.RequesterName</td>
                            <td><span class="blood-badge">@r.BloodGroup</span></td>
                            <td>@(string.IsNullOrEmpty(r.Hospital) ? "—" : r.Hospital)</td>
                            <td>@(string.IsNullOrEmpty(r.ContactNumber) ? "—" : r.ContactNumber)</td>
                            <td style="white-space:nowrap;">@r.RequiredDate.ToString("dd MMM yyyy")</td>
                            <td style="white-space:nowrap;color:#888;">@r.RequestDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <span style="font-size:12px;">@r.PaymentMethod</span>
                                @if (!string.IsNullOrEmpty(r.MobileNumber))
                                {
                                    <br />
                                    <span style="font-size:11px;color:#888;">@r.MobileNumber</span>
                                }
                            </td>

                            <!-- ── STATUS COLUMN ── -->
                            <td>
                                @if (r.Status == "Pending")
                                {
                                    <span class="pill pill-pending">
                                        <i class="fa-solid fa-clock"></i> Pending
                                    </span>
                                }
                                else if (r.Status == "Approved")
                                {
                                    <span class="pill pill-approved">
                                        <i class="fa-solid fa-circle-check"></i> Approved
                                    </span>
                                }
                                else
                                {
                                    <span class="pill pill-rejected">
                                        <i class="fa-solid fa-circle-xmark"></i> Rejected
                                    </span>

                                    @* Show refund status under rejected pill *@
                                    @if (r.RefundStatus == "Requested")
                                    {
                                        <br />
                                        <span class="pill pill-refund-pending" style="margin-top:4px;">
                                            <i class="fa-solid fa-rotate-left"></i> Refund Pending
                                        </span>
                                    }
                                    else if (r.RefundStatus == "Processed")
                                    {
                                        <br />
                                        <span class="pill pill-refund-done" style="margin-top:4px;">
                                            <i class="fa-solid fa-circle-check"></i> Refunded
                                        </span>
                                    }
                                }
                            </td>

                            <!-- ── ACTIONS COLUMN ── -->
                            <td style="white-space:nowrap;">

                                @* ── Invoice: only when Approved ── *@
                                @if (r.Status == "Approved")
                                {
                                    <a asp-controller="Home"
                                       asp-action="DownloadInvoice"
                                       asp-route-id="@r.Id"
                                       class="action-btn btn-invoice"
                                       target="_blank">
                                        <i class="fa-solid fa-file-pdf"></i> Invoice
                                    </a>
                                }

                                @* ── Approve / Reject: Admin & Staff, Pending only ── *@
                                @if ((User.IsInRole("Admin") || User.IsInRole("Staff")) && r.Status == "Pending")
                                {
                                    <form method="post"
                                          asp-controller="Home"
                                          asp-action="ApproveRequest"
                                          asp-route-id="@r.Id"
                                          style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="action-btn btn-approve"
                                                onclick="return confirm('Approve request for @r.RequesterName?')">
                                            <i class="fa-solid fa-check"></i> Approve
                                        </button>
                                    </form>

                                    <form method="post"
                                          asp-controller="Home"
                                          asp-action="RejectRequest"
                                          asp-route-id="@r.Id"
                                          style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="action-btn btn-reject"
                                                onclick="return confirm('Reject request for @r.RequesterName?')">
                                            <i class="fa-solid fa-xmark"></i> Reject
                                        </button>
                                    </form>
                                }

                                @* ── Refund Request: User, Rejected, no refund yet ── *@
                                @if (User.IsInRole("User") && r.Status == "Rejected")
                                {
                                    @if (r.RefundStatus == null)
                                    {
                                        <form method="post"
                                              asp-controller="Home"
                                              asp-action="RequestRefund"
                                              asp-route-id="@r.Id"
                                              style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="action-btn btn-refund"
                                                    onclick="return confirm('Request a refund of Tk @r.TotalCost for this rejected request?')">
                                                <i class="fa-solid fa-money-bill-wave"></i> Request Refund
                                            </button>
                                        </form>
                                    }
                                    else if (r.RefundStatus == "Requested")
                                    {
                                        <span class="pill pill-refund-pending">
                                            <i class="fa-solid fa-clock"></i> Refund Pending
                                        </span>
                                    }
                                    else if (r.RefundStatus == "Processed")
                                    {
                                        <span class="pill pill-refund-done">
                                            <i class="fa-solid fa-circle-check"></i> Refund Done
                                        </span>
                                    }
                                }

                                @* ── Process Refund: Admin & Staff, Rejected with refund requested ── *@
                                @if ((User.IsInRole("Admin") || User.IsInRole("Staff")) && r.Status == "Rejected")
                                {
                                    @if (r.RefundStatus == "Requested")
                                    {
                                        <form method="post"
                                              asp-controller="Home"
                                              asp-action="ProcessRefund"
                                              asp-route-id="@r.Id"
                                              style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="action-btn btn-refund-done"
                                                    onclick="return confirm('Mark Tk @r.TotalCost refund as processed for @r.RequesterName?')">
                                                <i class="fa-solid fa-rotate-left"></i> Mark Refunded
                                            </button>
                                        </form>
                                        <span class="refund-date">
                                            Requested: @r.RefundRequestedAt?.ToString("dd MMM yyyy")
                                        </span>
                                    }
                                    else if (r.RefundStatus == "Processed")
                                    {
                                        <span class="pill pill-refund-done">
                                            <i class="fa-solid fa-circle-check"></i> Refunded
                                        </span>
                                    }
                                    else if (r.RefundStatus == null)
                                    {
                                        <span style="font-size:12px;color:#bbb;">No refund yet</span>
                                    }
                                }

                                @* ── Pending with User role: no actions ── *@
                                @if (r.Status == "Pending" && User.IsInRole("User"))
                                {
                                    <span style="font-size:12px;color:#bbb;">— Awaiting review —</span>
                                }

                            </td>
                        </tr>
                        rowNum++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="11" class="no-data">
                            <i class="fa-solid fa-inbox"></i>
                            No blood requests found
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>