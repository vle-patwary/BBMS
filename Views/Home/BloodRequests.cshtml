@model List<YourApp.Models.BloodRequest>
@{
    ViewData["Title"] = "Blood Requests";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
    * {
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f4f6f9;
    }

    .dashboard {
        width: 92%;
        margin: 32px auto;
    }

    .header {
        background: #8b0000;
        color: white;
        padding: 26px 30px;
        border-radius: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .header h2 {
            margin: 0;
            font-size: 20px;
        }

        .header p {
            margin: 3px 0 0;
            font-size: 13px;
            color: #ffb3b3;
        }

    .stats-row {
        display: flex;
        gap: 16px;
        margin-top: 20px;
        flex-wrap: wrap;
    }

    .stat-card {
        flex: 1;
        min-width: 180px;
        background: white;
        padding: 18px;
        border-radius: 10px;
        border-top: 4px solid #8b0000;
        text-align: center;
    }

        .stat-card h3 {
            margin: 0;
            font-size: 22px;
            color: #8b0000;
        }

        .stat-card p {
            margin-top: 5px;
            font-size: 12px;
            color: #777;
        }

    .alert-success {
        background: #eaf7f0;
        border: 1px solid #a8dfc0;
        color: #1a7a44;
        padding: 12px 18px;
        border-radius: 8px;
        margin-top: 16px;
        font-size: 13px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .alert-error {
        background: #fdecea;
        border: 1px solid #f5b7b1;
        color: #b30000;
        padding: 12px 18px;
        border-radius: 8px;
        margin-top: 16px;
        font-size: 13px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .filter-bar {
        margin-top: 20px;
        background: white;
        padding: 16px;
        border-radius: 10px;
        border: 1px solid #f0e0e0;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: center;
    }

        .filter-bar input,
        .filter-bar select {
            padding: 8px 12px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 13px;
            font-family: 'Segoe UI', sans-serif;
        }

        .filter-bar input {
            flex: 1;
            min-width: 200px;
        }

    .btn-search {
        background: #8b0000;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 13px;
        font-family: 'Segoe UI', sans-serif;
    }

        .btn-search:hover {
            background: #6b0000;
        }

    .btn-clear {
        background: #f0f0f0;
        color: #444;
        border: none;
        padding: 8px 14px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 13px;
        font-family: 'Segoe UI', sans-serif;
        text-decoration: none;
        display: inline-block;
    }

        .btn-clear:hover {
            background: #e0e0e0;
        }

    .table-section {
        margin-top: 20px;
        background: white;
        padding: 20px;
        border-radius: 10px;
        border: 1px solid #f0e0e0;
        overflow-x: auto;
    }

        .table-section h3 {
            font-size: 15px;
            margin: 0 0 14px;
            color: #1a1a1a;
        }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        background: #8b0000;
        color: white;
        padding: 12px 14px;
        font-size: 13px;
        text-align: left;
        white-space: nowrap;
    }

    td {
        padding: 12px 14px;
        font-size: 13px;
        border-bottom: 1px solid #f5eded;
        color: #333;
        vertical-align: middle;
    }

    tr:hover td {
        background: #fff8f8;
    }

    .pill {
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
        display: inline-block;
    }

    .pill-pending {
        background: #fff3e0;
        color: #e65100;
    }

    .pill-approved {
        background: #e8f5e9;
        color: #2e7d32;
    }

    .pill-rejected {
        background: #fde8e8;
        color: #b30000;
    }

    .pill-refund-pending {
        background: #fff8e1;
        color: #f57f17;
    }

    .pill-refund-done {
        background: #e8f5e9;
        color: #2e7d32;
    }

    .blood-badge {
        display: inline-block;
        background: #fdecea;
        color: #c0392b;
        border: 1px solid #f5b7b1;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 700;
        padding: 2px 10px;
    }

    .action-btn {
        padding: 5px 11px;
        border-radius: 5px;
        font-size: 12px;
        border: none;
        cursor: pointer;
        font-family: 'Segoe UI', sans-serif;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        margin: 2px 1px;
    }

    .btn-approve {
        background: #e8f5e9;
        color: #2e7d32;
    }

        .btn-approve:hover {
            background: #c8e6c9;
        }

    .btn-reject {
        background: #fde8e8;
        color: #b30000;
    }

        .btn-reject:hover {
            background: #ffcdd2;
        }

    .btn-invoice {
        background: #f3e5f5;
        color: #6a1b9a;
    }

        .btn-invoice:hover {
            background: #e1bee7;
        }

    .btn-refund-done {
        background: #e8f5e9;
        color: #2e7d32;
    }

        .btn-refund-done:hover {
            background: #c8e6c9;
        }

    .no-data {
        text-align: center;
        padding: 30px 20px;
        color: #999;
        font-size: 14px;
    }

        .no-data i {
            font-size: 32px;
            color: #ddd;
            display: block;
            margin-bottom: 10px;
        }

    /* ── Status column fixed width ── */
    th:nth-child(10), td:nth-child(10) {
        min-width: 220px;
        width: 220px;
    }

    /* ── Premium Status Card (User view for Rejected) ── */
    .status-card {
        border-radius: 10px;
        padding: 10px 13px;
        font-size: 12px;
        line-height: 1.55;
        width: 200px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.07);
    }

    .status-card-pending {
        background: linear-gradient(135deg, #fffdf0 0%, #fffbea 100%);
        border: 1px solid #f0d060;
    }

    .status-card-done {
        background: linear-gradient(135deg, #f0fdf6 0%, #e6f7ef 100%);
        border: 1px solid #7ecba1;
    }

    .status-card-header {
        display: flex;
        align-items: center;
        gap: 7px;
        font-weight: 700;
        font-size: 12px;
        margin-bottom: 7px;
        padding-bottom: 7px;
    }

    .status-card-pending .status-card-header {
        color: #7d4e00;
        border-bottom: 1px dashed #e8c840;
    }

    .status-card-done .status-card-header {
        color: #145c35;
        border-bottom: 1px dashed #7ecba1;
    }

    .status-card-header .icon-circle {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 10px;
    }

    .status-card-pending .icon-circle {
        background: #fde68a;
        color: #92400e;
    }

    .status-card-done .icon-circle {
        background: #bbf7d0;
        color: #065f46;
    }

    .status-card-row {
        display: flex;
        align-items: flex-start;
        gap: 6px;
        margin-bottom: 4px;
        font-size: 11.5px;
    }

        .status-card-row i {
            margin-top: 2px;
            flex-shrink: 0;
            width: 13px;
            text-align: center;
        }

    .status-card-pending .status-card-row {
        color: #7d5c00;
    }

    .status-card-done .status-card-row {
        color: #1a5c35;
    }

    .status-card-reason {
        font-style: italic;
        opacity: 0.8;
        margin-top: 5px;
        padding-top: 5px;
        font-size: 11px;
        border-top: 1px dashed rgba(0,0,0,0.1);
        word-break: break-word;
    }

    /* ── Rejection Modal ── */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }

        .modal-overlay.open {
            display: flex;
        }

    .modal-box {
        background: white;
        border-radius: 12px;
        width: 420px;
        padding: 28px 26px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    }

    .modal-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 6px;
    }

    .modal-header-icon {
        width: 38px;
        height: 38px;
        background: #fde8e8;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .modal-header-icon i {
            color: #b30000;
            font-size: 16px;
        }

    .modal-title {
        font-size: 17px;
        font-weight: 700;
        color: #1a1a1a;
    }

    .modal-sub {
        font-size: 13px;
        color: #777;
        margin-bottom: 16px;
        margin-left: 48px;
    }

    .modal-patient-info {
        background: #fff8f8;
        border: 1px solid #f5eded;
        border-radius: 8px;
        padding: 10px 14px;
        margin-bottom: 16px;
        font-size: 13px;
        color: #555;
    }

        .modal-patient-info strong {
            color: #8b0000;
        }

    .modal-label {
        font-size: 12px;
        font-weight: 700;
        color: #444;
        margin-bottom: 6px;
        display: block;
    }

    .modal-textarea {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 13px;
        font-family: 'Segoe UI', sans-serif;
        resize: none;
        height: 90px;
        box-sizing: border-box;
        transition: border-color 0.2s;
    }

        .modal-textarea:focus {
            outline: none;
            border-color: #8b0000;
        }

    .modal-textarea-error {
        border-color: #e74c3c !important;
    }

    .modal-error-msg {
        font-size: 12px;
        color: #e74c3c;
        margin-top: 5px;
        display: none;
    }

    .refund-info-box {
        background: #fffbea;
        border: 1px solid #f6d860;
        border-radius: 8px;
        padding: 10px 14px;
        margin-top: 12px;
        font-size: 12px;
        color: #7d5c00;
        display: flex;
        align-items: flex-start;
        gap: 8px;
    }

        .refund-info-box i {
            margin-top: 2px;
            flex-shrink: 0;
        }

    .modal-btn-row {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }

    .modal-cancel-btn {
        flex: 1;
        padding: 10px;
        background: #f0f0f0;
        border: none;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
        font-size: 14px;
        color: #444;
        font-family: 'Segoe UI', sans-serif;
    }

        .modal-cancel-btn:hover {
            background: #e0e0e0;
        }

    .modal-confirm-btn {
        flex: 1;
        padding: 10px;
        background: #8b0000;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
        font-size: 14px;
        font-family: 'Segoe UI', sans-serif;
    }

        .modal-confirm-btn:hover {
            background: #6b0000;
        }

    .refund-date {
        font-size: 11px;
        color: #999;
        display: block;
        margin-top: 3px;
    }
</style>

<div class="dashboard">

    <!-- HEADER -->
    <div class="header">
        <div>
            <h2><i class="fa-solid fa-droplet"></i> Blood Requests</h2>
            <p>Manage and review incoming blood requests</p>
        </div>
    </div>

    <!-- STATS -->
    <div class="stats-row">
        <div class="stat-card">
            <h3>@ViewBag.TotalRequests</h3>
            <p><i class="fa-solid fa-list"></i> Total Requests</p>
        </div>
        <div class="stat-card">
            <h3>@ViewBag.Pending</h3>
            <p><i class="fa-solid fa-clock"></i> Pending</p>
        </div>
        @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
        {
            <div class="stat-card">
                <h3>@ViewBag.Approved</h3>
                <p><i class="fa-solid fa-circle-check"></i> Approved</p>
            </div>
            <div class="stat-card">
                <h3>@ViewBag.Rejected</h3>
                <p><i class="fa-solid fa-circle-xmark"></i> Rejected</p>
            </div>
        }
    </div>

    <!-- ALERTS -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-success">
            <i class="fa-solid fa-circle-check"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-error">
            <i class="fa-solid fa-circle-exclamation"></i> @TempData["ErrorMessage"]
        </div>
    }

    <!-- FILTER — Admin/Staff only -->
    @if (ViewBag.IsAdminOrStaff == true)
    {
        <form method="get" asp-controller="Home" asp-action="BloodRequests" class="filter-bar">
            <input type="text" name="search"
                   placeholder="Search by patient name or blood group..."
                   value="@ViewBag.Search" />
            <select name="status">
                <option value="">All Status</option>
                <option value="Pending" selected="@(ViewBag.Status == "Pending" ? "selected" : null)">Pending</option>
                <option value="Approved" selected="@(ViewBag.Status == "Approved" ? "selected" : null)">Approved</option>
                <option value="Rejected" selected="@(ViewBag.Status == "Rejected" ? "selected" : null)">Rejected</option>
            </select>
            <button type="submit" class="btn-search">
                <i class="fa-solid fa-magnifying-glass"></i> Search
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string) || !string.IsNullOrEmpty(ViewBag.Status as string))
            {
                <a asp-controller="Home" asp-action="BloodRequests" class="btn-clear">
                    <i class="fa-solid fa-xmark"></i> Clear
                </a>
            }
        </form>
    }

    <!-- TABLE -->
    <div class="table-section">
        <h3>
            All Requests
            <span style="font-size:12px;font-weight:400;color:#999;margin-left:8px;">
                (@(Model?.Count ?? 0) result@(Model?.Count == 1 ? "" : "s"))
            </span>
        </h3>

        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Invoice No</th>
                    <th>Patient Name</th>
                    <th>Blood Group</th>
                    <th>Hospital</th>
                    <th>Contact</th>
                    <th>Required Date</th>
                    <th>Request Date</th>
                    <th>Payment</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int rowNum = 1;
                    foreach (var r in Model)
                    {
                        <tr>
                            <td style="color:#aaa;font-size:12px;">@rowNum</td>
                            <td>
                                <span style="font-family:'Courier New',monospace;font-size:12px;font-weight:700;color:#8b0000;">
                                    @r.InvoiceNumber
                                </span>
                            </td>
                            <td style="font-weight:500;">@r.RequesterName</td>
                            <td><span class="blood-badge">@r.BloodGroup</span></td>
                            <td>@(string.IsNullOrEmpty(r.Hospital) ? "—" : r.Hospital)</td>
                            <td>@(string.IsNullOrEmpty(r.ContactNumber) ? "—" : r.ContactNumber)</td>
                            <td style="white-space:nowrap;">@r.RequiredDate.ToString("dd MMM yyyy")</td>
                            <td style="white-space:nowrap;color:#888;">@r.RequestDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <span style="font-size:12px;">@r.PaymentMethod</span>
                                @if (!string.IsNullOrEmpty(r.MobileNumber))
                                {
                                    <br />
                                    <span style="font-size:11px;color:#888;">@r.MobileNumber</span>
                                }
                            </td>

                            <!-- ── STATUS COLUMN ── -->
                            <td>
                                @if (r.Status == "Pending")
                                {
                                    <span class="pill pill-pending">
                                        <i class="fa-solid fa-clock"></i> Pending
                                    </span>
                                }
                                else if (r.Status == "Approved")
                                {
                                    <span class="pill pill-approved">
                                        <i class="fa-solid fa-circle-check"></i> Approved
                                    </span>
                                }
                                else if (r.Status == "Rejected")
                                {
                                    @* Admin/Staff see simple pill + refund sub-pill *@
                                    @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                                    {
                                        <span class="pill pill-rejected">
                                            <i class="fa-solid fa-circle-xmark"></i> Rejected
                                        </span>
                                        @if (r.RefundStatus == "Pending")
                                        {
                                            <br />
                                            <span class="pill pill-refund-pending" style="margin-top:4px;">
                                                <i class="fa-solid fa-rotate-left"></i> Refund Pending
                                            </span>
                                        }
                                        else if (r.RefundStatus == "Processed")
                                        {
                                            <br />
                                            <span class="pill pill-refund-done" style="margin-top:4px;">
                                                <i class="fa-solid fa-circle-check"></i> Refunded
                                            </span>
                                        }
                                    }

                                    @* ── FIX 1: User sees premium status card ──
                                         "else" catches null AND "Pending" — both mean refund not yet done *@
                                    @if (User.IsInRole("User"))
                                    {
                                        @if (r.RefundStatus == "Processed")
                                        {
                                            <div class="status-card status-card-done">
                                                <div class="status-card-header">
                                                    <div class="icon-circle">
                                                        <i class="fa-solid fa-circle-check"></i>
                                                    </div>
                                                    Refund Completed
                                                </div>
                                                <div class="status-card-row">
                                                    <i class="fa-solid fa-bangladeshi-taka-sign"></i>
                                                    <span>৳@r.TotalCost returned successfully</span>
                                                </div>
                                                @if (!string.IsNullOrEmpty(r.MobileNumber))
                                                {
                                                    <div class="status-card-row">
                                                        <i class="fa-solid fa-mobile-screen"></i>
                                                        <span>@r.PaymentMethod · @r.MobileNumber</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            @* Covers RefundStatus == "Pending" AND null *@
                                            <div class="status-card status-card-pending">
                                                <div class="status-card-header">
                                                    <div class="icon-circle">
                                                        <i class="fa-solid fa-circle-xmark"></i>
                                                    </div>
                                                    Request Rejected
                                                </div>
                                                <div class="status-card-row">
                                                    <i class="fa-solid fa-rotate-left"></i>
                                                    <span>Refund of <strong>৳@r.TotalCost</strong> in progress</span>
                                                </div>
                                                @if (!string.IsNullOrEmpty(r.MobileNumber))
                                                {
                                                    <div class="status-card-row">
                                                        <i class="fa-solid fa-mobile-screen"></i>
                                                        <span>@r.PaymentMethod · @r.MobileNumber</span>
                                                    </div>
                                                }
                                                <div class="status-card-row">
                                                    <i class="fa-regular fa-clock"></i>
                                                    <span>Within <strong>3 working days</strong></span>
                                                </div>
                                                @if (!string.IsNullOrEmpty(r.RejectionReason))
                                                {
                                                    <div class="status-card-reason">
                                                        <i class="fa-solid fa-circle-info"></i>
                                                        @r.RejectionReason
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                }
                            </td>

                            <!-- ── ACTIONS COLUMN ── -->
                            <td style="white-space:nowrap;">

                                @* Invoice: Approved only *@
                                @if (r.Status == "Approved")
                                {
                                    <a asp-controller="Home"
                                       asp-action="DownloadInvoice"
                                       asp-route-id="@r.Id"
                                       class="action-btn btn-invoice"
                                       target="_blank">
                                        <i class="fa-solid fa-file-pdf"></i> Invoice
                                    </a>
                                }

                                @* Approve + Reject: Admin/Staff, Pending only *@
                                @if ((User.IsInRole("Admin") || User.IsInRole("Staff")) && r.Status == "Pending")
                                {
                                    <form method="post"
                                          asp-controller="Home"
                                          asp-action="ApproveRequest"
                                          asp-route-id="@r.Id"
                                          style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="action-btn btn-approve"
                                                onclick="return confirm('Approve this request for @r.RequesterName?')">
                                            <i class="fa-solid fa-check"></i> Approve
                                        </button>
                                    </form>

                                    @* Reject opens modal instead of direct form *@
                                    <button type="button"
                                            class="action-btn btn-reject"
                                            onclick="openRejectModal(
                                                                        @r.Id,
                                                                        '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(r.RequesterName)',
                                                                        '@r.BloodGroup',
                                                                        @r.TotalCost,
                                                                        '@r.PaymentMethod',
                                                                        '@r.MobileNumber'
                                                                    )">
                                        <i class="fa-solid fa-xmark"></i> Reject
                                    </button>
                                }

                                @* Mark as Refunded: Admin/Staff, Rejected, refund pending *@
                                @if ((User.IsInRole("Admin") || User.IsInRole("Staff"))
                                                        && r.Status == "Rejected"
                                                        && r.RefundStatus == "Pending")
                                {
                                    <form method="post"
                                          asp-controller="Home"
                                          asp-action="ProcessRefund"
                                          asp-route-id="@r.Id"
                                          style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="action-btn btn-refund-done"
                                                onclick="return confirm('Confirm that ৳@r.TotalCost has been refunded to @r.RequesterName?')">
                                            <i class="fa-solid fa-rotate-left"></i> Mark Refunded
                                        </button>
                                    </form>
                                    <span class="refund-date">
                                        Since: @r.RefundRequestedAt?.ToString("dd MMM yyyy")
                                    </span>
                                }

                                @* Refunded badge for Admin/Staff *@
                                @if ((User.IsInRole("Admin") || User.IsInRole("Staff"))
                                                        && r.Status == "Rejected"
                                                        && r.RefundStatus == "Processed")
                                {
                                    <span class="pill pill-refund-done">
                                        <i class="fa-solid fa-circle-check"></i> Refunded
                                    </span>
                                }

                                @* Pending with User role — awaiting review *@
                                @if (r.Status == "Pending" && User.IsInRole("User"))
                                {
                                    <span style="font-size:12px;color:#bbb;">— Awaiting review —</span>
                                }

                                @* ── FIX 2: Rejected with User role — no actions available *@
                                @if (r.Status == "Rejected" && User.IsInRole("User"))
                                {
                                    <span style="font-size:12px;color:#bbb;">— No actions available —</span>
                                }

                            </td>
                        </tr>
                        rowNum++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="11" class="no-data">
                            <i class="fa-solid fa-inbox"></i>
                            No blood requests found
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ══════════════════════════════════════════ -->
<!-- ── REJECTION MODAL ─────────────────────── -->
<!-- ══════════════════════════════════════════ -->
<div class="modal-overlay" id="reject-modal">
    <div class="modal-box">

        <div class="modal-header">
            <div class="modal-header-icon">
                <i class="fa-solid fa-circle-xmark"></i>
            </div>
            <div class="modal-title">Reject Blood Request</div>
        </div>
        <div class="modal-sub">Please provide a reason before rejecting.</div>

        <!-- Patient info summary -->
        <div class="modal-patient-info">
            <i class="fa-solid fa-user"></i>
            Patient: <strong id="modal-patient-name">—</strong> &nbsp;|&nbsp;
            <i class="fa-solid fa-droplet"></i>
            Blood: <strong id="modal-blood-group">—</strong> &nbsp;|&nbsp;
            <i class="fa-solid fa-bangladeshi-taka-sign"></i>
            Paid: <strong id="modal-total-cost">—</strong>
        </div>

        <!-- Rejection form -->
        <form method="post"
              asp-controller="Home"
              asp-action="RejectRequest"
              id="reject-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="modal-request-id" value="" />

            <label class="modal-label">
                Rejection Reason <span style="color:#b30000;">*</span>
            </label>
            <textarea class="modal-textarea"
                      name="rejectionReason"
                      id="modal-reason"
                      placeholder="e.g. Blood type not currently available, request details incomplete..."
                      oninput="clearModalError()"></textarea>
            <div class="modal-error-msg" id="modal-error">
                <i class="fa-solid fa-circle-exclamation"></i>
                Please enter a rejection reason.
            </div>

            <!-- Refund info notice -->
            <div class="refund-info-box" id="modal-refund-info" style="display:none;">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <div>
                    Rejecting this request will automatically mark a refund of
                    <strong id="modal-refund-amount">৳0</strong> as pending
                    <span>
                        for <strong id="modal-payment-method-display"></strong>
                        number <strong id="modal-mobile-display"></strong>
                    </span>
                </div>
            </div>

            <div class="modal-btn-row">
                <button type="button" class="modal-cancel-btn" onclick="closeRejectModal()">
                    <i class="fa-solid fa-arrow-left"></i> Cancel
                </button>
                <button type="button" class="modal-confirm-btn" onclick="submitRejectForm()">
                    <i class="fa-solid fa-circle-xmark"></i> Confirm Reject
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openRejectModal(id, name, bloodGroup, totalCost, paymentMethod, mobile) {
        document.getElementById('modal-request-id').value      = id;
        document.getElementById('modal-patient-name').textContent  = name;
        document.getElementById('modal-blood-group').textContent   = bloodGroup;
        document.getElementById('modal-total-cost').textContent    = '৳' + totalCost;
        document.getElementById('modal-reason').value             = '';
        document.getElementById('modal-error').style.display      = 'none';
        document.getElementById('modal-reason').classList.remove('modal-textarea-error');

        // Show refund notice only if payment method is not cash
        const cashMethods = ['Cash on site', 'Bank transfer'];
        const refundBox   = document.getElementById('modal-refund-info');

        if (paymentMethod && !cashMethods.includes(paymentMethod)) {
            document.getElementById('modal-refund-amount').textContent          = '৳' + totalCost;
            document.getElementById('modal-payment-method-display').textContent = paymentMethod;
            document.getElementById('modal-mobile-display').textContent         = mobile || '—';
            refundBox.style.display = 'flex';
        } else {
            refundBox.style.display = 'none';
        }

        document.getElementById('reject-modal').classList.add('open');
        setTimeout(() => document.getElementById('modal-reason').focus(), 100);
    }

    function closeRejectModal() {
        document.getElementById('reject-modal').classList.remove('open');
    }

    function clearModalError() {
        document.getElementById('modal-error').style.display = 'none';
        document.getElementById('modal-reason').classList.remove('modal-textarea-error');
    }

    function submitRejectForm() {
        const reason = document.getElementById('modal-reason').value.trim();
        if (!reason) {
            document.getElementById('modal-error').style.display = 'block';
            document.getElementById('modal-reason').classList.add('modal-textarea-error');
            document.getElementById('modal-reason').focus();
            return;
        }
        document.getElementById('reject-form').submit();
    }

    // Close modal when clicking outside
    document.getElementById('reject-modal').addEventListener('click', function (e) {
        if (e.target === this) closeRejectModal();
    });
</script>
