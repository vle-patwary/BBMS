@model IEnumerable<BBMS.Models.DonateBlood>

@{
    ViewData["Title"] = "View Donors";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
    * {
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f4f6f9;
    }

    .page-wrapper {
        width: 94%;
        margin: 32px auto;
    }

    /* ── Page Header ── */
    .page-header {
        background: #8b0000;
        color: white;
        padding: 24px 28px;
        border-radius: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

        .page-header h2 {
            font-size: 20px;
            font-weight: 700;
            margin: 0;
        }

        .page-header p {
            font-size: 13px;
            color: #ffb3b3;
            margin: 4px 0 0;
        }

    .total-badge {
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.3);
        padding: 8px 18px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 600;
    }

    /* ── Stat Cards ── */
    .stat-row {
        display: flex;
        gap: 16px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

    .stat-card {
        flex: 1;
        min-width: 140px;
        background: white;
        padding: 18px 20px;
        border-radius: 10px;
        border-left: 4px solid #8b0000;
        border: 1px solid #f0e0e0;
        border-left: 4px solid #8b0000;
    }

        .stat-card span {
            font-size: 12px;
            color: #999;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 500;
        }

        .stat-card h4 {
            font-size: 22px;
            font-weight: 700;
            color: #8b0000;
            margin: 6px 0 0;
        }

    /* ── Search & Filter Bar ── */
    .filter-bar {
        background: white;
        padding: 16px 20px;
        border-radius: 10px;
        border: 1px solid #f0e0e0;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        align-items: center;
        margin-bottom: 20px;
    }

        .filter-bar input,
        .filter-bar select {
            padding: 9px 14px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 13px;
            outline: none;
            flex: 1;
            min-width: 160px;
        }

            .filter-bar input:focus,
            .filter-bar select:focus {
                border-color: #8b0000;
            }

    .btn-search {
        background: #8b0000;
        color: white;
        border: none;
        padding: 9px 20px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-search:hover {
            background: #a00000;
        }

    .btn-reset {
        background: #f5f5f5;
        color: #555;
        border: 1px solid #ddd;
        padding: 9px 16px;
        border-radius: 6px;
        font-size: 13px;
        cursor: pointer;
        text-decoration: none;
    }

        .btn-reset:hover {
            background: #eee;
        }

    /* ── Table ── */
    .table-section {
        background: white;
        border-radius: 10px;
        border: 1px solid #f0e0e0;
        overflow: hidden;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead tr {
        background: #8b0000;
    }

    th {
        color: white;
        padding: 13px 16px;
        font-size: 13px;
        font-weight: 600;
        text-align: left;
        white-space: nowrap;
    }

    td {
        padding: 12px 16px;
        border-bottom: 1px solid #f5eded;
        font-size: 13px;
        color: #333;
    }

    tr:last-child td {
        border-bottom: none;
    }

    tr:hover td {
        background: #fff8f8;
    }
    /* ── Pagination ── */
    .pagination-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
        flex-wrap: wrap;
        gap: 10px;
    }

    .page-info {
        font-size: 13px;
        color: #666;
    }

    .page-buttons {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .page-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        color: #8b0000;
        background: white;
        border: 1px solid #f0e0e0;
        cursor: pointer;
        transition: all 0.2s;
    }

        .page-btn:hover {
            background: #fff0f0;
            border-color: #8b0000;
        }

        .page-btn.active {
            background: #8b0000;
            color: white;
            border-color: #8b0000;
        }

        .page-btn.disabled {
            color: #ccc;
            border-color: #eee;
            cursor: not-allowed;
            background: #fafafa;
        }
    /* ── Pills ── */
    .pill {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .pill-eligible {
        background: #e8f5e9;
        color: #2e7d32;
    }

    .pill-deferred {
        background: #fdecea;
        color: #c62828;
    }

    .pill-male {
        background: #e3f2fd;
        color: #1565c0;
    }

    .pill-female {
        background: #fce4ec;
        color: #880e4f;
    }

    .pill-other {
        background: #f3e5f5;
        color: #6a1b9a;
    }

    .blood-tag {
        display: inline-block;
        background: #fff0f0;
        color: #8b0000;
        border: 1px solid #f0c0c0;
        padding: 2px 10px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 700;
    }

    /* ── Empty State ── */
    .empty-state {
        text-align: center;
        padding: 50px 20px;
        color: #aaa;
    }

        .empty-state i {
            font-size: 40px;
            margin-bottom: 12px;
            color: #ddd;
        }

        .empty-state p {
            font-size: 14px;
        }
</style>

<div class="page-wrapper">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div>
            <h2><i class="fa-solid fa-droplet"></i> Donor Collection</h2>
            <p>All registered blood donors in the system</p>
        </div>
        <div class="total-badge">
            Total: @Model.Count() Donors
        </div>
    </div>

    <!-- STAT CARDS -->
    <div class="stat-row">
        <div class="stat-card">
            <span>Total Donors</span>
            <h4>@Model.Count()</h4>
        </div>
        <div class="stat-card">
            <span>Eligible</span>
            <h4>@Model.Count(d => d.Eligibility == "Eligible")</h4>
        </div>
        <div class="stat-card">
            <span>Deferred</span>
            <h4>@Model.Count(d => d.Eligibility == "Deferred")</h4>
        </div>
        <div class="stat-card">
            <span>Total Donations</span>
            <h4>@Model.Sum(d => d.TotalDonations)</h4>
        </div>
    </div>

    <!-- SEARCH & FILTER -->
    <form method="get" asp-action="ViewCollection" asp-controller="Home">
        <div class="filter-bar">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   placeholder="Search by name, email or location..." />

            <select name="bloodGroup">
                <option value="">-- All Blood Groups --</option>
                @foreach (var bg in new[] { "A+", "A-", "B+", "B-", "O+", "O-", "AB+", "AB-" })
                {
                    <option value="@bg" selected="@(ViewBag.BloodGroup == bg ? "selected" : null)">
                        @bg
                    </option>
                }
            </select>

            <select name="gender">
                <option value="">-- All Genders --</option>
                <option value="Male" selected="@(ViewBag.Gender == "Male" ? "selected" : null)">Male</option>
                <option value="Female" selected="@(ViewBag.Gender == "Female" ? "selected" : null)">Female</option>
                <option value="Other" selected="@(ViewBag.Gender == "Other" ? "selected" : null)">Other</option>
            </select>

            <select name="eligibility">
                <option value="">-- Eligibility --</option>
                <option value="Eligible" selected="@(ViewBag.Eligibility == "Eligible" ? "selected" : null)">Eligible</option>
                <option value="Deferred" selected="@(ViewBag.Eligibility == "Deferred" ? "selected" : null)">Deferred</option>
            </select>

            <button type="submit" class="btn-search">
                <i class="fa-solid fa-magnifying-glass"></i> Search
            </button>
            <a asp-action="ViewCollection" asp-controller="Home" class="btn-reset">
                <i class="fa-solid fa-rotate-left"></i> Reset
            </a>
        </div>
    </form>

    <!-- TABLE -->
    <div class="table-section">
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Donor ID</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Gender</th>
                    <th>Blood Group</th>
                    <th>Age</th>
                    <th>Contact</th>
                    <th>Location</th>
                    <th>Last Donation</th>
                    <th>Total Donations</th>
                    <th>Eligibility</th>
                    <th>Registered</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int pageSize = 10;
                    int pageNumber = (int)(ViewBag.PageNumber ?? 1);
                    int totalItems = Model.Count();
                    int totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
                    var pagedData = Model.Skip((pageNumber - 1) * pageSize).Take(pageSize).ToList();
                    int startIndex = (pageNumber - 1) * pageSize + 1;
                }

                @if (pagedData.Any())
                {
                    int i = startIndex;
                    foreach (var d in pagedData)
                    {
                        <tr>
                            <td>@i</td>
                            <td><strong>@d.DonorId</strong></td>
                            <td>@d.FullName</td>
                            <td>@d.Email</td>
                            <td>
                                <span class="pill @(d.Gender == "Male" ? "pill-male" :
                                                                              d.Gender == "Female" ? "pill-female" : "pill-other")">
                                    @d.Gender
                                </span>
                            </td>
                            <td><span class="blood-tag">@d.BloodGroup</span></td>
                            <td>@d.Age</td>
                            <td>@d.ContactNumber</td>
                            <td>@d.Location</td>
                            <td>
                                @(d.LastDonationDate.HasValue
                                                        ? d.LastDonationDate.Value.ToString("dd-MM-yyyy")
                                                        : "Never")
                            </td>
                            <td style="text-align:center">@d.TotalDonations</td>
                            <td>
                                <span class="pill @(d.Eligibility == "Eligible" ? "pill-eligible" : "pill-deferred")">
                                    @d.Eligibility
                                </span>
                            </td>
                            <td>@d.CreatedAt.ToString("dd-MM-yyyy")</td>
                        </tr>
                        i++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="13">
                            <div class="empty-state">
                                <i class="fa-solid fa-droplet-slash"></i>
                                <p>No donors found matching your criteria.</p>
                            </div>
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
    <!-- PAGINATION -->
    @if (totalPages > 1)
    {
        <div class="pagination-bar">
            <span class="page-info">
                Showing @startIndex–@Math.Min(pageNumber * pageSize, totalItems) of @totalItems donors
            </span>
            <div class="page-buttons">

                @* Previous *@
                @if (pageNumber > 1)
                {
                    <a class="page-btn"
                       asp-action="ViewCollection"
                       asp-controller="Home"
                       asp-route-page="@(pageNumber - 1)"
                       asp-route-search="@ViewBag.Search"
                       asp-route-bloodGroup="@ViewBag.BloodGroup"
                       asp-route-gender="@ViewBag.Gender"
                       asp-route-eligibility="@ViewBag.Eligibility">
                        <i class="fa-solid fa-chevron-left"></i>
                    </a>
                }
                else
                {
                    <span class="page-btn disabled"><i class="fa-solid fa-chevron-left"></i></span>
                }

                @* Page Numbers *@
                @for (int p = 1; p <= totalPages; p++)
                {
                    if (p == pageNumber)
                    {
                        <span class="page-btn active">@p</span>
                    }
                    else
                    {
                        <a class="page-btn"
                           asp-action="ViewCollection"
                           asp-controller="Home"
                           asp-route-page="@p"
                           asp-route-search="@ViewBag.Search"
                           asp-route-bloodGroup="@ViewBag.BloodGroup"
                           asp-route-gender="@ViewBag.Gender"
                           asp-route-eligibility="@ViewBag.Eligibility">
                            @p
                        </a>
                    }
                }

                @* Next *@
                @if (pageNumber < totalPages)
                {
                    <a class="page-btn"
                       asp-action="ViewCollection"
                       asp-controller="Home"
                       asp-route-page="@(pageNumber + 1)"
                       asp-route-search="@ViewBag.Search"
                       asp-route-bloodGroup="@ViewBag.BloodGroup"
                       asp-route-gender="@ViewBag.Gender"
                       asp-route-eligibility="@ViewBag.Eligibility">
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                }
                else
                {
                    <span class="page-btn disabled"><i class="fa-solid fa-chevron-right"></i></span>
                }

            </div>
        </div>
    }

</div>