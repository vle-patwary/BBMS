@model IEnumerable<BBMS.Models.Staff>
@{
    ViewData["Title"] = "Manage Staff";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f4f6f9;
    }

    .dashboard {
        width: 92%;
        margin: 32px auto;
    }

    .header {
        background: #8b0000;
        color: white;
        padding: 28px 32px;
        border-radius: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        overflow: hidden;
        margin-bottom: 26px;
    }

        .header::before {
            content: '';
            position: absolute;
            right: -40px;
            top: -50px;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }

        .header::after {
            content: '';
            position: absolute;
            right: 120px;
            bottom: -60px;
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }

    .header-left h2 {
        font-size: 22px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 5px;
    }

    .header-left p {
        font-size: 13px;
        color: #ffb3b3;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 12px;
        z-index: 1;
    }

    .header-stat {
        text-align: center;
    }

        .header-stat .val {
            font-size: 20px;
            font-weight: 700;
            color: #fff;
        }

        .header-stat .lbl {
            font-size: 11px;
            color: #ffb3b3;
            margin-top: 2px;
        }

    .h-divider {
        width: 1px;
        height: 40px;
        background: rgba(255,255,255,0.2);
    }

    .btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.2);
        color: #ffb3b3;
        padding: 9px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s;
    }

        .btn-ghost:hover {
            background: rgba(255,255,255,0.18);
        }

    /* alerts */
    .alert {
        padding: 12px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
    }

    .alert-success {
        background: #e6f9ef;
        color: #1a8a4a;
        border: 1px solid #b7ecd0;
    }

    .alert-danger {
        background: #fff0f0;
        color: #8b0000;
        border: 1px solid #f5c0c0;
    }

    /* stat cards */
    .stat-row {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 26px;
    }

    .stat-card {
        flex: 1;
        min-width: 140px;
        background: white;
        border: 1px solid #f0e0e0;
        border-top: 4px solid #8b0000;
        border-radius: 10px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .sc-icon {
        width: 44px;
        height: 44px;
        background: #fff0f0;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .sc-icon i {
            color: #8b0000;
            font-size: 17px;
        }

    .sc-val {
        font-size: 24px;
        font-weight: 800;
        color: #8b0000;
    }

    .sc-lbl {
        font-size: 12px;
        color: #888;
        margin-top: 2px;
    }

    /* toolbar */
    .toolbar {
        background: white;
        border: 1px solid #f0e0e0;
        border-radius: 10px;
        padding: 16px 22px;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 20px;
    }

    .search-wrap {
        flex: 1;
        min-width: 200px;
        position: relative;
    }

        .search-wrap i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #aaa;
            font-size: 13px;
        }

        .search-wrap input {
            width: 100%;
            padding: 9px 12px 9px 34px;
            border: 1px solid #ddd;
            border-radius: 7px;
            font-size: 13px;
            color: #333;
            background: #fafafa;
            outline: none;
            font-family: inherit;
        }

            .search-wrap input:focus {
                border-color: #8b0000;
            }

    .toolbar select {
        padding: 9px 12px;
        border: 1px solid #ddd;
        border-radius: 7px;
        font-size: 13px;
        color: #333;
        background: #fafafa;
        outline: none;
        font-family: inherit;
    }

    .btn-add {
        background: #8b0000;
        color: white;
        padding: 9px 18px;
        border-radius: 8px;
        border: none;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-family: inherit;
        text-decoration: none;
        transition: background 0.2s;
        white-space: nowrap;
    }

        .btn-add:hover {
            background: #6e0000;
        }

    /* table */
    .table-section {
        background: white;
        border: 1px solid #f0e0e0;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 40px;
    }

    .table-section-header {
        padding: 16px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #f5eded;
    }

        .table-section-header span {
            font-size: 14px;
            font-weight: 700;
            color: #1a1a1a;
        }

    .record-count {
        font-size: 12px;
        background: #fff0f0;
        color: #8b0000;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 20px;
    }

    .table-wrap {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead th {
        background: #8b0000;
        color: white;
        padding: 12px 16px;
        font-size: 12px;
        font-weight: 600;
        text-align: left;
        white-space: nowrap;
    }

    tbody td {
        padding: 13px 16px;
        border-bottom: 1px solid #f5eded;
        font-size: 13px;
        color: #333;
        vertical-align: middle;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    tbody tr:hover td {
        background: #fff8f8;
    }

    .staff-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #8b0000;
        color: white;
        font-size: 13px;
        font-weight: 700;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .staff-name {
        font-weight: 600;
        color: #1a1a1a;
    }

    .staff-id {
        font-size: 11px;
        color: #aaa;
        margin-top: 1px;
    }

    .role-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .role-admin {
        background: #fff0f0;
        color: #8b0000;
    }

    .role-staff {
        background: #e8f4fd;
        color: #1565c0;
    }

    .role-nurse {
        background: #e6f9ef;
        color: #1a8a4a;
    }

    .role-lab {
        background: #fff8e1;
        color: #b8860b;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .status-active {
        background: #e6f9ef;
        color: #1a8a4a;
    }

    .status-inactive {
        background: #f0f0f0;
        color: #777;
    }

    .status-leave {
        background: #fff8e1;
        color: #b8860b;
    }

    .actions {
        display: flex;
        gap: 6px;
        align-items: center;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        border: none;
        font-family: inherit;
        transition: all 0.15s;
    }

    .btn-edit {
        background: #e8f4fd;
        color: #1565c0;
    }

        .btn-edit:hover {
            background: #1565c0;
            color: white;
        }

    .btn-delete {
        background: #fff0f0;
        color: #8b0000;
    }

        .btn-delete:hover {
            background: #8b0000;
            color: white;
        }

    /* empty state */
    .empty-state {
        text-align: center;
        padding: 50px 20px;
        color: #bbb;
    }

        .empty-state i {
            font-size: 40px;
            margin-bottom: 12px;
            color: #e0c0c0;
            display: block;
        }

    /* pagination */
    .pagination {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 22px;
        border-top: 1px solid #f5eded;
        font-size: 13px;
        color: #888;
    }

    /* delete modal */
    .modal-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        z-index: 999;
        align-items: center;
        justify-content: center;
    }

        .modal-backdrop.show {
            display: flex;
        }

    .modal-box {
        background: white;
        border-radius: 12px;
        padding: 32px 28px;
        width: 360px;
        text-align: center;
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
    }

    .modal-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: #fff0f0;
        margin: 0 auto 16px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .modal-icon i {
            color: #8b0000;
            font-size: 22px;
        }

    .modal-box h3 {
        font-size: 17px;
        color: #1a1a1a;
        margin-bottom: 8px;
    }

    .modal-box p {
        font-size: 13px;
        color: #777;
        margin-bottom: 24px;
    }

    .modal-actions {
        display: flex;
        gap: 10px;
        justify-content: center;
    }

    .btn-modal-cancel {
        padding: 9px 22px;
        border-radius: 7px;
        border: 1px solid #ddd;
        background: white;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        color: #555;
    }

    .btn-modal-delete {
        padding: 9px 22px;
        border-radius: 7px;
        border: none;
        background: #8b0000;
        color: white;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    .section-title {
        font-size: 15px;
        font-weight: 700;
        color: #1a1a1a;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
    }

        .section-title::before {
            content: '';
            display: block;
            width: 4px;
            height: 16px;
            background: #8b0000;
            border-radius: 2px;
        }
</style>

<div class="dashboard">

    <!-- HEADER -->
    <div class="header">
        <div class="header-left">
            <h2><i class="fa-solid fa-user-tie" style="margin-right:10px"></i>Manage Staff</h2>
            <p>Add, edit, and manage all blood bank staff members</p>
        </div>
        <div class="header-right">
            <div class="header-stat">
                <div class="val">@ViewBag.TotalStaff</div>
                <div class="lbl">Total</div>
            </div>
            <div class="h-divider"></div>
            <div class="header-stat">
                <div class="val">@ViewBag.ActiveStaff</div>
                <div class="lbl">Active</div>
            </div>
            <div class="h-divider"></div>
            <div class="header-stat">
                <div class="val">@ViewBag.OnLeave</div>
                <div class="lbl">On Leave</div>
            </div>
            <div class="h-divider"></div>
            <a asp-controller="Home" asp-action="Admin" class="btn-ghost">
                <i class="fa-solid fa-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <!-- ALERTS -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <i class="fa-solid fa-circle-check"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            <i class="fa-solid fa-triangle-exclamation"></i> @TempData["ErrorMessage"]
        </div>
    }

    <!-- STAT CARDS -->
    <div class="section-title">Overview</div>
    <div class="stat-row">
        <div class="stat-card">
            <div class="sc-icon"><i class="fa-solid fa-users"></i></div>
            <div><div class="sc-val">@ViewBag.TotalStaff</div><div class="sc-lbl">Total Staff</div></div>
        </div>
        <div class="stat-card">
            <div class="sc-icon"><i class="fa-solid fa-circle-check"></i></div>
            <div><div class="sc-val">@ViewBag.ActiveStaff</div><div class="sc-lbl">Active</div></div>
        </div>
        <div class="stat-card">
            <div class="sc-icon"><i class="fa-solid fa-user-clock"></i></div>
            <div><div class="sc-val">@ViewBag.OnLeave</div><div class="sc-lbl">On Leave</div></div>
        </div>
        <div class="stat-card">
            <div class="sc-icon"><i class="fa-solid fa-user-shield"></i></div>
            <div><div class="sc-val">@ViewBag.Admins</div><div class="sc-lbl">Admins</div></div>
        </div>
    </div>

    <!-- TOOLBAR -->
    <form method="get" asp-action="ManageStaff">
        <div class="toolbar">
            <div class="search-wrap">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Search by name, email, contact…">
            </div>
            <select name="role">
                <option value="">All Roles</option>
                @{
                    var roles = new[] { "Admin", "Blood Bank Officer", "Lab Technician", "Nurse", "Data Entry Operator", "Staff" };
                }
                @foreach (var r in roles)
                {
                    if ((string)ViewBag.Role == r)
                    {
                        <option value="@r" selected="selected">@r</option>
                    }
                    else
                    {
                        <option value="@r">@r</option>
                    }
                }
            </select>
            <select name="status">
                <option value="">All Status</option>
                @{
                    var statuses = new[] { "Active", "Inactive", "On Leave" };
                }
                @foreach (var st in statuses)
                {
                    if ((string)ViewBag.Status == st)
                    {
                        <option value="@st" selected="selected">@st</option>
                    }
                    else
                    {
                        <option value="@st">@st</option>
                    }
                }
            </select>
            <button type="submit" class="btn-add">
                <i class="fa-solid fa-magnifying-glass"></i> Search
            </button>
            <a asp-action="AddStaff" asp-controller="Home" class="btn-add">
                <i class="fa-solid fa-plus"></i> Add New Staff
            </a>
        </div>
    </form>

    <!-- TABLE -->
    <div class="table-section">
        <div class="table-section-header">
            <span><i class="fa-solid fa-list" style="color:#8b0000;margin-right:8px"></i>Staff List</span>
            <span class="record-count">@Model.Count() records</span>
        </div>

        <div class="table-wrap">
            @if (!Model.Any())
            {
                <div class="empty-state">
                    <i class="fa-solid fa-users-slash"></i>
                    <p>No staff members found.</p>
                </div>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Staff Member</th>
                            <th>Email</th>
                            <th>Contact</th>
                            <th>Role</th>
                            <th>Join Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int i = 1;
                        }
                        @foreach (var s in Model)
                        {
                            var initials = string.Concat(s.Name.Split(' ').Take(2).Select(w => w[0])).ToUpper();
                            var roleClass = s.Role == "Admin" ? "role-admin"
                            : s.Role == "Nurse" ? "role-nurse"
                            : (s.Role == "Lab Technician") ? "role-lab"
                            : "role-staff";
                            var statusClass = s.Status == "Active" ? "status-active"
                            : s.Status == "On Leave" ? "status-leave"
                            : "status-inactive";
                            <tr>
                                <td>@(i++)</td>
                                <td>
                                    <div class="staff-cell">
                                        <div class="avatar">@initials</div>
                                        <div>
                                            <div class="staff-name">@s.Name</div>
                                            <div class="staff-id">STF-@s.Id.ToString("D4")</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@s.Email</td>
                                <td>@s.Contact</td>
                                <td><span class="role-badge @roleClass">@s.Role</span></td>
                                <td>@s.JoinDate.ToString("dd MMM yyyy")</td>
                                <td><span class="status-badge @statusClass">@s.Status</span></td>
                                <td>
                                    <div class="actions">
                                        <a asp-action="EditStaff" asp-route-id="@s.Id" class="action-btn btn-edit">
                                            <i class="fa-solid fa-pen"></i> Edit
                                        </a>
                                        <button type="button" class="action-btn btn-delete"
                                                onclick="openDelete(@s.Id, '@s.Name')">
                                            <i class="fa-solid fa-trash"></i> Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="pagination">
            <span>Showing @Model.Count() staff members</span>
        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal-backdrop" id="deleteModal">
    <div class="modal-box">
        <div class="modal-icon">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <h3>Delete Staff Member?</h3>
        <p id="deleteMsg">This action cannot be undone.</p>
        <div class="modal-actions">
            <button class="btn-modal-cancel" onclick="closeModal()">Cancel</button>
            <!-- Real POST form for delete -->
            <form id="deleteForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteId" />
                <button type="submit" class="btn-modal-delete">
                    <i class="fa-solid fa-trash"></i> Yes, Delete
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    function openDelete(id, name) {
        document.getElementById('deleteId').value = id;
        document.getElementById('deleteMsg').textContent =
            'Are you sure you want to delete "' + name + '"?';
        document.getElementById('deleteForm').action =
            '/Home/DeleteStaff';
        document.getElementById('deleteModal').classList.add('show');
    }

    function closeModal() {
        document.getElementById('deleteModal').classList.remove('show');
    }

    document.getElementById('deleteModal').addEventListener('click', function (e) {
        if (e.target === this) closeModal();
    });
</script>
