@model IEnumerable<BBMS.Models.Hospital>
@{
    ViewData["Title"] = "Manage Hospitals";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f4f6f9;
    }

    .dashboard {
        width: 92%;
        margin: 32px auto 50px;
    }

    /* HEADER */
    .header {
        background: #8b0000;
        color: white;
        padding: 28px 32px;
        border-radius: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        overflow: hidden;
        margin-bottom: 26px;
    }

        .header::before {
            content: '';
            position: absolute;
            right: -40px;
            top: -50px;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }

        .header::after {
            content: '';
            position: absolute;
            right: 120px;
            bottom: -60px;
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }

    .header-left h2 {
        font-size: 22px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 5px;
    }

    .header-left p {
        font-size: 13px;
        color: #ffb3b3;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 12px;
        z-index: 1;
    }

    .header-stat .val {
        font-size: 20px;
        font-weight: 700;
        color: #fff;
    }

    .header-stat .lbl {
        font-size: 11px;
        color: #ffb3b3;
        margin-top: 2px;
    }

    .h-divider {
        width: 1px;
        height: 40px;
        background: rgba(255,255,255,0.2);
    }

    .btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.2);
        color: #ffb3b3;
        padding: 9px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s;
    }

        .btn-ghost:hover {
            background: rgba(255,255,255,0.18);
        }

    /* SECTION TITLE */
    .section-title {
        font-size: 15px;
        font-weight: 700;
        color: #1a1a1a;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
    }

        .section-title::before {
            content: '';
            display: block;
            width: 4px;
            height: 16px;
            background: #8b0000;
            border-radius: 2px;
        }

    /* STAT CARDS */
    .stat-row {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 26px;
    }

    .stat-card {
        flex: 1;
        min-width: 140px;
        background: white;
        border: 1px solid #f0e0e0;
        border-top: 4px solid #8b0000;
        border-radius: 10px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .sc-icon {
        width: 44px;
        height: 44px;
        background: #fff0f0;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .sc-icon i {
            color: #8b0000;
            font-size: 17px;
        }

    .sc-val {
        font-size: 24px;
        font-weight: 800;
        color: #8b0000;
    }

    .sc-lbl {
        font-size: 12px;
        color: #888;
        margin-top: 2px;
    }

    /* TOOLBAR */
    .toolbar {
        background: white;
        border: 1px solid #f0e0e0;
        border-radius: 10px;
        padding: 16px 22px;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 20px;
    }

    .search-wrap {
        flex: 1;
        min-width: 200px;
        position: relative;
    }

        .search-wrap i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #aaa;
            font-size: 13px;
        }

        .search-wrap input {
            width: 100%;
            padding: 9px 12px 9px 34px;
            border: 1px solid #ddd;
            border-radius: 7px;
            font-size: 13px;
            color: #333;
            background: #fafafa;
            outline: none;
            font-family: inherit;
        }

            .search-wrap input:focus {
                border-color: #8b0000;
            }

    .toolbar select {
        padding: 9px 12px;
        border: 1px solid #ddd;
        border-radius: 7px;
        font-size: 13px;
        color: #333;
        background: #fafafa;
        outline: none;
        font-family: inherit;
    }

    .btn-add {
        background: #8b0000;
        color: white;
        padding: 9px 18px;
        border-radius: 8px;
        border: none;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-family: inherit;
        text-decoration: none;
        transition: background 0.2s;
        white-space: nowrap;
    }

        .btn-add:hover {
            background: #6e0000;
        }

    /* TABLE */
    .table-section {
        background: white;
        border: 1px solid #f0e0e0;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 40px;
    }

    .table-section-header {
        padding: 16px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #f5eded;
    }

        .table-section-header span {
            font-size: 14px;
            font-weight: 700;
            color: #1a1a1a;
        }

    .record-count {
        font-size: 12px;
        background: #fff0f0;
        color: #8b0000;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 20px;
    }

    .table-wrap {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead th {
        background: #8b0000;
        color: white;
        padding: 12px 16px;
        font-size: 12px;
        font-weight: 600;
        text-align: left;
        white-space: nowrap;
    }

    tbody td {
        padding: 13px 16px;
        border-bottom: 1px solid #f5eded;
        font-size: 13px;
        color: #333;
        vertical-align: middle;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    tbody tr:hover td {
        background: #fff8f8;
    }

    /* HOSPITAL CELL */
    .hospital-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .hospital-avatar {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        background: #8b0000;
        color: white;
        font-size: 13px;
        font-weight: 700;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .hospital-name {
        font-weight: 600;
        color: #1a1a1a;
    }

    .hospital-id {
        font-size: 11px;
        color: #aaa;
        margin-top: 1px;
    }

    /* BADGES */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .status-active {
        background: #e6f9ef;
        color: #1a8a4a;
    }

    .status-inactive {
        background: #f0f0f0;
        color: #777;
    }

    .status-pending {
        background: #fff8e1;
        color: #b8860b;
    }

    .type-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .type-govt {
        background: #e8f4fd;
        color: #1565c0;
    }

    .type-private {
        background: #fff0f0;
        color: #8b0000;
    }

    .type-ngo {
        background: #e6f9ef;
        color: #1a8a4a;
    }

    /* ACTIONS */
    .actions {
        display: flex;
        gap: 6px;
        align-items: center;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        border: none;
        font-family: inherit;
        transition: all 0.15s;
    }

    .btn-edit {
        background: #1565c0;
        color: white;
    }

        .btn-edit:hover {
            background: #0d47a1;
            color: white;
        }

    .btn-delete {
        background: #8b0000;
        color: white;
    }

        .btn-delete:hover {
            background: #6e0000;
            color: white;
        }

    /* ── DELETE MODAL (matching ManageBloodStock style) ── */
    .bs-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.82);
        z-index: 999999;
        align-items: center;
        justify-content: center;
    }

        .bs-modal-overlay.show {
            display: flex;
            pointer-events: all;
        }

    .delete-modal-box {
        background: #ffffff;
        isolation: isolate;
        border-radius: 12px;
        width: 420px;
        max-width: 95vw;
        overflow: hidden;
        box-shadow: 0 25px 70px rgba(0,0,0,0.6);
        position: relative;
        z-index: 1000000;
        animation: modalSlideIn 0.25s ease;
    }

    @@keyframes modalSlideIn {
        from {
            transform: translateY(-20px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .delete-modal-header {
        background: #8b0000;
        color: white;
        padding: 16px 22px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        font-weight: 700;
    }

    .delete-modal-body {
        padding: 24px;
        font-size: 13px;
        color: #444;
        line-height: 1.6;
        background: #ffffff;
    }

        .delete-modal-body strong {
            color: #8b0000;
        }

    .delete-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 16px 24px;
        border-top: 1px solid #f5eded;
        background: #ffffff;
    }

    .btn-cancel-modal {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 20px;
        border-radius: 8px;
        border: 1px solid #ddd;
        background: white;
        color: #555;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        font-family: inherit;
        transition: all 0.2s;
    }

        .btn-cancel-modal:hover {
            border-color: #8b0000;
            color: #8b0000;
        }

    .btn-confirm-delete {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 22px;
        border-radius: 8px;
        border: none;
        background: #8b0000;
        color: white;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        transition: all 0.2s;
    }

        .btn-confirm-delete:hover {
            background: #6e0000;
        }

    @@media (max-width: 700px) {
        .stat-row {
            flex-direction: column;
        }

        .actions {
            flex-wrap: wrap;
        }
    }
</style>

<div class="dashboard">

    <!-- HEADER -->
    <div class="header">
        <div class="header-left">
            <h2><i class="fa-solid fa-building" style="margin-right:10px"></i>Manage Hospitals</h2>
            <p>Add, edit, and manage all partner hospitals</p>
        </div>
        <div class="header-right">
            <div class="header-stat">
                <div class="val">@ViewBag.TotalHospitals</div>
                <div class="lbl">Total</div>
            </div>
            <div class="h-divider"></div>
            <div class="header-stat">
                <div class="val">@ViewBag.ActiveHospitals</div>
                <div class="lbl">Active</div>
            </div>
            <div class="h-divider"></div>
            <div class="header-stat">
                <div class="val">@ViewBag.PendingHospitals</div>
                <div class="lbl">Pending</div>
            </div>
            <div class="h-divider"></div>
            <a asp-controller="Home" asp-action="Admin" class="btn-ghost">
                <i class="fa-solid fa-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <!-- STAT CARDS -->
    <div class="section-title">Overview</div>
    <div class="stat-row">
        <div class="stat-card">
            <div class="sc-icon"><i class="fa-solid fa-hospital"></i></div>
            <div><div class="sc-val">@ViewBag.TotalHospitals</div><div class="sc-lbl">Total Hospitals</div></div>
        </div>
        <div class="stat-card">
            <div class="sc-icon"><i class="fa-solid fa-circle-check"></i></div>
            <div><div class="sc-val">@ViewBag.ActiveHospitals</div><div class="sc-lbl">Active</div></div>
        </div>
        <div class="stat-card">
            <div class="sc-icon"><i class="fa-solid fa-clock"></i></div>
            <div><div class="sc-val">@ViewBag.PendingHospitals</div><div class="sc-lbl">Pending Approval</div></div>
        </div>
        <div class="stat-card">
            <div class="sc-icon"><i class="fa-solid fa-droplet"></i></div>
            <div><div class="sc-val">@ViewBag.TotalUnits</div><div class="sc-lbl">Units Supplied</div></div>
        </div>
        <div class="stat-card">
            <div class="sc-icon"><i class="fa-solid fa-file-medical"></i></div>
            <div><div class="sc-val">@ViewBag.TotalRequests</div><div class="sc-lbl">Total Requests</div></div>
        </div>
    </div>

    <!-- TOOLBAR -->
    <form method="get" asp-action="ManageHospital" asp-controller="Home">
        <div class="toolbar">
            <div class="search-wrap">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Search by name, location, contact…">
            </div>
            <select name="type">
                <option value="">All Types</option>
                <option value="Government" selected="@(ViewBag.Type == "Government" ? "selected" : null)">Government</option>
                <option value="Private" selected="@(ViewBag.Type == "Private" ? "selected" : null)">Private</option>
                <option value="NGO" selected="@(ViewBag.Type == "NGO" ? "selected" : null)">NGO</option>
            </select>
            <select name="status">
                <option value="">All Status</option>
                <option value="Active" selected="@(ViewBag.Status == "Active" ? "selected" : null)">Active</option>
                <option value="Inactive" selected="@(ViewBag.Status == "Inactive" ? "selected" : null)">Inactive</option>
                <option value="Pending Approval" selected="@(ViewBag.Status == "Pending Approval" ? "selected" : null)">Pending Approval</option>
            </select>
            <button type="submit" class="btn-add" style="background:#555;">
                <i class="fa-solid fa-filter"></i> Filter
            </button>
            <a asp-action="AddHospital" asp-controller="Home" class="btn-add">
                <i class="fa-solid fa-plus"></i> Add New Hospital
            </a>
        </div>
    </form>

    <!-- TABLE -->
    <div class="table-section">
        <div class="table-section-header">
            <span><i class="fa-solid fa-list" style="color:#8b0000;margin-right:8px"></i>Hospital List</span>
            <span class="record-count">@Model.Count() record@(Model.Count() != 1 ? "s" : "")</span>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Hospital</th>
                        <th>Type</th>
                        <th>Location</th>
                        <th>Contact Person</th>
                        <th>Phone</th>
                        <th>Requests</th>
                        <th>Units Supplied</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="10" style="text-align:center; padding:32px; color:#aaa;">
                                <i class="fa-solid fa-hospital" style="font-size:28px;margin-bottom:8px;display:block"></i>
                                No hospitals found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int i = 1;
                        foreach (var h in Model)
                        {
                            var words = h.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                            var avatar = words.Length >= 2
                            ? $"{words[0][0]}{words[1][0]}"
                            : h.Name.Substring(0, Math.Min(2, h.Name.Length));
                            avatar = avatar.ToUpper();

                            var typeCss = h.Type == "Government" ? "type-govt" : h.Type == "NGO" ? "type-ngo" : "type-private";
                            var typeIcon = h.Type == "Government" ? "fa-landmark" : "fa-building";

                            var statusCss = h.Status == "Active" ? "status-active"
                            : h.Status == "Inactive" ? "status-inactive"
                            : "status-pending";

                            <tr>
                                <td>@i</td>
                                <td>
                                    <div class="hospital-cell">
                                        <div class="hospital-avatar">@avatar</div>
                                        <div>
                                            <div class="hospital-name">@h.Name</div>
                                            <div class="hospital-id">@h.HospitalCode</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="type-badge @typeCss"><i class="fa-solid @typeIcon"></i> @h.Type</span></td>
                                <td>@h.Location</td>
                                <td>@h.ContactPerson</td>
                                <td>@h.Phone</td>
                                <td>@h.Requests</td>
                                <td>@h.UnitsSupplied</td>
                                <td><span class="status-badge @statusCss">@h.Status</span></td>
                                <td>
                                    <div class="actions">
                                        <a class="action-btn btn-edit"
                                           asp-action="EditHospital" asp-controller="Home"
                                           asp-route-id="@h.Id">
                                            <i class="fa-solid fa-pen"></i> Edit
                                        </a>
                                        <button class="action-btn btn-delete"
                                                onclick="openDeleteModal(@h.Id, '@h.Name.Replace("'", "\\'")')">
                                            <i class="fa-solid fa-trash"></i> Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                </tbody>
            </table>
        </div>
        <div style="padding:14px 22px; border-top:1px solid #f5eded; font-size:13px; color:#888;">
            Showing @Model.Count() hospital@(Model.Count() != 1 ? "s" : "")
        </div>
    </div>
</div>

<!-- ═══════════════════════════════
     DELETE CONFIRM MODAL
═══════════════════════════════ -->
<div class="bs-modal-overlay" id="deleteModal">
    <div class="delete-modal-box">
        <div class="delete-modal-header">
            <i class="fa-solid fa-triangle-exclamation"></i> Confirm Delete
        </div>
        <div class="delete-modal-body">
            Are you sure you want to delete the hospital
            <strong id="deleteHospitalLabel"></strong>?
            This action <strong>cannot be undone</strong>.
        </div>
        <div class="delete-modal-footer">
            <button class="btn-cancel-modal" onclick="closeDeleteModal()">
                <i class="fa-solid fa-xmark"></i> Cancel
            </button>
            <button class="btn-confirm-delete" onclick="confirmDelete()">
                <i class="fa-solid fa-trash"></i> Yes, Delete
            </button>
        </div>
    </div>
</div>

<!-- Hidden delete form -->
<form id="deleteForm" asp-action="DeleteHospital" asp-controller="Home" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="delete-form-id" />
</form>

<script>
    // ── Move modal to <body> so no parent container clips it ──
    document.addEventListener('DOMContentLoaded', function () {
        var modal = document.getElementById('deleteModal');
        if (modal) document.body.appendChild(modal);
    });

    // ── Close on backdrop click ──
    document.addEventListener('DOMContentLoaded', function () {
        document.getElementById('deleteModal').addEventListener('click', function (e) {
            if (e.target === this) closeDeleteModal();
        });
    });

    // ── DELETE MODAL ──────────────────────────────
    function openDeleteModal(id, name) {
        document.getElementById('delete-form-id').value         = id;
        document.getElementById('deleteHospitalLabel').innerText = name;
        document.getElementById('deleteModal').classList.add('show');
        document.body.style.overflow = 'hidden';
    }

    function closeDeleteModal() {
        document.getElementById('deleteModal').classList.remove('show');
        document.body.style.overflow = '';
    }

    function confirmDelete() {
        document.getElementById('deleteForm').submit();
    }

    // ── TOAST ─────────────────────────────────────
    @if (TempData["SuccessMessage"] != null)
    {
            <text>
            window.addEventListener('DOMContentLoaded', () => showToast('@TempData["SuccessMessage"]', 'success'));
            </text>
    }
    @if (TempData["ErrorMessage"] != null)
    {
            <text>
            window.addEventListener('DOMContentLoaded', () => showToast('@TempData["ErrorMessage"]', 'error'));
            </text>
    }

    function showToast(msg, type) {
        let t = document.getElementById('globalToast');
        if (!t) {
            t = document.createElement('div');
            t.id = 'globalToast';
            t.style.cssText = [
                'position:fixed','bottom:28px','right:28px','color:white',
                'padding:14px 22px','border-radius:10px','font-size:13px','font-weight:600',
                'display:flex','align-items:center','gap:10px','box-shadow:0 8px 28px rgba(0,0,0,0.18)',
                "font-family:'Segoe UI',sans-serif",'transform:translateY(80px)','opacity:0',
                'transition:all 0.35s cubic-bezier(.34,1.56,.64,1)','z-index:9999999'
            ].join(';');
            document.body.appendChild(t);
        }
        t.style.background = type === 'error' ? '#8b0000' : '#1a8a4a';
        const icon = type === 'error' ? 'fa-triangle-exclamation' : 'fa-circle-check';
        t.innerHTML = `<i class="fa-solid ${icon}"></i> ${msg}`;
        setTimeout(() => { t.style.transform = 'translateY(0)';    t.style.opacity = '1'; }, 10);
        setTimeout(() => { t.style.transform = 'translateY(80px)'; t.style.opacity = '0'; }, 3200);
    }
</script>
