<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BBMS</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BBMS.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        /* ── Blood Bank Navbar ── */
        .navbar {
            background: #fff !important;
            border-bottom: 2px solid #c0152a !important;
            box-shadow: 0 2px 12px rgba(192, 21, 42, 0.08);
            padding-top: 0;
            padding-bottom: 0;
            min-height: 60px;
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.3rem;
            letter-spacing: 0.06em;
            color: #c0152a !important;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .navbar-brand svg {
                width: 22px;
                height: 22px;
                flex-shrink: 0;
            }

            .navbar-brand:hover {
                color: #8b0000 !important;
            }

        .nav-link.text-dark {
            font-size: 0.88rem;
            font-weight: 500;
            color: #2d2d2d !important;
            padding: 6px 12px !important;
            border-radius: 5px;
            transition: color 0.18s, background 0.18s;
        }

            .nav-link.text-dark:hover {
                color: #c0152a !important;
                background: rgba(192, 21, 42, 0.06);
            }

        .nav-link.active {
            color: #c0152a !important;
            background: rgba(192, 21, 42, 0.07);
        }

        .nav-item .nav-link.btn-nav-login {
            border: 1.5px solid #c0152a;
            color: #c0152a !important;
            border-radius: 5px;
            padding: 5px 16px !important;
            margin-left: 4px;
        }

            .nav-item .nav-link.btn-nav-login:hover {
                background: #c0152a;
                color: #fff !important;
            }

        .nav-item .nav-link.btn-nav-register {
            background: #c0152a;
            color: #fff !important;
            border-radius: 5px;
            padding: 5px 16px !important;
            margin-left: 4px;
        }

            .nav-item .nav-link.btn-nav-register:hover {
                background: #8b0000;
                color: #fff !important;
            }

        .nav-link.text-danger-muted {
            color: #888 !important;
            font-size: 0.85rem;
        }

            .nav-link.text-danger-muted:hover {
                color: #c0152a !important;
                background: rgba(192, 21, 42, 0.06);
            }

        .navbar-toggler {
            border-color: rgba(192, 21, 42, 0.4) !important;
        }

        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='%23c0152a' stroke-width='2' stroke-linecap='round' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e") !important;
        }

        #editModal, #deleteModal {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            z-index: 999999 !important;
            background: rgba(0,0,0,0.82) !important;
            display: none;
            align-items: center;
            justify-content: center;
        }

            #editModal.show, #deleteModal.show {
                display: flex !important;
            }

        /* ── Footer ── */
        .site-footer {
            background: #7a0000;
            padding: 0;
            margin-top: 0;
            border-top: none;
        }

        .footer-inner {
            padding: 28px 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 20px;
        }

        .footer-left {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .footer-brand {
            font-size: 15px;
            font-weight: 600;
            color: #fff;
            letter-spacing: 0.02em;
        }

        .footer-dev {
            font-size: 12px;
            color: rgba(255,255,255,0.55);
        }

        .footer-privacy a {
            font-size: 12px;
            color: rgba(255,255,255,0.45);
            text-decoration: none;
            transition: color 0.15s;
        }

            .footer-privacy a:hover {
                color: #fff;
            }

        .footer-right {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .footer-social-link {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: rgba(255,255,255,0.1);
            border: 0.5px solid rgba(255,255,255,0.18);
            transition: background 0.15s;
            text-decoration: none;
        }

            .footer-social-link:hover {
                background: rgba(255,255,255,0.2);
            }

        .footer-bottom {
            border-top: 0.5px solid rgba(255,255,255,0.12);
            padding: 12px 40px;
            text-align: center;
        }

            .footer-bottom p {
                font-size: 11px;
                color: rgba(255,255,255,0.3);
                margin: 0;
                letter-spacing: 0.3px;
            }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3">
            <div class="container-fluid">

                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg viewBox="0 0 24 30" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 1C12 1 2 12 2 18.5C2 24 6.5 28 12 28C17.5 28 22 24 22 18.5C22 12 12 1 12 1Z" fill="#c0152a" />
                        <path d="M12 7C12 7 6 14.5 6 18.5C6 21.5 8.5 24 12 24" stroke="rgba(255,255,255,0.3)" stroke-width="1.5" stroke-linecap="round" fill="none" />
                    </svg>
                    BBMS
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Home" asp-action="Admin">Admin</a>
                            </li>
                        }

                        @if (User.IsInRole("Staff"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Home" asp-action="Staff">Staff</a>
                            </li>
                        }

                        @if (User.IsInRole("User"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Home" asp-action="UserDashboard">Dashboard</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-sm-center">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item ms-auto">
                                <a class="nav-link text-danger-muted" asp-controller="Auth" asp-action="Logout">Logout</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link btn-nav-login" asp-controller="Auth" asp-action="LogIn">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn-nav-register" asp-controller="Auth" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-inner">

            <div class="footer-left">
                <div class="footer-brand">Blood Bank Management System</div>
                <div class="footer-dev">&copy; 2026 &mdash; Developed by Md Waliullah Patwary &middot; 21103014</div>
                <div class="footer-privacy">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                </div>
            </div>

            <div class="footer-right">
                <a href="https://www.facebook.com/profile.php?id=61567954297888"
                   target="_blank" rel="noopener noreferrer"
                   title="Facebook" class="footer-social-link">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="#fff">
                        <path d="M24 12.073C24 5.404 18.627 0 12 0S0 5.404 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.235 2.686.235v2.97h-1.513c-1.491 0-1.956.93-1.956 1.886v2.269h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z" />
                    </svg>
                </a>

                <a href="https://www.instagram.com/vle_xplr/"
                   target="_blank" rel="noopener noreferrer"
                   title="Instagram" class="footer-social-link">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="#fff">
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                    </svg>
                </a>
            </div>

        </div>
        <div class="footer-bottom">
            <p>Saving lives, one donation at a time &mdash; Blood Bank Management System</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
