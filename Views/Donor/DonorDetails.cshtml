@model BBMS.Models.DonateBlood
@{
    ViewData["Title"] = "Donor Details";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f4f6f9;
    }

    .dashboard {
        width: 92%;
        margin: 32px auto 50px;
    }

    /* HEADER */
    .header {
        background: #8b0000;
        color: white;
        padding: 28px 32px;
        border-radius: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        overflow: hidden;
        margin-bottom: 26px;
    }

        .header::before {
            content: '';
            position: absolute;
            right: -40px;
            top: -50px;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }

        .header::after {
            content: '';
            position: absolute;
            right: 120px;
            bottom: -60px;
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }

    .header-left h2 {
        font-size: 22px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 5px;
    }

    .header-left p {
        font-size: 13px;
        color: #ffb3b3;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 12px;
        z-index: 1;
    }

    .btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.2);
        color: #ffb3b3;
        padding: 9px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s;
    }

        .btn-ghost:hover {
            background: rgba(255,255,255,0.18);
        }

    .btn-edit-top {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: white;
        color: #8b0000;
        border: none;
        padding: 9px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        transition: background 0.2s;
        z-index: 1;
    }

        .btn-edit-top:hover {
            background: #ffe0e0;
        }

    /* SECTION TITLE */
    .section-title {
        font-size: 15px;
        font-weight: 700;
        color: #1a1a1a;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
    }

        .section-title::before {
            content: '';
            display: block;
            width: 4px;
            height: 16px;
            background: #8b0000;
            border-radius: 2px;
        }

    /* DONOR PROFILE CARD */
    .profile-card {
        background: white;
        border: 1px solid #f0e0e0;
        border-radius: 10px;
        padding: 28px;
        display: flex;
        align-items: center;
        gap: 24px;
        margin-bottom: 20px;
    }

    .profile-avatar {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: #8b0000;
        color: white;
        font-size: 22px;
        font-weight: 800;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .profile-name {
        font-size: 20px;
        font-weight: 800;
        color: #1a1a1a;
    }

    .profile-id {
        font-size: 13px;
        color: #8b0000;
        font-weight: 700;
        margin-top: 4px;
    }

    .profile-meta {
        display: flex;
        gap: 12px;
        margin-top: 10px;
        flex-wrap: wrap;
    }

    .profile-meta-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: #666;
        background: #f9f9f9;
        padding: 4px 12px;
        border-radius: 20px;
        border: 1px solid #eee;
    }

        .profile-meta-item i {
            color: #8b0000;
            font-size: 11px;
        }

    .blood-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #8b0000;
        color: white;
        font-weight: 800;
        font-size: 15px;
        padding: 6px 16px;
        border-radius: 20px;
        margin-left: 12px;
    }

    /* INFO CARDS */
    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .info-card {
        background: white;
        border: 1px solid #f0e0e0;
        border-radius: 10px;
        overflow: hidden;
    }

    .info-card-header {
        background: #8b0000;
        color: white;
        padding: 12px 20px;
        font-size: 13px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .info-card-body {
        padding: 20px;
    }

    .field-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid #f5eded;
    }

        .field-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

    .field-label {
        font-size: 12px;
        font-weight: 700;
        color: #999;
        text-transform: uppercase;
    }

    .field-value {
        font-size: 13px;
        font-weight: 600;
        color: #1a1a1a;
        text-align: right;
    }

    /* BADGES */
    .badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .badge-eligible {
        background: #e6f9ef;
        color: #1a8a4a;
    }

    .badge-deferred {
        background: #fff8e1;
        color: #b8860b;
    }

    /* STAT ROW */
    .stat-row {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .stat-card {
        flex: 1;
        min-width: 140px;
        background: white;
        border: 1px solid #f0e0e0;
        border-top: 4px solid #8b0000;
        border-radius: 10px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

        .stat-card.green {
            border-top-color: #1a8a4a;
        }

    .sc-icon {
        width: 44px;
        height: 44px;
        background: #fff0f0;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .stat-card.green .sc-icon {
        background: #e6f9ef;
    }

    .sc-icon i {
        color: #8b0000;
        font-size: 17px;
    }

    .stat-card.green .sc-icon i {
        color: #1a8a4a;
    }

    .sc-val {
        font-size: 24px;
        font-weight: 800;
        color: #8b0000;
    }

    .stat-card.green .sc-val {
        color: #1a8a4a;
    }

    .sc-lbl {
        font-size: 12px;
        color: #888;
        margin-top: 2px;
    }
</style>

<div class="dashboard">

    <!-- HEADER -->
    <div class="header">
        <div class="header-left">
            <h2><i class="fa-solid fa-user" style="margin-right:10px"></i>Donor Details</h2>
            <p>Viewing full profile for @Model.DonorId</p>
        </div>
        <div class="header-right">
            <a asp-controller="Donor" asp-action="EditDonor"
               asp-route-id="@Model.DonorId" class="btn-edit-top">
                <i class="fa-solid fa-pen-to-square"></i> Edit Donor
            </a>
            <a asp-controller="Donor" asp-action="ManageDonors" class="btn-ghost">
                <i class="fa-solid fa-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <!-- PROFILE CARD -->
    @{
        var initials = string.Join("", Model.FullName.Split(' ')
        .Take(2).Select(w => w[0].ToString().ToUpper()));
    }
    <div class="profile-card">
        <div class="profile-avatar">@initials</div>
        <div>
            <div style="display:flex;align-items:center;gap:8px">
                <div class="profile-name">@Model.FullName</div>
                <span class="blood-badge">@Model.BloodGroup</span>
            </div>
            <div class="profile-id">@Model.DonorId</div>
            <div class="profile-meta">
                <span class="profile-meta-item"><i class="fa-solid fa-venus-mars"></i> @Model.Gender</span>
                <span class="profile-meta-item"><i class="fa-solid fa-cake-candles"></i> Age @Model.Age</span>
                <span class="profile-meta-item"><i class="fa-solid fa-phone"></i> @Model.ContactNumber</span>
                @if (!string.IsNullOrEmpty(Model.Email))
                {
                    <span class="profile-meta-item"><i class="fa-solid fa-envelope"></i> @Model.Email</span>
                }
                <span class="badge @(Model.Eligibility == "Eligible" ? "badge-eligible" : "badge-deferred")">
                    <i class="fa-solid @(Model.Eligibility == "Eligible" ? "fa-circle-check" : "fa-clock")"></i>
                    @Model.Eligibility
                </span>
            </div>
        </div>
    </div>

    <!-- STATS -->
    <div class="section-title">Donation Summary</div>
    <div class="stat-row">
        <div class="stat-card green">
            <div class="sc-icon"><i class="fa-solid fa-droplet"></i></div>
            <div>
                <div class="sc-val">@Model.TotalDonations</div>
                <div class="sc-lbl">Total Donations</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="sc-icon"><i class="fa-solid fa-calendar-day"></i></div>
            <div>
                <div class="sc-val" style="font-size:16px;padding-top:4px">
                    @(Model.LastDonationDate.HasValue
                                        ? Model.LastDonationDate.Value.ToString("dd MMM yyyy")
                                        : "Never")
                </div>
                <div class="sc-lbl">Last Donation</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="sc-icon"><i class="fa-solid fa-calendar-plus"></i></div>
            <div>
                <div class="sc-val" style="font-size:16px;padding-top:4px">
                    @Model.CreatedAt.ToString("dd MMM yyyy")
                </div>
                <div class="sc-lbl">Registered On</div>
            </div>
        </div>
    </div>

    <!-- INFO GRID -->
    <div class="section-title">Full Information</div>
    <div class="info-grid">

        <!-- Personal Info -->
        <div class="info-card">
            <div class="info-card-header">
                <i class="fa-solid fa-id-card"></i> Personal Information
            </div>
            <div class="info-card-body">
                <div class="field-row">
                    <span class="field-label">Full Name</span>
                    <span class="field-value">@Model.FullName</span>
                </div>
                <div class="field-row">
                    <span class="field-label">Donor ID</span>
                    <span class="field-value" style="color:#8b0000">@Model.DonorId</span>
                </div>
                <div class="field-row">
                    <span class="field-label">Gender</span>
                    <span class="field-value">@Model.Gender</span>
                </div>
                <div class="field-row">
                    <span class="field-label">Age</span>
                    <span class="field-value">@Model.Age years</span>
                </div>
                <div class="field-row">
                    <span class="field-label">Blood Group</span>
                    <span class="field-value">
                        <span style="background:#8b0000;color:white;padding:3px 12px;border-radius:20px;font-weight:800;font-size:12px">
                            @Model.BloodGroup
                        </span>
                    </span>
                </div>
                <div class="field-row">
                    <span class="field-label">Eligibility</span>
                    <span class="field-value">
                        <span class="badge @(Model.Eligibility == "Eligible" ? "badge-eligible" : "badge-deferred")">
                            @Model.Eligibility
                        </span>
                    </span>
                </div>
            </div>
        </div>

        <!-- Contact Info -->
        <div class="info-card">
            <div class="info-card-header">
                <i class="fa-solid fa-address-book"></i> Contact & Donation Info
            </div>
            <div class="info-card-body">
                <div class="field-row">
                    <span class="field-label">Contact Number</span>
                    <span class="field-value">@Model.ContactNumber</span>
                </div>
                <div class="field-row">
                    <span class="field-label">Email</span>
                    <span class="field-value">@(string.IsNullOrEmpty(Model.Email) ? "—" : Model.Email)</span>
                </div>
                <div class="field-row">
                    <span class="field-label">Total Donations</span>
                    <span class="field-value" style="color:#8b0000;font-size:16px">@Model.TotalDonations</span>
                </div>
                <div class="field-row">
                    <span class="field-label">Last Donation</span>
                    <span class="field-value">
                        @(Model.LastDonationDate.HasValue
                                                ? Model.LastDonationDate.Value.ToString("dd MMM yyyy")
                                                : "—")
                    </span>
                </div>
                <div class="field-row">
                    <span class="field-label">Registered On</span>
                    <span class="field-value">@Model.CreatedAt.ToString("dd MMM yyyy")</span>
                </div>
            </div>
        </div>

    </div>
</div>
