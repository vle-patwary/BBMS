@model List<BBMS.Models.DonateBlood>
@{
    ViewData["Title"] = "Manage Donors";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f4f6f9;
    }

    .dashboard {
        width: 92%;
        margin: 32px auto 50px;
    }

    /* ── HEADER ── */
    .header {
        background: #8b0000;
        color: white;
        padding: 28px 32px;
        border-radius: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        overflow: hidden;
        margin-bottom: 26px;
    }

        .header::before {
            content: '';
            position: absolute;
            right: -40px;
            top: -50px;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }

        .header::after {
            content: '';
            position: absolute;
            right: 120px;
            bottom: -60px;
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }

    .header-left h2 {
        font-size: 22px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 5px;
    }

    .header-left p {
        font-size: 13px;
        color: #ffb3b3;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 12px;
        z-index: 1;
    }

    .header-stat {
        text-align: center;
    }

        .header-stat .val {
            font-size: 20px;
            font-weight: 700;
            color: #fff;
        }

        .header-stat .lbl {
            font-size: 11px;
            color: #ffb3b3;
            margin-top: 2px;
        }

    .h-divider {
        width: 1px;
        height: 40px;
        background: rgba(255,255,255,0.2);
    }

    .btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.2);
        color: #ffb3b3;
        padding: 9px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s;
    }

        .btn-ghost:hover {
            background: rgba(255,255,255,0.18);
        }

    /* ── SECTION TITLE ── */
    .section-title {
        font-size: 15px;
        font-weight: 700;
        color: #1a1a1a;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
    }

        .section-title::before {
            content: '';
            display: block;
            width: 4px;
            height: 16px;
            background: #8b0000;
            border-radius: 2px;
        }

    /* ── STAT CARDS ── */
    .stat-row {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 26px;
    }

    .stat-card {
        flex: 1;
        min-width: 160px;
        background: white;
        border: 1px solid #f0e0e0;
        border-top: 4px solid #8b0000;
        border-radius: 10px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

        .stat-card.green {
            border-top-color: #1a8a4a;
        }

        .stat-card.orange {
            border-top-color: #b8860b;
        }

    .sc-icon {
        width: 44px;
        height: 44px;
        background: #fff0f0;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .stat-card.green .sc-icon {
        background: #e6f9ef;
    }

    .stat-card.orange .sc-icon {
        background: #fff8e1;
    }

    .sc-icon i {
        color: #8b0000;
        font-size: 17px;
    }

    .stat-card.green .sc-icon i {
        color: #1a8a4a;
    }

    .stat-card.orange .sc-icon i {
        color: #b8860b;
    }

    .sc-val {
        font-size: 24px;
        font-weight: 800;
        color: #8b0000;
    }

    .stat-card.green .sc-val {
        color: #1a8a4a;
    }

    .stat-card.orange .sc-val {
        color: #b8860b;
    }

    .sc-lbl {
        font-size: 12px;
        color: #888;
        margin-top: 2px;
    }

    /* ── TOOLBAR ── */
    .toolbar {
        background: white;
        border: 1px solid #f0e0e0;
        border-radius: 10px;
        padding: 16px 22px;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 20px;
    }

    .search-wrap {
        flex: 1;
        min-width: 200px;
        position: relative;
    }

        .search-wrap i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #aaa;
            font-size: 13px;
        }

        .search-wrap input {
            width: 100%;
            padding: 9px 12px 9px 34px;
            border: 1px solid #ddd;
            border-radius: 7px;
            font-size: 13px;
            color: #333;
            background: #fafafa;
            outline: none;
            font-family: inherit;
        }

            .search-wrap input:focus {
                border-color: #8b0000;
            }

    .toolbar select {
        padding: 9px 12px;
        border: 1px solid #ddd;
        border-radius: 7px;
        font-size: 13px;
        color: #333;
        background: #fafafa;
        outline: none;
        font-family: inherit;
    }

        .toolbar select:focus {
            border-color: #8b0000;
        }

    .btn-add {
        background: #8b0000;
        color: white;
        padding: 9px 18px;
        border-radius: 8px;
        border: none;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-family: inherit;
        text-decoration: none;
        transition: background 0.2s;
        white-space: nowrap;
    }

        .btn-add:hover {
            background: #6e0000;
        }

    .btn-export {
        background: #1a8a4a;
        color: white;
        padding: 9px 18px;
        border-radius: 8px;
        border: none;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-family: inherit;
        text-decoration: none;
        transition: background 0.2s;
        white-space: nowrap;
    }

        .btn-export:hover {
            background: #136e39;
        }

    .btn-search {
        background: #8b0000;
        color: white;
        padding: 9px 18px;
        border-radius: 8px;
        border: none;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        font-family: inherit;
        transition: background 0.2s;
    }

        .btn-search:hover {
            background: #6e0000;
        }

    /* ── TABLE SECTION ── */
    .table-section {
        background: white;
        border: 1px solid #f0e0e0;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 40px;
    }

    .table-section-header {
        padding: 16px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #f5eded;
    }

        .table-section-header span {
            font-size: 14px;
            font-weight: 700;
            color: #1a1a1a;
        }

    .record-count {
        font-size: 12px;
        background: #fff0f0;
        color: #8b0000;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 20px;
    }

    .table-wrap {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead th {
        background: #8b0000;
        color: white;
        padding: 12px 16px;
        font-size: 12px;
        font-weight: 600;
        text-align: left;
        white-space: nowrap;
    }

    tbody td {
        padding: 13px 16px;
        border-bottom: 1px solid #f5eded;
        font-size: 13px;
        color: #333;
        vertical-align: middle;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    tbody tr:hover td {
        background: #fff8f8;
    }

    /* ── DONOR CELL ── */
    .donor-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .donor-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #8b0000;
        color: white;
        font-size: 13px;
        font-weight: 800;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .donor-name {
        font-weight: 700;
        color: #1a1a1a;
        font-size: 14px;
    }

    .donor-id {
        font-size: 11px;
        color: #8b0000;
        font-weight: 600;
        margin-top: 2px;
    }

    /* ── BLOOD BADGE ── */
    .blood-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #8b0000;
        color: white;
        font-weight: 800;
        font-size: 12px;
        padding: 4px 11px;
        border-radius: 20px;
        min-width: 42px;
    }

    /* ── STATUS BADGES ── */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .badge-eligible {
        background: #e6f9ef;
        color: #1a8a4a;
    }

    .badge-deferred {
        background: #fff8e1;
        color: #b8860b;
    }

    /* ── ACTIONS ── */
    .actions {
        display: flex;
        gap: 6px;
        align-items: center;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        border: none;
        font-family: inherit;
        transition: all 0.15s;
    }

    .btn-view {
        background: #e8f4fd;
        color: #1565c0;
    }

        .btn-view:hover {
            background: #1565c0;
            color: white;
        }

    .btn-edit {
        background: #fff8e1;
        color: #b8860b;
    }

        .btn-edit:hover {
            background: #b8860b;
            color: white;
        }

    .btn-delete {
        background: #fff0f0;
        color: #8b0000;
    }

        .btn-delete:hover {
            background: #8b0000;
            color: white;
        }

    /* ── PAGINATION ── */
    .pagination-bar {
        padding: 14px 22px;
        border-top: 1px solid #f5eded;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 13px;
        color: #888;
    }

    .pagination-btns {
        display: flex;
        gap: 6px;
    }

    .pg-btn {
        padding: 6px 12px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 12px;
        background: white;
        color: #444;
        text-decoration: none;
        font-family: inherit;
        transition: all 0.15s;
    }

        .pg-btn:hover {
            background: #f4f6f9;
            border-color: #8b0000;
            color: #8b0000;
        }

        .pg-btn.active {
            background: #8b0000;
            color: white;
            border-color: #8b0000;
        }

    /* ── EMPTY STATE ── */
    .empty-state {
        text-align: center;
        padding: 50px 20px;
        color: #aaa;
    }

        .empty-state i {
            font-size: 36px;
            color: #f0e0e0;
            margin-bottom: 12px;
        }

        .empty-state p {
            font-size: 14px;
            margin-top: 8px;
        }

    @@media (max-width: 700px) {
        .stat-row {
            flex-direction: column;
        }

        .actions {
            flex-wrap: wrap;
        }
    }
</style>

<div class="dashboard">

    <!-- HEADER -->
    <div class="header">
        <div class="header-left">
            <h2><i class="fa-solid fa-users" style="margin-right:10px"></i>Manage Donors</h2>
            <p>View, register, and manage all blood donors in the system</p>
        </div>
        <div class="header-right">
            <div class="header-stat">
                <div class="val">@ViewBag.TotalDonors</div>
                <div class="lbl">Total Donors</div>
            </div>
            <div class="h-divider"></div>
            <div class="header-stat">
                <div class="val">@ViewBag.EligibleDonors</div>
                <div class="lbl">Eligible</div>
            </div>
            <div class="h-divider"></div>
            <div class="header-stat">
                <div class="val">@ViewBag.DeferredDonors</div>
                <div class="lbl">Deferred</div>
            </div>
            <div class="h-divider"></div>
            <a asp-controller="Home" asp-action="Admin" class="btn-ghost">
                <i class="fa-solid fa-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <!-- STAT CARDS -->
    <div class="section-title">Overview</div>
    <div class="stat-row">
        <div class="stat-card">
            <div class="sc-icon"><i class="fa-solid fa-users"></i></div>
            <div>
                <div class="sc-val">@ViewBag.TotalDonors</div>
                <div class="sc-lbl">Total Donors</div>
            </div>
        </div>
        <div class="stat-card green">
            <div class="sc-icon"><i class="fa-solid fa-circle-check"></i></div>
            <div>
                <div class="sc-val">@ViewBag.EligibleDonors</div>
                <div class="sc-lbl">Eligible to Donate</div>
            </div>
        </div>
        <div class="stat-card orange">
            <div class="sc-icon"><i class="fa-solid fa-clock"></i></div>
            <div>
                <div class="sc-val">@ViewBag.DeferredDonors</div>
                <div class="sc-lbl">Deferred</div>
            </div>
        </div>
    </div>

    <!-- TOOLBAR -->
    <div class="toolbar">
        <form method="get" asp-controller="Donor" asp-action="ManageDonors" style="display:contents;">
            <div class="search-wrap">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" name="search" value="@ViewBag.Search"
                       placeholder="Search by name, phone or donor ID…" />
            </div>

            <select name="bloodGroup">
                <option value="">All Blood Groups</option>
                @foreach (var bg in new[] { "A+", "A-", "B+", "B-", "O+", "O-", "AB+", "AB-" })
                {
                    <option value="@bg" selected="@(ViewBag.BloodGroup == bg ? "selected" : null)">@bg</option>
                }
            </select>

            <select name="eligibility">
                <option value="">All Eligibility</option>
                <option value="Eligible" selected="@(ViewBag.Eligibility == "Eligible" ? "selected" : null)">Eligible</option>
                <option value="Deferred" selected="@(ViewBag.Eligibility == "Deferred" ? "selected" : null)">Deferred</option>
            </select>

            <button type="submit" class="btn-search">
                <i class="fa-solid fa-magnifying-glass"></i> Search
            </button>

            <a asp-controller="Donor" asp-action="ExportDonors" class="btn-export">
                <i class="fa-solid fa-file-arrow-down"></i> Export CSV
            </a>
        </form>

        <a asp-controller="Home" asp-action="Donate" class="btn-add">
            <i class="fa-solid fa-plus"></i> Add New Donor
        </a>
    </div>

    <!-- TABLE -->
    <div class="table-section">
        <div class="table-section-header">
            <span><i class="fa-solid fa-list" style="color:#8b0000;margin-right:8px"></i>Donor Registry</span>
            <span class="record-count" id="recordCount">@(Model?.Count ?? 0) records</span>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Donor</th>
                        <th>Blood Group</th>
                        <th>Gender</th>
                        <th>Age</th>
                        <th>Contact</th>
                        <th>Last Donation</th>
                        <th>Total Donations</th>
                        <th>Eligibility</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int serial = 1;
                        foreach (var donor in Model)
                        {
                            var initials = string.Join("", donor.FullName.Split(' ')
                            .Take(2).Select(w => w[0].ToString().ToUpper()));

                            <tr>
                                <td style="color:#888;font-size:12px">@(serial++)</td>
                                <td>
                                    <div class="donor-cell">
                                        <div class="donor-avatar">@initials</div>
                                        <div>
                                            <div class="donor-name">@donor.FullName</div>
                                            <div class="donor-id">@donor.DonorId</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="blood-badge">@donor.BloodGroup</span></td>
                                <td>@donor.Gender</td>
                                <td>@donor.Age</td>
                                <td>@donor.ContactNumber</td>
                                <td>
                                    @(donor.LastDonationDate.HasValue
                                                                ? donor.LastDonationDate.Value.ToString("dd MMM yyyy")
                                                                : "—")
                                </td>
                                <td style="text-align:center;font-weight:700;color:#8b0000">
                                    @donor.TotalDonations
                                </td>
                                <td>
                                    @if (donor.Eligibility == "Eligible")
                                    {
                                        <span class="status-badge badge-eligible">
                                            <i class="fa-solid fa-circle-check"></i> Eligible
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge badge-deferred">
                                            <i class="fa-solid fa-clock"></i> Deferred
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="actions">
                                        <a asp-controller="Donor" asp-action="DonorDetails"
                                           asp-route-id="@donor.DonorId"
                                           class="action-btn btn-view">
                                            <i class="fa-solid fa-eye"></i> View
                                        </a>
                                        <a asp-controller="Donor" asp-action="EditDonor"
                                           asp-route-id="@donor.DonorId"
                                           class="action-btn btn-edit">
                                            <i class="fa-solid fa-pen-to-square"></i> Edit
                                        </a>
                                        <a asp-controller="Donor" asp-action="DeleteDonor"
                                           asp-route-id="@donor.DonorId"
                                           class="action-btn btn-delete"
                                           onclick="return confirm('Are you sure you want to delete this donor?')">
                                            <i class="fa-solid fa-trash"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10">
                                <div class="empty-state">
                                    <i class="fa-solid fa-users-slash"></i>
                                    <p>No donors found. Try adjusting the filters or add a new donor.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- PAGINATION -->
        <div class="pagination-bar">
            <span>Showing @ViewBag.From–@ViewBag.To of @ViewBag.TotalDonors donors</span>
            <div class="pagination-btns">
                @if (ViewBag.CurrentPage > 1)
                {
                    <a asp-controller="Donor" asp-action="ManageDonors"
                       asp-route-page="@(ViewBag.CurrentPage - 1)"
                       asp-route-search="@ViewBag.Search"
                       asp-route-bloodGroup="@ViewBag.BloodGroup"
                       asp-route-eligibility="@ViewBag.Eligibility"
                       class="pg-btn">&#8249; Prev</a>
                }

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <a asp-controller="Donor" asp-action="ManageDonors"
                       asp-route-page="@i"
                       asp-route-search="@ViewBag.Search"
                       asp-route-bloodGroup="@ViewBag.BloodGroup"
                       asp-route-eligibility="@ViewBag.Eligibility"
                       class="pg-btn @(ViewBag.CurrentPage == i ? "active" : "")">@i</a>
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a asp-controller="Donor" asp-action="ManageDonors"
                       asp-route-page="@(ViewBag.CurrentPage + 1)"
                       asp-route-search="@ViewBag.Search"
                       asp-route-bloodGroup="@ViewBag.BloodGroup"
                       asp-route-eligibility="@ViewBag.Eligibility"
                       class="pg-btn">Next &#8250;</a>
                }
            </div>
        </div>
    </div>
</div>
